@{
    ViewData["Title"] = "Assessment";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<div class="rp-page-header gap-3 mb-3">
    <div>
        <h2 class="rp-display-lg">Assessment</h2>
        <p class="rp-body-md mt-1 mb-0 rp-text-muted">
            Create risk assessments as a guided flow — pick the SAQ and KRI templates, schedule it, then activate.
        </p>
    </div>
</div>

<div class="rp-card p-2">
    <div class="rp-grid-toolbar">
        <p class="mb-0 rp-body-sm rp-text-muted">Create risk assessments as a guided flow.</p>
        <a href="@Url.Action("Wizard", "Assessment")" class="rp-btn rp-btn-primary d-inline-flex align-items-center gap-2">
            <i class="fas fa-plus"></i> New Assessment
        </a>
    </div>
    <table id="assessmentTable" class="table rp-table table-sm w-100 align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>SAQ Template</th>
                <th>KRI Template</th>
                <th>Schedule</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var gridUrl = '@Url.Action("Grid", "Assessment")';
            var wizardUrl = '@Url.Action("Wizard", "Assessment")';
            var deleteUrl = '@Url.Action("Delete", "Assessment")';
            var wizardError = @Html.Raw(Json.Serialize(ViewData["WizardError"] ?? (object?)null));

            /* =================================================================
               SECTION 2 — DATA GRID (DataTables)
               ================================================================= */
            var assessmentTable = RiskPulse.initGrid($('#assessmentTable'), {
                ajax: { url: gridUrl },
                columns: [
                    { data: 'assessmentHeaderId' },
                    { data: 'assessmentName' },
                    { data: 'saqDesc', render: function (d) { return d || '<em class="text-muted">Not set</em>'; } },
                    { data: 'kriHeaderDesc', render: function (d) { return d || '<em class="text-muted">Not set</em>'; } },
                    { data: 'scheduleDesc', render: function (d) { return d || '<em class="text-muted">Not set</em>'; } },
                    { data: 'assessmentStatus', render: function (d) {
                        return RiskPulse.statusPill(d);
                    } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function (data, type, row) {
                        if (row.assessmentStatus !== 'Draft') {
                            return '<span class="text-muted">—</span>';
                        }
                        return '<button type="button" class="rp-btn rp-btn-edit edit-assessment-btn"><i class="fas fa-pen-to-square"></i> Edit</button> ' +
                               '<button type="button" class="rp-btn rp-btn-delete delete-assessment-btn"><i class="fas fa-trash-can"></i> Delete</button>';
                    } }
                ],
                order: [[0, 'asc']]
            });

            /* =================================================================
               SECTION 3 — EVENT WIRING & INIT
               ================================================================= */
            $('#assessmentTable tbody').on('click', '.edit-assessment-btn', function () {
                var row = assessmentTable.row($(this).closest('tr')).data();
                window.location.href = wizardUrl + '?id=' + row.assessmentHeaderId;
            });

            $('#assessmentTable tbody').on('click', '.delete-assessment-btn', function () {
                var row = assessmentTable.row($(this).closest('tr')).data();
                RiskPulse.confirmDelete('Delete Draft Assessment?', 'This permanently deletes the draft "' + row.assessmentName + '" and its schedule.', function () {
                    RiskPulse.postJson(deleteUrl, { id: row.assessmentHeaderId }, {
                        success: function (res) {
                            assessmentTable.ajax.reload(null, false);
                            RiskPulse.toastSuccess(res.message || 'Draft assessment deleted.');
                        },
                        fail: function (res) {
                            RiskPulse.toastError(res.message || 'Unable to delete the assessment.');
                        }
                    });
                });
            });

            if (wizardError) {
                RiskPulse.toastError(wizardError);
            }
        })(jQuery);
    </script>
}
