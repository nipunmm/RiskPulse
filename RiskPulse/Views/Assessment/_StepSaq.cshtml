@model RiskPulse.Models.ViewModel.AssessmentWizardViewModel

<section class="rp-wizard-panel" data-step="2">
    <div class="rp-card p-3">
        <h6 class="rp-display-md mb-1">Step 2 — SAQ template</h6>
        <p class="rp-body-sm mb-3 rp-text-muted">
            Pick the self-assessment questionnaire that will drive this assessment.
        </p>
        <div class="row">
            <div class="col-lg-6">
                <label class="rp-label" for="wizardSaqId">SAQ Template</label>
                <select id="wizardSaqId" class="rp-input">
                    <option value="0">Select an SAQ template...</option>
                    @foreach (var opt in Model.SaqOptions)
                    {
                        <option value="@opt.Value" selected="@(Model.SaqHeaderId == opt.Value ? "selected" : null)">@opt.Label</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-between gap-2 mt-3">
        <button type="button" class="rp-btn rp-btn-secondary rp-wizard-back"><i class="fas fa-arrow-left"></i> Back</button>
        <button type="button" class="rp-btn rp-btn-primary rp-wizard-next">Next <i class="fas fa-arrow-right"></i></button>
    </div>
</section>
