@model RiskPulse.Models.ViewModel.AssessmentWizardViewModel

<section class="wizard-step-panel" data-step="1">
    <div class="card-stasis p-3">
        <h6 class="font-display-md mb-1">Step 1 — Assessment name</h6>
        <p class="font-body-sm mb-3" style="color: var(--on-surface-variant);">
            Name the assessment. You can rename it later while it is still a draft.
        </p>
        <div class="row">
            <div class="col-lg-6">
                <label class="input-label" for="wizardName">Assessment Name</label>
                <input type="text" id="wizardName" class="input-stasis" value="@Model.AssessmentName" maxlength="200" placeholder="e.g. 2026 Annual Operational Risk Assessment" autocomplete="off" />
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-3">
        <a href="@Url.Action("Index", "Assessment")" class="btn-stasis-secondary d-inline-flex align-items-center gap-2">Cancel</a>
        <button type="button" class="btn-stasis-primary wizard-next-btn"><i class="fas fa-arrow-right"></i> Next</button>
    </div>
</section>
