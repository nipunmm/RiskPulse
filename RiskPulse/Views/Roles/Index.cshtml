@model RiskPulse.Models.ViewModel.RolesIndexViewModel
@{
    ViewData["Title"] = "Role Management";

    var permissionsJson = Json.Serialize(Model.Permissions);
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<div class="rp-page-header">
    <div>
        <h2 class="rp-display-lg">Role Management</h2>
        <p class="rp-body-md mt-1 mb-0 rp-text-muted">
            Define roles, set their landing page, and assign system permissions.
        </p>
    </div>
</div>

<div class="rp-card p-2">
    <div class="rp-grid-toolbar">
        <p class="mb-0 rp-body-sm rp-text-muted">Define roles and assign system permissions.</p>
        <button type="button" class="rp-btn rp-btn-primary" data-bs-toggle="modal" data-bs-target="#addRoleModal">
            <i class="fas fa-plus"></i> Add Role
        </button>
    </div>
    <table id="roleTable" class="table rp-table table-sm w-100 align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Role Name</th>
                <th>Default Page</th>
                <th>Permissions</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- ============================================================
     ADD ROLE MODAL
     ============================================================ -->
<div class="modal fade" id="addRoleModal" tabindex="-1" aria-labelledby="addRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addRoleForm" data-default-select="addDefaultPermissionId" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="addRoleModalLabel">Add Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="rp-label" for="addRoleDesc">Role Name</label>
                        <input type="text" id="addRoleDesc" name="roleDesc" class="rp-input" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="rp-label" for="addDefaultPermissionId">Default Landing Page</label>
                        <select id="addDefaultPermissionId" name="defaultPermissionId" class="rp-input">
                        </select>
                        <small class="text-muted rp-body-xs mt-1 d-block">
                            Users with this role will be automatically redirected to this page after login. Enabled once at least one permission is assigned.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="rp-label d-block mb-2">Permissions</label>
                        <div class="permission-checkboxes" id="addPermissionList"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="rp-btn rp-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="rp-btn rp-btn-primary"><i class="fas fa-check"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     EDIT ROLE MODAL
     ============================================================ -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editRoleForm" data-default-select="editDefaultPermissionId" novalidate>
                <input type="hidden" id="editRoleId" name="roleId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editRoleModalLabel">Edit Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="rp-label" for="editRoleDesc">Role Name</label>
                        <input type="text" id="editRoleDesc" name="roleDesc" class="rp-input" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="rp-label" for="editDefaultPermissionId">Default Landing Page</label>
                        <select id="editDefaultPermissionId" name="defaultPermissionId" class="rp-input">
                        </select>
                        <small class="text-muted rp-body-xs mt-1 d-block">
                            Users with this role will be automatically redirected to this page after login. Enabled once at least one permission is assigned.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="rp-label d-block mb-2">Permissions</label>
                        <div class="permission-checkboxes" id="editPermissionList"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="rp-btn rp-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="rp-btn rp-btn-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var permissions = @Html.Raw(permissionsJson);
            var gridUrl = '@Url.Action("Grid", "Roles")';
            var saveUrl = '@Url.Action("Save", "Roles")';
            var deleteUrl = '@Url.Action("Delete", "Roles")';

            /* =================================================================
               SECTION 2 — UI RENDERERS
               ================================================================= */

            // Builds the permission checkbox list for a modal
            function renderPermissionList(containerId, selectedIds) {
                $('#' + containerId).empty().append($.map(permissions, function (p) {
                    return $('<div class="form-check">').append(
                        $('<input class="form-check-input permission-check" type="checkbox" name="permissionIds">')
                            .attr('id', containerId + '_' + p.value)
                            .val(p.value)
                            .prop('checked', $.inArray(p.value, selectedIds) > -1),
                        $('<label class="form-check-label">')
                            .attr('for', containerId + '_' + p.value)
                            .text(p.label)
                    );
                }));
            }

            // Fills the default-page dropdown with only the checked permissions (disabled when none)
            function renderDefaultPermissionOptions(selectId, selectedId, checkedIds) {
                var $select = $('#' + selectId).empty();

                if (!$.isArray(checkedIds) || checkedIds.length === 0) {
                    $select.append($('<option>').val('').text('Select a default page')).prop('disabled', true);
                } else {
                    var allowed = $.grep(permissions, function (p) { return $.inArray(p.value, checkedIds) > -1; });
                    if (!$.grep(allowed, function (p) { return p.value === selectedId; }).length) {
                        var dash = $.grep(allowed, function (p) { return p.label.toLowerCase() === 'dashboard'; })[0];
                        selectedId = (dash || allowed[0]).value;
                    }

                    $select.append($.map(allowed, function (p) {
                        return $('<option>').val(p.value).text(p.label).prop('selected', p.value === selectedId);
                    })).prop('disabled', false);
                }

                $select.trigger('change.select2');
                return $select;
            }

            // Syncs the default-page dropdown to the currently checked permissions
            function syncDefaultPageDropdown($form, selectId, preferredId) {
                var checkedIds = $form.find('.permission-check:checked').map(function () { return +this.value; }).get();
                renderDefaultPermissionOptions(selectId, +$('#' + selectId).val() || preferredId || null, checkedIds);
            }

            /* =================================================================
               SECTION 3 — FORM PAYLOAD BUILDER
               ================================================================= */
            function getFormPayload($form) {
                var payload = RiskPulse.serializeForm($form, {
                    numbers: ['roleId']
                });
                payload.defaultPermissionId = payload.defaultPermissionId ? +payload.defaultPermissionId : null;
                payload.permissionIds = $form.find('.permission-check:checked').map(function () { return +this.value; }).get();
                return payload;
            }

            /* =================================================================
               SECTION 4 — VALIDATION
               ================================================================= */
            function validateRolePayload(payload, $form) {
                // Rule 1 — role name is required
                if (!$.trim(payload.roleDesc)) { return RiskPulse.validationError($form.find('[name="roleDesc"]'), 'Role name is required.'); }
                // Rule 2 — at least one permission must be assigned
                if (!payload.permissionIds.length) { return RiskPulse.validationError(null, 'At least one permission is required.'); }
                // Rule 3 — default page must be one of the assigned permissions
                if (payload.defaultPermissionId && $.inArray(payload.defaultPermissionId, payload.permissionIds) === -1) { return RiskPulse.validationError($form.find('[name="defaultPermissionId"]'), 'The default page must be one of the assigned permissions.'); }
                return true;
            }

            /* =================================================================
               SECTION 5 — CONTROLLER CALLS (AJAX) — the ONLY server touchpoint
               ================================================================= */
            function submitRole(payload, $form) {
                RiskPulse.postJson(saveUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        roleTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'Role saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save role.');
                    }
                });
            }

            /* =================================================================
               SECTION 6 — DATA GRID (DataTables)
               ================================================================= */
            var roleTable = RiskPulse.initGrid($('#roleTable'), {
                ajax: { url: gridUrl },
                columns: [
                    { data: 'roleId' },
                    { data: 'roleDesc' },
                    { data: 'defaultPermissionDesc', render: function (d) {
                        return RiskPulse.pill(d || 'Dashboard', null, 'house');
                    } },
                    { data: 'permissionDescs', orderable: false, searchable: false, render: function (d) {
                        var badges = (d || []).map(function (desc) { return RiskPulse.pill(desc); });
                        return badges.length ? badges.join(' ') : '<span class="text-muted">None</span>';
                    } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function () {
                        return '<button type="button" class="rp-btn rp-btn-edit edit-role-btn"><i class="fas fa-pen-to-square"></i> Edit</button> ' +
                               '<button type="button" class="rp-btn rp-btn-delete delete-role-btn"><i class="fas fa-trash-can"></i> Delete</button>';
                    } }
                ],
                order: [[0, 'asc']]
            });

            /* =================================================================
               SECTION 7 — EVENT WIRING & INIT
               ================================================================= */
            // Rebuild the default-page dropdown when permissions change
            $('#addRoleForm, #editRoleForm').on('change', '.permission-check', function () {
                var $form = $(this).closest('form');
                syncDefaultPageDropdown($form, $form.data('default-select'));
            });

            // Reset the Add form each time its modal opens
            $('#addRoleModal').on('shown.bs.modal', function () {
                $('#addRoleDesc').val('').trigger('focus');
                renderPermissionList('addPermissionList', []);
                syncDefaultPageDropdown($('#addRoleForm'), $('#addRoleForm').data('default-select'));
                RiskPulse.clearFieldErrors($('#addRoleForm'));
            });

            // Load a role's values into the Edit modal
            $('#roleTable tbody').on('click', '.edit-role-btn', function () {
                var row = $('#roleTable').DataTable().row($(this).closest('tr')).data();
                $('#editRoleId').val(row.roleId);
                $('#editRoleDesc').val(row.roleDesc);
                renderPermissionList('editPermissionList', row.permissionIds || []);
                renderDefaultPermissionOptions('editDefaultPermissionId', row.defaultPermissionId, row.permissionIds || []);
                RiskPulse.clearFieldErrors($('#editRoleForm'));
                RiskPulse.showModal('editRoleModal');
            });

            // Delete handler
            $('#roleTable tbody').on('click', '.delete-role-btn', function () {
                var row = $('#roleTable').DataTable().row($(this).closest('tr')).data();
                RiskPulse.confirmDelete(
                    'Delete Role?',
                    'This permanently deletes "' + row.roleDesc + '".',
                    function () {
                        RiskPulse.postJson(deleteUrl, { id: row.roleId }, {
                            success: function (res) {
                                roleTable.ajax.reload(null, false);
                                RiskPulse.toastSuccess(res.message || 'Role deleted successfully.');
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to delete role.');
                            }
                        });
                    }
                );
            });

            // Bind submit for both Add and Edit forms
            $('#addRoleForm, #editRoleForm').on('submit', function (e) {
                e.preventDefault();
                var payload = getFormPayload($(this));
                if (validateRolePayload(payload, $(this))) submitRole(payload, $(this));
            });
        })(jQuery);
    </script>
}
