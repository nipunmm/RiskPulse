@model RiskPulse.Models.ViewModel.RolesIndexViewModel
@{
    ViewData["Title"] = "Role Management";

    var permissionsJson = Json.Serialize(Model.Permissions.Select(p => new { permissionId = p.PermissionId, permissionDesc = p.PermissionDesc }));
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-2 mb-2">
    <div>
        <h2 class="font-display-lg" style="color: var(--on-background);">Role Management</h2>
        <p class="font-body-md mt-1 mb-0" style="color: var(--on-surface-variant);">
            Define roles, set their landing page, and assign system permissions.
        </p>
    </div>
    <button type="button" class="btn-stasis-primary" data-bs-toggle="modal" data-bs-target="#addRoleModal">
        <i class="fas fa-plus"></i> Add Role
    </button>
</div>

<div class="card-stasis p-2">
    <table id="roleTable" class="table table-stasis table-sm w-100 align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Role Name</th>
                <th>Default Page</th>
                <th>Permissions</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- ============================================================
     ADD ROLE MODAL
     ============================================================ -->
<div class="modal fade" id="addRoleModal" tabindex="-1" aria-labelledby="addRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addRoleForm" data-default-select="addDefaultPermissionId" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="addRoleModalLabel">Add Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="addRoleDesc">Role Name</label>
                        <input type="text" id="addRoleDesc" name="roleDesc" class="input-stasis" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="addDefaultPermissionId">Default Landing Page</label>
                        <select id="addDefaultPermissionId" name="defaultPermissionId" class="input-stasis form-select">
                        </select>
                        <small class="text-muted font-body-xs mt-1 d-block">
                            Users with this role will be automatically redirected to this page after login. Enabled once at least one permission is assigned.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="input-label d-block mb-2">Permissions</label>
                        <div class="permission-checkboxes" id="addPermissionList"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     EDIT ROLE MODAL
     ============================================================ -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editRoleForm" data-default-select="editDefaultPermissionId" novalidate>
                <input type="hidden" id="editRoleId" name="roleId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editRoleModalLabel">Edit Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="editRoleDesc">Role Name</label>
                        <input type="text" id="editRoleDesc" name="roleDesc" class="input-stasis" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="editDefaultPermissionId">Default Landing Page</label>
                        <select id="editDefaultPermissionId" name="defaultPermissionId" class="input-stasis form-select">
                        </select>
                        <small class="text-muted font-body-xs mt-1 d-block">
                            Users with this role will be automatically redirected to this page after login. Enabled once at least one permission is assigned.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="input-label d-block mb-2">Permissions</label>
                        <div class="permission-checkboxes" id="editPermissionList"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var permissions = @Html.Raw(permissionsJson);
            var gridUrl = '@Url.Action("Grid", "Roles")';
            var saveUrl = '@Url.Action("Save", "Roles")';

            /* =================================================================
               SECTION 2 — UI RENDERERS
               ================================================================= */

            // Builds the permission checkbox list for a modal
            function renderPermissionList(containerId, selectedIds) {
                $('#' + containerId).empty().append($.map(permissions, function (p) {
                    return $('<div class="form-check">').append(
                        $('<input class="form-check-input permission-check" type="checkbox" name="permissionIds">')
                            .attr('id', containerId + '_' + p.permissionId)
                            .val(p.permissionId)
                            .prop('checked', $.inArray(p.permissionId, selectedIds) > -1),
                        $('<label class="form-check-label">')
                            .attr('for', containerId + '_' + p.permissionId)
                            .text(p.permissionDesc)
                    );
                }));
            }

            // Fills the default-page dropdown with only the checked permissions (disabled when none)
            function renderDefaultPermissionOptions(selectId, selectedId, checkedIds) {
                var $select = $('#' + selectId).empty();

                if (!$.isArray(checkedIds) || checkedIds.length === 0) {
                    return $select.append($('<option>').val('').text('Select a default page')).prop('disabled', true);
                }

                var allowed = $.grep(permissions, function (p) { return $.inArray(p.permissionId, checkedIds) > -1; });
                if (!$.grep(allowed, function (p) { return p.permissionId === selectedId; }).length) {
                    var dash = $.grep(allowed, function (p) { return p.permissionDesc.toLowerCase() === 'dashboard'; })[0];
                    selectedId = (dash || allowed[0]).permissionId;
                }

                $select.append($.map(allowed, function (p) {
                    return $('<option>').val(p.permissionId).text(p.permissionDesc).prop('selected', p.permissionId === selectedId);
                })).prop('disabled', false);
            }

            // Syncs the default-page dropdown to the currently checked permissions
            function syncDefaultPageDropdown($form, selectId, preferredId) {
                var checkedIds = $form.find('.permission-check:checked').map(function () { return +this.value; }).get();
                renderDefaultPermissionOptions(selectId, +$('#' + selectId).val() || preferredId || null, checkedIds);
            }

            /* =================================================================
               SECTION 3 — FORM PAYLOAD BUILDER
               ================================================================= */
            function getFormPayload($form) {
                var payload = {};
                $.each($form.serializeArray(), function (i, f) { payload[f.name] = f.value; });
                payload.roleId = +payload.roleId || 0;
                payload.defaultPermissionId = payload.defaultPermissionId ? +payload.defaultPermissionId : null;
                payload.permissionIds = $form.find('.permission-check:checked').map(function () { return +this.value; }).get();
                return payload;
            }

            /* =================================================================
               SECTION 4 — VALIDATION
               ================================================================= */
            function validateRolePayload(payload) {
                // Rule 1 — role name is required
                if (!$.trim(payload.roleDesc)) { Toast.fire({ icon: 'error', title: 'Role name is required.' }); return false; }
                // Rule 2 — at least one permission must be assigned
                if (!payload.permissionIds.length) { Toast.fire({ icon: 'error', title: 'At least one permission is required.' }); return false; }
                // Rule 3 — default page must be one of the assigned permissions
                if (payload.defaultPermissionId && $.inArray(payload.defaultPermissionId, payload.permissionIds) === -1) { Toast.fire({ icon: 'error', title: 'The default page must be one of the assigned permissions.' }); return false; }
                return true;
            }

            /* =================================================================
               SECTION 5 — CONTROLLER CALLS (AJAX) — the ONLY server touchpoint
               ================================================================= */
            function submitRole(payload, $form) {
                $.ajax({
                    url: saveUrl,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            $form.closest('.modal').modal('hide');
                            roleTable.ajax.reload(null, false);
                            Toast.fire({ icon: 'success', title: res.message || 'Role saved successfully.' });
                        } else {
                            Toast.fire({ icon: 'error', title: res.message || 'Unable to save role.' });
                        }
                    },
                    error: function () { Toast.fire({ icon: 'error', title: 'An error occurred. Please try again.' }); }
                });
            }

            /* =================================================================
               SECTION 6 — DATA GRID (DataTables)
               ================================================================= */
            var roleTable = $('#roleTable').DataTable({
                ajax: { url: gridUrl, dataSrc: 'data' },
                columns: [
                    { data: 'roleId' },
                    { data: 'roleDesc' },
                    { data: 'defaultPermissionDesc', render: function (d) {
                        return '<span class="status-pill status-active"><i class="fas fa-house me-1"></i>' + (d || 'Dashboard') + '</span>';
                    } },
                    { data: 'permissionDescs', orderable: false, searchable: false, render: function (d) {
                        var badges = (d || []).map(function (desc) { return '<span class="status-pill">' + desc + '</span>'; });
                        return badges.length ? badges.join(' ') : '<span class="text-muted">None</span>';
                    } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function () {
                        return '<button type="button" class="btn-stasis-secondary edit-role-btn"><i class="fas fa-pen-to-square"></i> Edit</button>';
                    } }
                ],
                pageLength: 10,
                lengthMenu: [10, 25, 50],
                order: [[0, 'asc']]
            });

            /* =================================================================
               SECTION 7 — EVENT WIRING & INIT
               ================================================================= */
            // Rebuild the default-page dropdown when permissions change
            $('#addRoleForm, #editRoleForm').on('change', '.permission-check', function () {
                var $form = $(this).closest('form');
                syncDefaultPageDropdown($form, $form.data('default-select'));
            });

            // Reset the Add form each time its modal opens
            $('#addRoleModal').on('shown.bs.modal', function () {
                $('#addRoleDesc').val('').trigger('focus');
                renderPermissionList('addPermissionList', []);
                syncDefaultPageDropdown($('#addRoleForm'), $('#addRoleForm').data('default-select'));
            });

            // Load a role's values into the Edit modal
            $('#roleTable tbody').on('click', '.edit-role-btn', function () {
                var row = $('#roleTable').DataTable().row($(this).closest('tr')).data();
                $('#editRoleId').val(row.roleId);
                $('#editRoleDesc').val(row.roleDesc);
                renderPermissionList('editPermissionList', row.permissionIds || []);
                renderDefaultPermissionOptions('editDefaultPermissionId', row.defaultPermissionId, row.permissionIds || []);
                $('#editRoleModal').modal('show');
            });

            // Bind submit for both Add and Edit forms
            $('#addRoleForm, #editRoleForm').on('submit', function (e) {
                e.preventDefault();
                var payload = getFormPayload($(this));
                if (validateRolePayload(payload)) submitRole(payload, $(this));
            });
        })(jQuery);
    </script>
}
