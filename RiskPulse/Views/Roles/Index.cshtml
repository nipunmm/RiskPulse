@model RiskPulse.Models.ViewModel.RolesIndexViewModel
@{
    ViewData["Title"] = "Role Management";

    var rolesJson = Json.Serialize(Model.Roles.Select(r => new
    {
        roleId = r.RoleId,
        roleDesc = r.RoleDesc,
        defaultPermissionId = r.DefaultPermissionId,
        defaultPermissionDesc = r.DefaultPermission?.PermissionDesc ?? "Dashboard",
        permissionIds = r.RolePermissions.Select(rp => rp.PermissionId).ToList(),
        permissionDescs = r.RolePermissions.Select(rp => rp.Permission?.PermissionDesc).ToList()
    }));
    var permissionsJson = Json.Serialize(Model.Permissions.Select(p => new { permissionId = p.PermissionId, permissionDesc = p.PermissionDesc }));
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-2 mb-2">
    <div>
        <h2 class="font-display-lg" style="color: var(--on-background);">Role Management</h2>
        <p class="font-body-md mt-1 mb-0" style="color: var(--on-surface-variant);">
            Define roles, set their landing page, and assign system permissions.
        </p>
    </div>
    <button type="button" class="btn-stasis-primary" data-bs-toggle="modal" data-bs-target="#addRoleModal">
        <i class="fas fa-plus"></i> Add Role
    </button>
</div>

<div class="card-stasis p-2">
    <table id="roleTable" class="table table-stasis table-sm w-100 align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Role Name</th>
                <th>Default Page</th>
                <th>Permissions</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- ============================================================
     ADD ROLE MODAL
     ============================================================ -->
<div class="modal fade" id="addRoleModal" tabindex="-1" aria-labelledby="addRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addRoleForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="addRoleModalLabel">Add Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="addRoleDesc">Role Name</label>
                        <input type="text" id="addRoleDesc" name="roleDesc" class="input-stasis" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="addDefaultPermissionId">Default Landing Page</label>
                        <select id="addDefaultPermissionId" name="defaultPermissionId" class="input-stasis form-select">
                        </select>
                        <small class="text-muted font-body-xs mt-1 d-block">
                            Users with this role will be automatically redirected to this page after login. Enabled once at least one permission is assigned.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="input-label d-block mb-2">Permissions</label>
                        <div class="permission-checkboxes" id="addPermissionList"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     EDIT ROLE MODAL
     ============================================================ -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editRoleForm" novalidate>
                <input type="hidden" id="editRoleId" name="roleId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editRoleModalLabel">Edit Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="editRoleDesc">Role Name</label>
                        <input type="text" id="editRoleDesc" name="roleDesc" class="input-stasis" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="editDefaultPermissionId">Default Landing Page</label>
                        <select id="editDefaultPermissionId" name="defaultPermissionId" class="input-stasis form-select">
                        </select>
                        <small class="text-muted font-body-xs mt-1 d-block">
                            Users with this role will be automatically redirected to this page after login. Enabled once at least one permission is assigned.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="input-label d-block mb-2">Permissions</label>
                        <div class="permission-checkboxes" id="editPermissionList"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {
            /* ================================================================
               Page data & endpoints
               ================================================================ */
            var roles = @Html.Raw(rolesJson);
            var permissions = @Html.Raw(permissionsJson);
            var saveUrl = '@Url.Action("Save", "Roles")';

            /* ================================================================
               Helpers
               ================================================================ */

            // Populates the default page combo box options dynamically based on checked permissions
            function renderDefaultPermissionOptions(selectId, selectedId, checkedPermissionIds) {
                var $select = $('#' + selectId).empty();

                // If no permissions are checked, keep the dropdown disabled with a placeholder
                if (!Array.isArray(checkedPermissionIds) || checkedPermissionIds.length === 0) {
                    $select.append($('<option></option>').val('').text('Select a default page'));
                    $select.prop('disabled', true);
                    return;
                }

                // Only offer permissions that are currently checked
                var allowedPermissions = permissions.filter(function (p) {
                    return checkedPermissionIds.indexOf(p.permissionId) > -1;
                });

                // Check if current selectedId is in allowed permissions; if not, fallback to Dashboard or first allowed
                var effectiveSelectedId = selectedId;
                var isCurrentlyAllowed = allowedPermissions.some(function (p) { return p.permissionId === effectiveSelectedId; });

                if (!isCurrentlyAllowed) {
                    var dashPermission = allowedPermissions.find(function (p) {
                        return p.permissionDesc.toLowerCase() === 'dashboard';
                    });
                    effectiveSelectedId = dashPermission ? dashPermission.permissionId : (allowedPermissions[0] ? allowedPermissions[0].permissionId : null);
                }

                $.each(allowedPermissions, function (index, permission) {
                    var isSelected = permission.permissionId === effectiveSelectedId;
                    $select.append(
                        $('<option></option>')
                            .val(permission.permissionId)
                            .text(permission.permissionDesc)
                            .prop('selected', isSelected)
                    );
                });

                $select.prop('disabled', false);
            }

            // Syncs the default page combo box with the currently checked permissions in a modal form
            function syncDefaultPageDropdown(formId, selectId, preferredSelectedId) {
                var checkedIds = $('#' + formId + ' .permission-check:checked')
                    .map(function () { return +this.value; })
                    .get();

                var currentVal = +$('#' + selectId).val();
                var targetSelectedId = currentVal || preferredSelectedId || null;

                renderDefaultPermissionOptions(selectId, targetSelectedId, checkedIds);
            }

            // Renders the permission checkbox group for a modal.
            function renderPermissionList(containerId, selectedIds) {
                var $container = $('#' + containerId).empty();
                $.each(permissions, function (index, permission) {
                    var checked = selectedIds.indexOf(permission.permissionId) > -1;
                    $container.append(
                        '<div class="form-check">' +
                            '<input class="form-check-input permission-check" type="checkbox" ' +
                                   'id="' + containerId + '_' + permission.permissionId + '" ' +
                                   'name="permissionIds" value="' + permission.permissionId + '" ' +
                                   (checked ? 'checked' : '') + ' />' +
                            '<label class="form-check-label" for="' + containerId + '_' + permission.permissionId + '">' +
                                permission.permissionDesc +
                            '</label>' +
                        '</div>'
                    );
                });
            }

            // Collects the form's named fields into a JSON-ready object.
            function getFormPayload(formId) {
                var $form = $('#' + formId);

                var payload = {};
                $.each($form.serializeArray(), function (index, field) {
                    payload[field.name] = field.value;
                });

                payload.roleId = +payload.roleId || 0;
                payload.defaultPermissionId = payload.defaultPermissionId ? +payload.defaultPermissionId : null;
                payload.permissionIds = $form.find('.permission-check:checked')
                    .map(function () { return +this.value; })
                    .get();

                return payload;
            }

            // The single AJAX call used by both Add and Edit forms.
            function submitRole(payload, $form) {
                $.ajax({
                    url: saveUrl,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            $form.closest('.modal').modal('hide');
                            Swal.fire({
                                icon: 'success',
                                title: res.message || 'Role saved successfully.'
                            }).then(function () {
                                location.reload();
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: res.message || 'Unable to save role.' });
                        }
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: 'An error occurred. Please try again.' });
                    }
                });
            }

            /* ================================================================
               Validation & Form Binding
               ================================================================ */
            function validateRolePayload(payload) {
                if (!payload.roleDesc || !payload.roleDesc.trim()) {
                    Toast.fire({ icon: 'error', title: 'Role name is required.' });
                    return false;
                }

                if (payload.permissionIds.length === 0) {
                    Toast.fire({ icon: 'error', title: 'At least one permission is required.' });
                    return false;
                }

                if (payload.defaultPermissionId && payload.permissionIds.indexOf(payload.defaultPermissionId) === -1) {
                    Toast.fire({ icon: 'error', title: 'The default page must be one of the assigned permissions.' });
                    return false;
                }

                var duplicate = roles.some(function (r) {
                    return r.roleDesc.toLowerCase() === payload.roleDesc.trim().toLowerCase()
                        && r.roleId !== payload.roleId;
                });
                if (duplicate) {
                    Toast.fire({ icon: 'error', title: 'A role with this name already exists.' });
                    return false;
                }

                return true;
            }

            function bindRoleForm(formId) {
                $('#' + formId).on('submit', function (e) {
                    e.preventDefault();

                    var payload = getFormPayload(formId);

                    if (!validateRolePayload(payload)) {
                        return;
                    }

                    submitRole(payload, $(this));
                });
            }

            /* ================================================================
               Grid (DataTables)
               ================================================================ */
            var roleTable = $('#roleTable').DataTable({
                data: roles,
                columns: [
                    { data: 'roleId' },
                    { data: 'roleDesc' },
                    {
                        data: 'defaultPermissionDesc',
                        render: function (data) {
                            var pageName = data || 'Dashboard';
                            return '<span class="status-pill status-active"><i class="fas fa-house me-1"></i>' + pageName + '</span>';
                        }
                    },
                    {
                        data: 'permissionDescs',
                        orderable: false,
                        searchable: false,
                        render: function (data) {
                            var badges = (data || []).map(function (desc) {
                                return '<span class="status-pill">' + desc + '</span>';
                            });
                            return badges.length ? badges.join(' ') : '<span class="text-muted">None</span>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: 'text-end',
                        render: function (data, type, row) {
                            return '<button type="button" class="btn-stasis-secondary edit-role-btn">' +
                                   '<i class="fas fa-pen-to-square"></i> Edit</button>';
                        }
                    }
                ],
                pageLength: 10,
                lengthMenu: [10, 25, 50],
                order: [[0, 'asc']]
            });

            /* ================================================================
               Modal & Live Sync Event Listeners
               ================================================================ */

            // Live sync Default Landing Page dropdown options when permission checkboxes change
            $('#addRoleForm').on('change', '.permission-check', function () {
                syncDefaultPageDropdown('addRoleForm', 'addDefaultPermissionId');
            });

            $('#editRoleForm').on('change', '.permission-check', function () {
                syncDefaultPageDropdown('editRoleForm', 'editDefaultPermissionId');
            });

            // Reset the Add form every time the modal opens.
            $('#addRoleModal').on('shown.bs.modal', function () {
                $('#addRoleDesc').val('').trigger('focus');
                renderPermissionList('addPermissionList', []);
                syncDefaultPageDropdown('addRoleForm', 'addDefaultPermissionId');
            });

            // Edit button: load the row's values into the Edit modal, then open it.
            $('#roleTable tbody').on('click', '.edit-role-btn', function () {
                var row = roleTable.row($(this).closest('tr')).data();
                $('#editRoleId').val(row.roleId);
                $('#editRoleDesc').val(row.roleDesc);
                renderPermissionList('editPermissionList', row.permissionIds || []);
                renderDefaultPermissionOptions('editDefaultPermissionId', row.defaultPermissionId, row.permissionIds || []);
                $('#editRoleModal').modal('show');
            });

            /* ================================================================
               Form submissions
               ================================================================ */
            bindRoleForm('addRoleForm');
            bindRoleForm('editRoleForm');
        })(jQuery);
    </script>
}
