@model RiskPulse.Models.ViewModel.RolesIndexViewModel
@{
    ViewData["Title"] = "Role Management";

    var rolesJson = Json.Serialize(Model.Roles.Select(r => new
    {
        roleId = r.RoleId,
        roleDesc = r.RoleDesc,
        permissionIds = r.RolePermissions.Select(rp => rp.PermissionId).ToList(),
        permissionDescs = r.RolePermissions.Select(rp => rp.Permission?.PermissionDesc).ToList()
    }));
    var permissionsJson = Json.Serialize(Model.Permissions.Select(p => new { permissionId = p.PermissionId, permissionDesc = p.PermissionDesc }));
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-3 mb-3">
    <div>
        <h2 class="font-display-lg" style="color: var(--on-background);">Role Management</h2>
        <p class="font-body-md mt-1 mb-0" style="color: var(--on-surface-variant);">
            Define roles and assign the system permissions they are allowed to access.
        </p>
    </div>
    <button type="button" class="btn-stasis-primary" data-bs-toggle="modal" data-bs-target="#addRoleModal">
        <i class="fas fa-plus"></i> Add Role
    </button>
</div>

@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="alert alert-success" role="alert">@successMsg</div>
}
@if (TempData["ErrorMessage"] is string errorMsg)
{
    <div class="alert alert-danger" role="alert">@errorMsg</div>
}

<div class="card-stasis p-3">
    <table id="roleTable" class="table table-stasis w-100 align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Role Name</th>
                <th>Permissions</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- ============================================================
     ADD ROLE MODAL
     ============================================================ -->
<div class="modal fade" id="addRoleModal" tabindex="-1" aria-labelledby="addRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addRoleForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="addRoleModalLabel">Add Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger d-none" id="addRoleError" role="alert"></div>

                    <div class="mb-3">
                        <label class="input-label" for="addRoleDesc">Role Name</label>
                        <input type="text" id="addRoleDesc" name="roleDesc" class="input-stasis" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label d-block mb-2">Permissions</label>
                        <div class="permission-checkboxes" id="addPermissionList"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     EDIT ROLE MODAL
     ============================================================ -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editRoleForm" novalidate>
                <input type="hidden" id="editRoleId" name="roleId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editRoleModalLabel">Edit Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger d-none" id="editRoleError" role="alert"></div>

                    <div class="mb-3">
                        <label class="input-label" for="editRoleDesc">Role Name</label>
                        <input type="text" id="editRoleDesc" name="roleDesc" class="input-stasis" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label d-block mb-2">Permissions</label>
                        <div class="permission-checkboxes" id="editPermissionList"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {
            /* ================================================================
               Page data & endpoints
               ================================================================ */
            var roles = @Html.Raw(rolesJson);
            var permissions = @Html.Raw(permissionsJson);
            var saveUrl = '@Url.Action("Save", "Roles")';

            /* ================================================================
               Helpers
               ================================================================ */

            // Renders the permission checkbox group for a modal.
            function renderPermissionList(containerId, selectedIds) {
                var $container = $('#' + containerId).empty();
                $.each(permissions, function (index, permission) {
                    var checked = selectedIds.indexOf(permission.permissionId) > -1;
                    $container.append(
                        '<div class="form-check">' +
                            '<input class="form-check-input permission-check" type="checkbox" ' +
                                   'id="' + containerId + '_' + permission.permissionId + '" ' +
                                   'name="permissionIds" value="' + permission.permissionId + '" ' +
                                   (checked ? 'checked' : '') + ' />' +
                            '<label class="form-check-label" for="' + containerId + '_' + permission.permissionId + '">' +
                                permission.permissionDesc +
                            '</label>' +
                        '</div>'
                    );
                });
            }

            // Shows an inline error message inside a modal.
            function showError($el, message) {
                $el.removeClass('d-none').text(message);
            }

            // Collects the form's named fields into a JSON-ready object.
            function getFormPayload(formId) {
                var $form = $('#' + formId);

                var payload = {};
                $.each($form.serializeArray(), function (index, field) {
                    payload[field.name] = field.value;
                });

                payload.roleId = +payload.roleId || 0;
                payload.permissionIds = $form.find('.permission-check:checked')
                    .map(function () { return +this.value; })
                    .get();

                return payload;
            }

            // The single AJAX call used by both Add and Edit forms.
            function submitRole(payload, $errorEl) {
                $.ajax({
                    url: saveUrl,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            location.reload();
                        } else {
                            showError($errorEl, res.message || 'Unable to save role.');
                        }
                    },
                    error: function () {
                        showError($errorEl, 'An error occurred. Please try again.');
                    }
                });
            }

            // Wires a form to the shared save flow. Add and Edit share this.
            function bindRoleForm(formId, errorId) {
                $('#' + formId).on('submit', function (e) {
                    e.preventDefault();
                    var $error = $('#' + errorId);
                    var payload = getFormPayload(formId);

                    if (!payload.roleDesc || !payload.roleDesc.trim()) {
                        showError($error, 'Role name is required.');
                        return;
                    }

                    if (payload.permissionIds.length === 0) {
                        showError($error, 'At least one permission is required.');
                        return;
                    }

                    var duplicate = roles.some(function (r) {
                        return r.roleDesc.toLowerCase() === payload.roleDesc.trim().toLowerCase()
                            && r.roleId !== payload.roleId;
                    });
                    if (duplicate) {
                        showError($error, 'A role with this name already exists.');
                        return;
                    }

                    submitRole(payload, $error);
                });
            }

            /* ================================================================
               Grid (DataTables) - client-side search, pagination, sorting
               ================================================================ */
            var roleTable = $('#roleTable').DataTable({
                data: roles,
                columns: [
                    { data: 'roleId' },
                    { data: 'roleDesc' },
                    {
                        data: 'permissionDescs',
                        orderable: false,
                        searchable: false,
                        render: function (data) {
                            var badges = (data || []).map(function (desc) {
                                return '<span class="status-pill">' + desc + '</span>';
                            });
                            return badges.length ? badges.join(' ') : '<span class="text-muted">None</span>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: 'text-end',
                        render: function (data, type, row) {
                            return '<button type="button" class="btn-stasis-secondary edit-role-btn">' +
                                   '<i class="fas fa-pen-to-square"></i> Edit</button>';
                        }
                    }
                ],
                pageLength: 10,
                lengthMenu: [10, 25, 50],
                order: [[0, 'asc']]
            });

            /* ================================================================
               Modal events
               ================================================================ */

            // Reset the Add form every time the modal opens.
            $('#addRoleModal').on('shown.bs.modal', function () {
                $('#addRoleDesc').val('').trigger('focus');
                renderPermissionList('addPermissionList', []);
                $('#addRoleError').addClass('d-none');
            });

            // Clear stale errors whenever the Edit modal opens.
            $('#editRoleModal').on('shown.bs.modal', function () {
                $('#editRoleError').addClass('d-none');
            });

            // Edit button: load the row's values into the Edit modal, then open it.
            $('#roleTable tbody').on('click', '.edit-role-btn', function () {
                var row = roleTable.row($(this).closest('tr')).data();
                $('#editRoleId').val(row.roleId);
                $('#editRoleDesc').val(row.roleDesc);
                renderPermissionList('editPermissionList', row.permissionIds || []);
                $('#editRoleModal').modal('show');
            });

            /* ================================================================
               Form submissions (shared pattern for Add and Edit)
               ================================================================ */
            bindRoleForm('addRoleForm', 'addRoleError');
            bindRoleForm('editRoleForm', 'editRoleError');
        })(jQuery);
    </script>
}
