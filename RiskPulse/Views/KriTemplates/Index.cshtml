@model RiskPulse.Models.ViewModel.KriTemplatesIndexViewModel
@{
    ViewData["Title"] = "KRI Templates";

    var statusesJson = Json.Serialize(Model.KriStatuses);
    var groupsJson = Json.Serialize(Model.KriGroups);
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
    <style>
        .design-split { display: flex; min-height: 440px; max-height: 68vh; }
        .design-left { width: 310px; min-width: 260px; border-right: 1px solid var(--outline-variant); display: flex; flex-direction: column; }
        .design-left-list { flex: 1; overflow-y: auto; padding: 0.5rem; }
        .design-right { flex: 1; overflow-y: auto; }
        .kri-item { cursor: pointer; border-left: 3px solid transparent; transition: border-color 0.15s, background 0.15s; }
        .kri-item:hover { background: rgba(27, 54, 93, 0.03); }
        .kri-item.selected { border-left-color: var(--primary-container); background: rgba(27, 54, 93, 0.05); }
        .kri-item .kri-delete-btn { opacity: 0; transition: opacity 0.15s; }
        .kri-item:hover .kri-delete-btn { opacity: 1; }
    </style>
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-2 mb-2">
    <div>
        <h2 class="font-display-lg" style="color: var(--on-background);">KRI Templates</h2>
        <p class="font-body-md mt-1 mb-0" style="color: var(--on-surface-variant);">
            Manage Key Risk Indicator templates — build KRIs and their threshold groups.
        </p>
    </div>
    <button type="button" class="btn-stasis-primary" data-bs-toggle="modal" data-bs-target="#kriModal">
        <i class="fas fa-plus"></i> Add Template
    </button>
</div>

<div class="card-stasis p-2">
    <table id="kriTable" class="table table-stasis table-sm w-100 align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Description</th>
                <th>Status</th>
                <th>KRIs</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- ============================================================
     ADD / EDIT TEMPLATE MODAL
     ============================================================ -->
<div class="modal fade" id="kriModal" tabindex="-1" aria-labelledby="kriModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="kriForm" novalidate>
                <input type="hidden" id="kriHeaderId" name="kriHeaderId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="kriModalLabel">Add Template</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="kriHeaderDesc">Description</label>
                        <input type="text" id="kriHeaderDesc" name="kriHeaderDesc" class="input-stasis" required autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label class="input-label" for="kriStatus">Status</label>
                        <select id="kriStatus" name="kriStatus" class="input-stasis"></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     DESIGN MODAL — Split-Pane KRI Builder
     ============================================================ -->
<div class="modal fade" id="designModal" tabindex="-1" aria-labelledby="designModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header py-2">
                <div>
                    <h5 class="modal-title" id="designModalLabel">Design Template</h5>
                    <div id="designStatusPill" class="mt-1"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="design-split">
                    <!-- LEFT PANEL: KRI List -->
                    <div class="design-left">
                        <div class="p-2 border-bottom d-flex justify-content-between align-items-center">
                            <span class="font-label-md" style="color: var(--on-surface-variant);">KRIs (<span id="kriCount">0</span>)</span>
                            <button type="button" class="btn-stasis-primary" id="addKriItemBtn">
                                <i class="fas fa-plus"></i> Add
                            </button>
                        </div>
                        <div class="design-left-list" id="kriList"></div>
                    </div>
                    <!-- RIGHT PANEL: Editor -->
                    <div class="design-right">
                        <div id="editorEmptyState" class="d-flex flex-column align-items-center justify-content-center h-100 text-muted py-5">
                            <i class="fas fa-gauge-high fa-2x mb-3" style="opacity:0.4;"></i>
                            <p class="font-body-md mb-0">Select a KRI on the left, or click <strong>Add</strong> to create one.</p>
                        </div>
                        <div id="kriEditor" class="p-3 d-none">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0" id="editorTitle">New KRI</h6>
                                <input type="hidden" id="editorKriId" value="0" />
                            </div>
                            <div class="mb-2">
                                <label class="input-label" for="editorKriDesc">KRI Description</label>
                                <textarea id="editorKriDesc" class="input-stasis w-100" rows="2" autocomplete="off" placeholder="e.g. Number of late cash counts this month"></textarea>
                            </div>
                            <div class="mb-2">
                                <label class="input-label" for="editorGroupId">Threshold Group</label>
                                <select id="editorGroupId" class="input-stasis w-100"></select>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="editorAllowComment" checked disabled />
                                <label class="form-check-label font-body-md" for="editorAllowComment">Allow comments for this question</label>
                            </div>
                            <div class="mt-3 d-flex gap-2">
                                <button type="button" class="btn-stasis-primary" id="saveKriItemBtn">
                                    <i class="fas fa-check"></i> Save KRI
                                </button>
                                <button type="button" class="btn-stasis-secondary" id="cancelKriItemBtn">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <span class="text-muted font-body-sm me-auto" id="lockedNotice" style="display:none;">
                    <i class="fas fa-lock me-1"></i> This template is locked and cannot be modified.
                </span>
                <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var statuses = @Html.Raw(statusesJson);
            var groups = @Html.Raw(groupsJson);
            var gridUrl = '@Url.Action("Grid", "KriTemplates")';
            var saveUrl = '@Url.Action("Save", "KriTemplates")';
            var deleteUrl = '@Url.Action("Delete", "KriTemplates")';
            var krisGridUrl = '@Url.Action("KrisGrid", "KriTemplates")';
            var saveKriUrl = '@Url.Action("SaveKri", "KriTemplates")';
            var deleteKriUrl = '@Url.Action("DeleteKri", "KriTemplates")';

            var currentKriId = 0;
            var currentKriLocked = false;
            var loadedKris = [];
            var selectedKriId = null;

            /* =================================================================
               SECTION 2 — UI RENDERERS
               ================================================================= */
            function statusPill(status) {
                switch (status) {
                    case 'Active': return '<span class="status-pill rag-green">Active</span>';
                    case 'Locked': return '<span class="status-pill rag-amber">Locked</span>';
                    default: return '<span class="status-pill rag-red">Inactive</span>';
                }
            }

            function renderKriList(kris) {
                loadedKris = kris || [];
                var $container = $('#kriList').empty();
                $('#kriCount').text(loadedKris.length);

                if (!loadedKris.length) {
                    $container.append('<div class="text-center text-muted font-body-sm py-4">No KRIs yet.</div>');
                    return;
                }

                $.each(loadedKris, function (i, k) {
                    var $item = $('<div class="kri-item card-stasis p-2 mb-1">').data('kri', k);
                    if (k.kriId === selectedKriId) $item.addClass('selected');

                    var $top = $('<div class="d-flex justify-content-between align-items-center gap-1">');
                    var $label = $('<div class="font-body-md fw-semibold" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">');
                    $label.append($('<span>').text(k.kriDesc));
                    $top.append($label);

                    if (!currentKriLocked) {
                        $top.append(
                            $('<button type="button" class="btn-stasis-secondary kri-delete-btn" title="Delete" style="padding:0.15rem 0.4rem;">')
                                .append('<i class="fas fa-trash-can"></i>')
                                .data('kri', k)
                        );
                    }
                    $item.append($top);

                    var $meta = $('<div class="font-body-sm text-muted mt-1">');
                    $meta.text(k.kriThresholdGroupDesc ? k.kriThresholdGroupDesc : '');
                    $item.append($meta);

                    $container.append($item);
                });
            }

            function showEditor(kri) {
                selectedKriId = kri ? kri.kriId : null;
                $('#editorKriId').val(kri ? kri.kriId : 0);
                $('#editorKriDesc').val(kri ? kri.kriDesc : '');
                $('#editorAllowComment').prop('checked', true);
                $('#editorGroupId').val(kri ? kri.kriThresholdGroupId : (groups.length ? groups[0].value : 0));
                $('#editorTitle').text(kri ? 'Edit KRI #' + kri.kriId : 'New KRI');

                $('#editorEmptyState').addClass('d-none');
                $('#kriEditor').removeClass('d-none');
                highlightSelected();
                $('#editorKriDesc').trigger('focus');
            }

            function hideEditor() {
                selectedKriId = null;
                $('#kriEditor').addClass('d-none');
                $('#editorEmptyState').removeClass('d-none');
                highlightSelected();
            }

            function highlightSelected() {
                $('#kriList .kri-item').removeClass('selected');
                if (selectedKriId !== null) {
                    $('#kriList .kri-item').each(function () {
                        if ($(this).data('kri').kriId === selectedKriId) {
                            $(this).addClass('selected');
                        }
                    });
                }
            }

            /* =================================================================
               SECTION 3 — FORM PAYLOAD BUILDERS
               ================================================================= */
            function getHeaderPayload($form) {
                var payload = RiskPulse.serializeForm($form, {
                    numbers: ['kriHeaderId']
                });
                return payload;
            }

            function getKriPayload() {
                return {
                    kriId: +$('#editorKriId').val() || 0,
                    kriHeaderId: currentKriId,
                    kriDesc: $.trim($('#editorKriDesc').val()),
                    allowComment: true,
                    kriThresholdGroupId: +$('#editorGroupId').val() || 0
                };
            }

            /* =================================================================
               SECTION 4 — VALIDATION
               ================================================================= */
            function validateHeaderPayload(payload) {
                if (!$.trim(payload.kriHeaderDesc)) { RiskPulse.toastError('Template description is required.'); return false; }
                if (!payload.kriStatus) { RiskPulse.toastError('Please select a status.'); return false; }
                return true;
            }

            function validateKriPayload(payload) {
                if (!payload.kriDesc) { RiskPulse.toastError('KRI description is required.'); return false; }
                if (!payload.kriThresholdGroupId) { RiskPulse.toastError('Please select a threshold group.'); return false; }
                return true;
            }

            /* =================================================================
               SECTION 5 — CONTROLLER CALLS (AJAX)
               ================================================================= */
            function submitHeader(payload, $form) {
                RiskPulse.postJson(saveUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        kriTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'Template saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save template.');
                    }
                });
            }

            function deleteHeader(kriHeaderId, desc) {
                RiskPulse.confirmDelete(
                    'Delete template?',
                    'This will permanently delete "' + desc + '" and all of its KRIs.',
                    function () {
                        RiskPulse.postJson(deleteUrl, { id: kriHeaderId }, {
                            success: function (res) {
                                kriTable.ajax.reload(null, false);
                                RiskPulse.toastSuccess(res.message || 'Template deleted successfully.');
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to delete template.');
                            }
                        });
                    }
                );
            }

            function loadKris() {
                RiskPulse.getJson(krisGridUrl, { kriHeaderId: currentKriId }, {
                    success: function (res) {
                        renderKriList(res.data);
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to load KRIs.');
                    }
                });
            }

            function submitKri(payload) {
                RiskPulse.postJson(saveKriUrl, payload, {
                    success: function (res) {
                        hideEditor();
                        loadKris();
                        RiskPulse.toastSuccess(res.message || 'KRI saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save KRI.');
                    }
                });
            }

            function deleteKri(kri) {
                RiskPulse.confirmDelete(
                    'Delete KRI?',
                    'This will permanently delete "' + kri.kriDesc + '".',
                    function () {
                        RiskPulse.postJson(deleteKriUrl, { id: kri.kriId }, {
                            success: function (res) {
                                if (selectedKriId === kri.kriId) hideEditor();
                                loadKris();
                                RiskPulse.toastSuccess(res.message || 'KRI deleted successfully.');
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to delete KRI.');
                            }
                        });
                    }
                );
            }

            /* =================================================================
               SECTION 6 — DATA GRID (DataTables)
               ================================================================= */
            var kriTable = RiskPulse.initGrid($('#kriTable'), {
                ajax: { url: gridUrl },
                columns: [
                    { data: 'kriHeaderId' },
                    { data: 'kriHeaderDesc' },
                    { data: 'kriStatus', render: function (d) { return statusPill(d); } },
                    { data: 'kriCount', render: function (d) { return '<span class="status-pill">' + (d || 0) + '</span>'; } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function (data, type, row) {
                        var locked = row.kriStatus === 'Locked';
                        return [
                            '<button type="button" class="btn-stasis-secondary design-kri-btn"><i class="fas fa-pen-ruler"></i> Design</button>',
                            locked
                                ? '<button type="button" class="btn-stasis-secondary" disabled title="Locked templates cannot be edited"><i class="fas fa-pen-to-square"></i> Edit</button>'
                                : '<button type="button" class="btn-stasis-secondary edit-kri-btn"><i class="fas fa-pen-to-square"></i> Edit</button>',
                            locked
                                ? '<button type="button" class="btn-stasis-secondary" disabled title="Locked templates cannot be deleted"><i class="fas fa-trash-can"></i> Delete</button>'
                                : '<button type="button" class="btn-stasis-secondary delete-kri-btn"><i class="fas fa-trash-can"></i> Delete</button>'
                        ].join(' ');
                    } }
                ],
                order: [[0, 'asc']]
            });

            /* =================================================================
               SECTION 7 — EVENT WIRING & INIT
               ================================================================= */
            RiskPulse.populateSelect($('#kriStatus'), statuses);
            RiskPulse.populateSelect($('#editorGroupId'), groups);

            $('#kriModal').on('shown.bs.modal', function () {
                if ($('#kriHeaderId').val() == 0) {
                    $('#kriHeaderDesc').val('').trigger('focus');
                    $('#kriStatus').val('Active').trigger('change');
                }
            });

            $('#kriTable tbody').on('click', '.edit-kri-btn', function () {
                var row = kriTable.row($(this).closest('tr')).data();
                $('#kriHeaderId').val(row.kriHeaderId);
                $('#kriHeaderDesc').val(row.kriHeaderDesc);
                $('#kriStatus').val(row.kriStatus).trigger('change');
                $('#kriModalLabel').text('Edit Template');
                RiskPulse.showModal('kriModal');
            });

            $('#kriTable tbody').on('click', '.delete-kri-btn', function () {
                var row = kriTable.row($(this).closest('tr')).data();
                deleteHeader(row.kriHeaderId, row.kriHeaderDesc);
            });

            $('#kriModal').on('hidden.bs.modal', function () {
                $('#kriHeaderId').val(0);
                $('#kriModalLabel').text('Add Template');
            });

            $('#kriForm').on('submit', function (e) {
                e.preventDefault();
                var payload = getHeaderPayload($(this));
                if (validateHeaderPayload(payload)) submitHeader(payload, $(this));
            });

            // Open Design modal
            $('#kriTable tbody').on('click', '.design-kri-btn', function () {
                var row = kriTable.row($(this).closest('tr')).data();
                currentKriId = row.kriHeaderId;
                currentKriLocked = row.kriStatus === 'Locked';

                $('#designModalLabel').text('Design: ' + row.kriHeaderDesc);
                $('#designStatusPill').html(statusPill(row.kriStatus));

                if (currentKriLocked) {
                    $('#lockedNotice').show();
                    $('#addKriItemBtn').hide();
                } else {
                    $('#lockedNotice').hide();
                    $('#addKriItemBtn').show();
                }

                hideEditor();
                loadKris();
                RiskPulse.showModal('designModal');
            });

            // Reload the grid when the designer closes so KRI counts stay fresh
            $('#designModal').on('hidden.bs.modal', function () {
                kriTable.ajax.reload(null, false);
            });

            // Left panel: click KRI to edit
            $('#kriList').on('click', '.kri-item', function (e) {
                if ($(e.target).closest('.kri-delete-btn').length) return;
                if (currentKriLocked) return;
                showEditor($(this).data('kri'));
            });

            // Left panel: delete button
            $('#kriList').on('click', '.kri-delete-btn', function (e) {
                e.stopPropagation();
                deleteKri($(this).data('kri'));
            });

            // Add KRI
            $('#addKriItemBtn').on('click', function () {
                if (!currentKriLocked) showEditor(null);
            });

            // Save / Cancel KRI
            $('#saveKriItemBtn').on('click', function () {
                var payload = getKriPayload();
                if (validateKriPayload(payload)) submitKri(payload);
            });

            $('#cancelKriItemBtn').on('click', function () {
                hideEditor();
            });
        })(jQuery);
    </script>
}
