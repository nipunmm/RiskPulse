@model RiskPulse.Models.ViewModel.KriTemplatesIndexViewModel
@{
    ViewData["Title"] = "KRI Templates";

    var statusesJson = Json.Serialize(Model.KriStatuses);
    var unitGroupsJson = Json.Serialize(Model.UnitGroups);
    var unitsJson = Json.Serialize(Model.Units);
    var groupsJson = Json.Serialize(Model.KriGroups);
    var colorsJson = Json.Serialize(Model.Colors.Select(c => new { colorId = c.ColorId, colorDesc = c.ColorDesc, hexCode = c.HexCode }));
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
    <style>
        .design-split { display: flex; min-height: 440px; max-height: 68vh; }
        .design-left { width: 310px; min-width: 260px; border-right: 1px solid var(--outline-variant); display: flex; flex-direction: column; }
        .design-left-list { flex: 1; overflow-y: auto; padding: 0.5rem; }
        .design-right { flex: 1; overflow-y: auto; }
        .kri-item { cursor: pointer; border-left: 3px solid transparent; transition: border-color 0.15s, background 0.15s; }
        .kri-item:hover { background: rgba(27, 54, 93, 0.03); }
        .kri-item.selected { border-left-color: var(--primary-container); background: rgba(27, 54, 93, 0.05); }
        .kri-item .kri-delete-btn { opacity: 0; transition: opacity 0.15s; }
        .kri-item:hover .kri-delete-btn { opacity: 1; }
    </style>
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-2 mb-2">
    <div>
        <h2 class="font-display-lg" style="color: var(--on-background);">KRI Templates</h2>
        <p class="font-body-md mt-1 mb-0" style="color: var(--on-surface-variant);">
            Manage Key Risk Indicator templates — build KRIs and configure the threshold colors and groups behind them.
        </p>
    </div>
</div>

<!-- ============================================================
     TABS — KRI TEMPLATES | THRESHOLD COLORS | KRI GROUPS
     ============================================================ -->
<div class="card-stasis p-2">
    <ul class="nav nav-tabs" id="kriTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="kriTemplatesTab" data-bs-toggle="tab" data-bs-target="#templatesPane" type="button" role="tab" aria-controls="templatesPane" aria-selected="true">
                <i class="fas fa-gauge-high"></i> KRI Templates
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="colorsTab" data-bs-toggle="tab" data-bs-target="#colorsPane" type="button" role="tab" aria-controls="colorsPane" aria-selected="false">
                <i class="fas fa-palette"></i> Threshold Colors
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="groupsTab" data-bs-toggle="tab" data-bs-target="#groupsPane" type="button" role="tab" aria-controls="groupsPane" aria-selected="false">
                <i class="fas fa-layer-group"></i> KRI Groups
            </button>
        </li>
    </ul>

    <div class="tab-content pt-3">
        <!-- ============================================================
             KRI TEMPLATES PANE
             ============================================================ -->
        <div class="tab-pane fade show active" id="templatesPane" role="tabpanel" aria-labelledby="kriTemplatesTab">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-2 pb-2">
                <p class="mb-0 font-body-sm" style="color: var(--on-surface-variant);">Build KRI template headers and their KRIs.</p>
                <button type="button" class="btn-stasis-primary" data-bs-toggle="modal" data-bs-target="#kriModal">
                    <i class="fas fa-plus"></i> Add Template
                </button>
            </div>
            <table id="kriTable" class="table table-stasis table-sm w-100 align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Description</th>
                        <th>Assigned To</th>
                        <th>Status</th>
                        <th>KRIs</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>

        <!-- ============================================================
             THRESHOLD COLORS PANE
             ============================================================ -->
        <div class="tab-pane fade" id="colorsPane" role="tabpanel" aria-labelledby="colorsTab">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-2 pb-2">
                <p class="mb-0 font-body-sm" style="color: var(--on-surface-variant);">Configure the color palette used to map KRI values to risk levels.</p>
                <button type="button" class="btn-stasis-primary" data-bs-toggle="modal" data-bs-target="#colorModal">
                    <i class="fas fa-plus"></i> Add Color
                </button>
            </div>
            <table id="colorTable" class="table table-stasis table-sm w-100 align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Description</th>
                        <th>Hex Code</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>

        <!-- ============================================================
             KRI GROUPS PANE
             ============================================================ -->
        <div class="tab-pane fade" id="groupsPane" role="tabpanel" aria-labelledby="groupsTab">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-2 pb-2">
                <p class="mb-0 font-body-sm" style="color: var(--on-surface-variant);">Group threshold bands and attach them to KRIs.</p>
                <button type="button" class="btn-stasis-primary" data-bs-toggle="modal" data-bs-target="#groupModal">
                    <i class="fas fa-plus"></i> Add Group
                </button>
            </div>
            <table id="groupTable" class="table table-stasis table-sm w-100 align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Description</th>
                        <th>Bands</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- ============================================================
     ADD / EDIT TEMPLATE MODAL
     ============================================================ -->
<div class="modal fade" id="kriModal" tabindex="-1" aria-labelledby="kriModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="kriForm" novalidate>
                <input type="hidden" id="kriHeaderId" name="kriHeaderId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="kriModalLabel">Add Template</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="kriHeaderDesc">Description</label>
                        <input type="text" id="kriHeaderDesc" name="kriHeaderDesc" class="input-stasis" required autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label class="input-label" for="kriLinkType">Link Type</label>
                        <select id="kriLinkType" class="input-stasis">
                            <option value="group">Unit Group</option>
                            <option value="unit">Unit</option>
                        </select>
                    </div>
                    <div class="mb-3" id="kriGroupRow">
                        <label class="input-label" for="kriGroupId">Unit Group</label>
                        <select id="kriGroupId" name="groupId" class="input-stasis"></select>
                    </div>
                    <div class="mb-3 d-none" id="kriUnitRow">
                        <label class="input-label" for="kriUnitId">Unit</label>
                        <select id="kriUnitId" name="unitId" class="input-stasis"></select>
                    </div>
                    <div class="mb-3">
                        <label class="input-label" for="kriStatus">Status</label>
                        <select id="kriStatus" name="kriStatus" class="input-stasis"></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     ADD / EDIT COLOR MODAL
     ============================================================ -->
<div class="modal fade" id="colorModal" tabindex="-1" aria-labelledby="colorModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="colorForm" novalidate>
                <input type="hidden" id="colorId" name="colorId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="colorModalLabel">Add Color</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="colorDesc">Description</label>
                        <input type="text" id="colorDesc" name="colorDesc" class="input-stasis" required autocomplete="off" placeholder="e.g. Red" />
                    </div>
                    <div class="mb-3">
                        <label class="input-label" for="hexCode">Hex Code</label>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="text" id="hexCode" name="hexCode" class="input-stasis" required autocomplete="off" placeholder="#RRGGBB" />
                            <span id="colorSwatch" style="width:28px;height:28px;border-radius:4px;border:1px solid var(--outline-variant);"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     ADD / EDIT GROUP MODAL
     ============================================================ -->
<div class="modal fade" id="groupModal" tabindex="-1" aria-labelledby="groupModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="groupForm" novalidate>
                <input type="hidden" id="groupModalId" name="kriThresholdGroupId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="groupModalLabel">Add Group</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="groupDesc">Description</label>
                        <input type="text" id="groupDesc" name="kriThresholdGroupDesc" class="input-stasis" required autocomplete="off" placeholder="e.g. Standard RAG bands" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     BANDS MODAL
     ============================================================ -->
<div class="modal fade" id="bandsModal" tabindex="-1" aria-labelledby="bandsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="bandsModalLabel">Threshold Bands</h5>
                    <small class="text-muted font-body-sm" id="bandsGroupLabel"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2 d-flex justify-content-between align-items-center">
                    <span class="text-muted font-body-sm">Each band maps a value range to a color.</span>
                    <button type="button" class="btn-stasis-secondary" id="addBandBtn">
                        <i class="fas fa-plus"></i> Add Band
                    </button>
                </div>
                <div id="bandRows"></div>
                <div class="mt-3">
                    <button type="button" class="btn-stasis-primary" id="saveBandsBtn">
                        <i class="fas fa-check"></i> Save Bands
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     DESIGN MODAL — Split-Pane KRI Builder
     ============================================================ -->
<div class="modal fade" id="designModal" tabindex="-1" aria-labelledby="designModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header py-2">
                <div>
                    <h5 class="modal-title" id="designModalLabel">Design Template</h5>
                    <div id="designStatusPill" class="mt-1"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="design-split">
                    <!-- LEFT PANEL: KRI List -->
                    <div class="design-left">
                        <div class="p-2 border-bottom d-flex justify-content-between align-items-center">
                            <span class="font-label-md" style="color: var(--on-surface-variant);">KRIs (<span id="kriCount">0</span>)</span>
                            <button type="button" class="btn-stasis-primary" id="addKriItemBtn">
                                <i class="fas fa-plus"></i> Add
                            </button>
                        </div>
                        <div class="design-left-list" id="kriList"></div>
                    </div>
                    <!-- RIGHT PANEL: Editor -->
                    <div class="design-right">
                        <div id="editorEmptyState" class="d-flex flex-column align-items-center justify-content-center h-100 text-muted py-5">
                            <i class="fas fa-gauge-high fa-2x mb-3" style="opacity:0.4;"></i>
                            <p class="font-body-md mb-0">Select a KRI on the left, or click <strong>Add</strong> to create one.</p>
                        </div>
                        <div id="kriEditor" class="p-3 d-none">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0" id="editorTitle">New KRI</h6>
                                <input type="hidden" id="editorKriId" value="0" />
                            </div>
                            <div class="mb-2">
                                <label class="input-label" for="editorKriDesc">KRI Description</label>
                                <textarea id="editorKriDesc" class="input-stasis w-100" rows="2" autocomplete="off" placeholder="e.g. Number of late cash counts this month"></textarea>
                            </div>
                            <div class="mb-2">
                                <label class="input-label" for="editorGroupId">Threshold Group</label>
                                <select id="editorGroupId" class="input-stasis w-100"></select>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="editorAllowComment" checked disabled />
                                <label class="form-check-label font-body-md" for="editorAllowComment">Allow comments for this question</label>
                            </div>
                            <div class="mt-3 d-flex gap-2">
                                <button type="button" class="btn-stasis-primary" id="saveKriItemBtn">
                                    <i class="fas fa-check"></i> Save KRI
                                </button>
                                <button type="button" class="btn-stasis-secondary" id="cancelKriItemBtn">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <span class="text-muted font-body-sm me-auto" id="lockedNotice" style="display:none;">
                    <i class="fas fa-lock me-1"></i> This template is locked and cannot be modified.
                </span>
                <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var statuses = @Html.Raw(statusesJson);
            var unitGroups = @Html.Raw(unitGroupsJson);
            var units = @Html.Raw(unitsJson);
            var groups = @Html.Raw(groupsJson);
            var colors = @Html.Raw(colorsJson);

            var gridUrl = '@Url.Action("Grid", "KriTemplates")';
            var saveUrl = '@Url.Action("Save", "KriTemplates")';
            var deleteUrl = '@Url.Action("Delete", "KriTemplates")';
            var krisGridUrl = '@Url.Action("KrisGrid", "KriTemplates")';
            var saveKriUrl = '@Url.Action("SaveKri", "KriTemplates")';
            var deleteKriUrl = '@Url.Action("DeleteKri", "KriTemplates")';
            var colorsGridUrl = '@Url.Action("ColorsGrid", "KriTemplates")';
            var saveColorUrl = '@Url.Action("SaveColor", "KriTemplates")';
            var deleteColorUrl = '@Url.Action("DeleteColor", "KriTemplates")';
            var groupsGridUrl = '@Url.Action("GroupsGrid", "KriTemplates")';
            var saveGroupUrl = '@Url.Action("SaveGroup", "KriTemplates")';
            var deleteGroupUrl = '@Url.Action("DeleteGroup", "KriTemplates")';
            var bandsGridUrl = '@Url.Action("BandsGrid", "KriTemplates")';
            var saveBandsUrl = '@Url.Action("SaveBands", "KriTemplates")';

            var currentKriId = 0;
            var currentKriLocked = false;
            var loadedKris = [];
            var selectedKriId = null;
            var currentGroupId = 0;

            /* =================================================================
               SECTION 2 — UI RENDERERS
               ================================================================= */
            function statusPill(status) {
                switch (status) {
                    case 'Active': return '<span class="status-pill rag-green">Active</span>';
                    case 'Locked': return '<span class="status-pill rag-amber">Locked</span>';
                    default: return '<span class="status-pill rag-red">Inactive</span>';
                }
            }

            function swatch(hex) {
                return $('<span style="display:inline-block;width:16px;height:16px;border-radius:3px;border:1px solid var(--outline-variant);"></span>').css('background', hex);
            }

            function renderKriList(kris) {
                loadedKris = kris || [];
                var $container = $('#kriList').empty();
                $('#kriCount').text(loadedKris.length);

                if (!loadedKris.length) {
                    $container.append('<div class="text-center text-muted font-body-sm py-4">No KRIs yet.</div>');
                    return;
                }

                $.each(loadedKris, function (i, k) {
                    var $item = $('<div class="kri-item card-stasis p-2 mb-1">').data('kri', k);
                    if (k.kriId === selectedKriId) $item.addClass('selected');

                    var $top = $('<div class="d-flex justify-content-between align-items-center gap-1">');
                    var $label = $('<div class="font-body-md fw-semibold" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">');
                    $label.append($('<span>').text(k.kriDesc));
                    $top.append($label);

                    if (!currentKriLocked) {
                        $top.append(
                            $('<button type="button" class="btn-stasis-secondary kri-delete-btn" title="Delete" style="padding:0.15rem 0.4rem;">')
                                .append('<i class="fas fa-trash-can"></i>')
                                .data('kri', k)
                        );
                    }
                    $item.append($top);

                    var $meta = $('<div class="font-body-sm text-muted mt-1">');
                    $meta.text(k.kriThresholdGroupDesc ? k.kriThresholdGroupDesc : '');
                    $item.append($meta);

                    $container.append($item);
                });
            }

            function showEditor(kri) {
                selectedKriId = kri ? kri.kriId : null;
                $('#editorKriId').val(kri ? kri.kriId : 0);
                $('#editorKriDesc').val(kri ? kri.kriDesc : '');
                $('#editorAllowComment').prop('checked', true);
                $('#editorGroupId').val(kri ? kri.kriThresholdGroupId : (groups.length ? groups[0].value : 0));
                $('#editorTitle').text(kri ? 'Edit KRI #' + kri.kriId : 'New KRI');

                $('#editorEmptyState').addClass('d-none');
                $('#kriEditor').removeClass('d-none');
                highlightSelected();
                $('#editorKriDesc').trigger('focus');
            }

            function hideEditor() {
                selectedKriId = null;
                $('#kriEditor').addClass('d-none');
                $('#editorEmptyState').removeClass('d-none');
                highlightSelected();
            }

            function highlightSelected() {
                $('#kriList .kri-item').removeClass('selected');
                if (selectedKriId !== null) {
                    $('#kriList .kri-item').each(function () {
                        if ($(this).data('kri').kriId === selectedKriId) {
                            $(this).addClass('selected');
                        }
                    });
                }
            }

            function bandRowHtml(band) {
                band = band || {};
                return $('<div class="band-row d-flex gap-2 mb-2 align-items-center">').append(
                    $('<span class="font-body-sm text-muted" style="min-width:1.25rem;">').text('1.'),
                    $('<select class="input-stasis band-color flex-fill">').append(
                        $('<option value="0">').text('Select color...'),
                        $.map(colors, function (c) {
                            return $('<option>').val(c.colorId).text(c.colorDesc).prop('selected', band.colorId === c.colorId);
                        })
                    ),
                    $('<input type="number" class="input-stasis band-min" style="max-width:110px;" placeholder="Min" autocomplete="off">').val(band.minValue != null ? band.minValue : ''),
                    $('<input type="number" class="input-stasis band-max" style="max-width:110px;" placeholder="Max" autocomplete="off">').val(band.maxValue != null ? band.maxValue : ''),
                    $('<button type="button" class="btn-stasis-secondary remove-band-btn" title="Remove"><i class="fas fa-xmark"></i></button>')
                );
            }

            /* =================================================================
               SECTION 3 — FORM PAYLOAD BUILDERS
               ================================================================= */
            function getHeaderPayload($form) {
                var payload = RiskPulse.serializeForm($form, {
                    numbers: ['kriHeaderId']
                });
                var isGroup = $('#kriLinkType').val() === 'group';
                payload.groupId = isGroup ? (+$('#kriGroupId').val() || null) : null;
                payload.unitId = !isGroup ? (+$('#kriUnitId').val() || null) : null;
                return payload;
            }

            function getKriPayload() {
                return {
                    kriId: +$('#editorKriId').val() || 0,
                    kriHeaderId: currentKriId,
                    kriDesc: $.trim($('#editorKriDesc').val()),
                    allowComment: true,
                    kriThresholdGroupId: +$('#editorGroupId').val() || 0
                };
            }

            function getColorPayload($form) {
                var payload = RiskPulse.serializeForm($form, {
                    numbers: ['colorId']
                });
                return payload;
            }

            function getGroupPayload($form) {
                var payload = RiskPulse.serializeForm($form, {
                    numbers: ['kriThresholdGroupId']
                });
                return payload;
            }

            function getBandsPayload() {
                var bands = [];
                $('#bandRows .band-row').each(function () {
                    var $row = $(this);
                    var colorId = +$row.find('.band-color').val() || 0;
                    if (!colorId) return;
                    bands.push({
                        colorId: colorId,
                        minValue: +$row.find('.band-min').val() || 0,
                        maxValue: +$row.find('.band-max').val() || 0
                    });
                });
                return { kriThresholdGroupId: currentGroupId, bands: bands };
            }

            /* =================================================================
               SECTION 4 — VALIDATION
               ================================================================= */
            function validateHeaderPayload(payload) {
                if (!$.trim(payload.kriHeaderDesc)) { RiskPulse.toastError('Template description is required.'); return false; }
                if (!payload.groupId && !payload.unitId) { RiskPulse.toastError('Please select a unit group or a unit.'); return false; }
                if (payload.groupId && payload.unitId) { RiskPulse.toastError('Please select either a unit group or a unit, not both.'); return false; }
                if (!payload.kriStatus) { RiskPulse.toastError('Please select a status.'); return false; }
                return true;
            }

            function validateKriPayload(payload) {
                if (!payload.kriDesc) { RiskPulse.toastError('KRI description is required.'); return false; }
                if (!payload.kriThresholdGroupId) { RiskPulse.toastError('Please select a threshold group.'); return false; }
                return true;
            }

            function validateColorPayload(payload) {
                if (!$.trim(payload.colorDesc)) { RiskPulse.toastError('Color description is required.'); return false; }
                if (!/^#([0-9A-Fa-f]{6})$/.test($.trim(payload.hexCode))) { RiskPulse.toastError('Hex code must be in #RRGGBB format.'); return false; }
                var hex = $.trim(payload.hexCode).toUpperCase();
                var duplicate = colorTable.rows().data().toArray().filter(function (row) {
                    return row.colorId !== payload.colorId && (row.hexCode || '').toUpperCase() === hex;
                });
                if (duplicate.length) { RiskPulse.toastError("Color with hex code '" + hex + "' already exists."); return false; }
                return true;
            }

            function validateGroupPayload(payload) {
                if (!$.trim(payload.kriThresholdGroupDesc)) { RiskPulse.toastError('Group description is required.'); return false; }
                return true;
            }

            function validateBandsPayload(payload) {
                if (!payload.bands.length) { RiskPulse.toastError('At least one band is required.'); return false; }
                for (var i = 0; i < payload.bands.length; i++) {
                    var b = payload.bands[i];
                    if (b.minValue > b.maxValue) { RiskPulse.toastError('Minimum value cannot be greater than maximum value.'); return false; }
                }
                return true;
            }

            /* =================================================================
               SECTION 5 — CONTROLLER CALLS (AJAX)
               ================================================================= */
            function submitHeader(payload, $form) {
                RiskPulse.postJson(saveUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        kriTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'Template saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save template.');
                    }
                });
            }

            function deleteHeader(kriHeaderId, desc) {
                RiskPulse.confirmDelete(
                    'Delete template?',
                    'This will permanently delete "' + desc + '" and all of its KRIs.',
                    function () {
                        RiskPulse.postJson(deleteUrl, { id: kriHeaderId }, {
                            success: function (res) {
                                kriTable.ajax.reload(null, false);
                                RiskPulse.toastSuccess(res.message || 'Template deleted successfully.');
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to delete template.');
                            }
                        });
                    }
                );
            }

            function loadKris() {
                RiskPulse.getJson(krisGridUrl, { kriHeaderId: currentKriId }, {
                    success: function (res) {
                        renderKriList(res.data);
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to load KRIs.');
                    }
                });
            }

            function submitKri(payload) {
                RiskPulse.postJson(saveKriUrl, payload, {
                    success: function (res) {
                        hideEditor();
                        loadKris();
                        RiskPulse.toastSuccess(res.message || 'KRI saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save KRI.');
                    }
                });
            }

            function deleteKri(kri) {
                RiskPulse.confirmDelete(
                    'Delete KRI?',
                    'This will permanently delete "' + kri.kriDesc + '".',
                    function () {
                        RiskPulse.postJson(deleteKriUrl, { id: kri.kriId }, {
                            success: function (res) {
                                if (selectedKriId === kri.kriId) hideEditor();
                                loadKris();
                                RiskPulse.toastSuccess(res.message || 'KRI deleted successfully.');
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to delete KRI.');
                            }
                        });
                    }
                );
            }

            function submitColor(payload, $form) {
                RiskPulse.postJson(saveColorUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        colorTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'Color saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save color.');
                    }
                });
            }

            function deleteColor(colorId, desc) {
                RiskPulse.confirmDelete(
                    'Delete color?',
                    'This will permanently delete "' + desc + '".',
                    function () {
                        RiskPulse.postJson(deleteColorUrl, { id: colorId }, {
                            success: function (res) {
                                colorTable.ajax.reload(null, false);
                                RiskPulse.toastSuccess(res.message || 'Color deleted successfully.');
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to delete color.');
                            }
                        });
                    }
                );
            }

            function submitGroup(payload, $form) {
                RiskPulse.postJson(saveGroupUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        groupTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'Group saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save group.');
                    }
                });
            }

            function deleteGroup(groupId, desc) {
                RiskPulse.confirmDelete(
                    'Delete group?',
                    'This will permanently delete "' + desc + '" and its bands.',
                    function () {
                        RiskPulse.postJson(deleteGroupUrl, { id: groupId }, {
                            success: function (res) {
                                groupTable.ajax.reload(null, false);
                                RiskPulse.toastSuccess(res.message || 'Group deleted successfully.');
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to delete group.');
                            }
                        });
                    }
                );
            }

            function loadBands() {
                RiskPulse.getJson(bandsGridUrl, { kriThresholdGroupId: currentGroupId }, {
                    success: function (res) {
                        $('#bandRows').empty();
                        var bands = (res.data && res.data.length) ? res.data : [{}];
                        $.each(bands, function (i, b) { $('#bandRows').append(bandRowHtml(b)); });
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to load bands.');
                    }
                });
            }

            function submitBands() {
                var payload = getBandsPayload();
                if (!validateBandsPayload(payload)) return;
                RiskPulse.postJson(saveBandsUrl, payload, {
                    success: function (res) {
                        groupTable.ajax.reload(null, false);
                        loadBands();
                        RiskPulse.toastSuccess(res.message || 'Bands saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save bands.');
                    }
                });
            }

            /* =================================================================
               SECTION 6 — DATA GRIDS (DataTables)
               ================================================================= */
            var kriTable = RiskPulse.initGrid($('#kriTable'), {
                ajax: { url: gridUrl },
                columns: [
                    { data: 'kriHeaderId' },
                    { data: 'kriHeaderDesc' },
                    { data: 'groupDesc', render: function (d, type, row) { return '<span class="status-pill">' + (d || row.unitDesc || '') + '</span>'; } },
                    { data: 'kriStatus', render: function (d) { return statusPill(d); } },
                    { data: 'kriCount', render: function (d) { return '<span class="status-pill">' + (d || 0) + '</span>'; } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function (data, type, row) {
                        var locked = row.kriStatus === 'Locked';
                        return [
                            '<button type="button" class="btn-stasis-secondary design-kri-btn"><i class="fas fa-pen-ruler"></i> Design</button>',
                            locked
                                ? '<button type="button" class="btn-stasis-secondary" disabled title="Locked templates cannot be edited"><i class="fas fa-pen-to-square"></i> Edit</button>'
                                : '<button type="button" class="btn-stasis-secondary edit-kri-btn"><i class="fas fa-pen-to-square"></i> Edit</button>',
                            locked
                                ? '<button type="button" class="btn-stasis-secondary" disabled title="Locked templates cannot be deleted"><i class="fas fa-trash-can"></i> Delete</button>'
                                : '<button type="button" class="btn-stasis-secondary delete-kri-btn"><i class="fas fa-trash-can"></i> Delete</button>'
                        ].join(' ');
                    } }
                ],
                order: [[0, 'asc']]
            });

            var colorTable = RiskPulse.initGrid($('#colorTable'), {
                ajax: { url: colorsGridUrl },
                columns: [
                    { data: 'colorId' },
                    { data: 'colorDesc' },
                    { data: 'hexCode', render: function (d, type, row) {
                        return $('<span class="d-inline-flex align-items-center gap-2">')
                            .append(swatch(d))
                            .append($('<span>').text(d)).prop('outerHTML');
                    } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function (data, type, row) {
                        return '<button type="button" class="btn-stasis-secondary edit-color-btn"><i class="fas fa-pen-to-square"></i> Edit</button> ' +
                               '<button type="button" class="btn-stasis-secondary delete-color-btn"><i class="fas fa-trash-can"></i> Delete</button>';
                    } }
                ],
                order: [[0, 'asc']]
            });

            var groupTable = RiskPulse.initGrid($('#groupTable'), {
                ajax: { url: groupsGridUrl },
                columns: [
                    { data: 'kriThresholdGroupId' },
                    { data: 'kriThresholdGroupDesc' },
                    { data: 'bandCount', render: function (d) { return '<span class="status-pill">' + (d || 0) + '</span>'; } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function (data, type, row) {
                        return '<button type="button" class="btn-stasis-secondary bands-btn"><i class="fas fa-layer-group"></i> Bands</button> ' +
                               '<button type="button" class="btn-stasis-secondary edit-group-btn"><i class="fas fa-pen-to-square"></i> Edit</button> ' +
                               '<button type="button" class="btn-stasis-secondary delete-group-btn"><i class="fas fa-trash-can"></i> Delete</button>';
                    } }
                ],
                order: [[0, 'asc']]
            });

            /* =================================================================
               SECTION 7 — EVENT WIRING & INIT
               ================================================================= */
            RiskPulse.populateSelect($('#kriStatus'), statuses);
            RiskPulse.populateSelect($('#editorGroupId'), groups);

            function toggleKriLinkType() {
                var isGroup = $('#kriLinkType').val() === 'group';
                $('#kriGroupRow').toggleClass('d-none', !isGroup);
                $('#kriUnitRow').toggleClass('d-none', isGroup);
                if (isGroup) { $('#kriUnitId').val(0).trigger('change'); }
                else { $('#kriGroupId').val(0).trigger('change'); }
            }

            $('#kriGroupId').empty().append('<option value="0">Select a unit group...</option>');
            RiskPulse.populateSelect($('#kriGroupId'), unitGroups);

            $('#kriUnitId').empty().append('<option value="0">Select a unit...</option>');
            RiskPulse.populateSelect($('#kriUnitId'), units);

            $('#kriLinkType').on('change', toggleKriLinkType);

            // Tabs — recalc DataTables widths once a pane becomes visible
            $('#kriTabs button[data-bs-toggle="tab"]').on('shown.bs.tab', function () {
                $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
            });

            $('#kriModal').on('shown.bs.modal', function () {
                if ($('#kriHeaderId').val() == 0) {
                    $('#kriHeaderDesc').val('').trigger('focus');
                    $('#kriLinkType').val('group').trigger('change');
                    $('#kriGroupId').val(0).trigger('change');
                    $('#kriUnitId').val(0).trigger('change');
                    $('#kriStatus').val('Active').trigger('change');
                }
            });

            $('#kriTable tbody').on('click', '.edit-kri-btn', function () {
                var row = kriTable.row($(this).closest('tr')).data();
                $('#kriHeaderId').val(row.kriHeaderId);
                $('#kriHeaderDesc').val(row.kriHeaderDesc);
                if (row.groupId) {
                    $('#kriLinkType').val('group').trigger('change');
                    $('#kriGroupId').val(row.groupId).trigger('change');
                    $('#kriUnitId').val(0).trigger('change');
                } else {
                    $('#kriLinkType').val('unit').trigger('change');
                    $('#kriUnitId').val(row.unitId).trigger('change');
                    $('#kriGroupId').val(0).trigger('change');
                }
                $('#kriStatus').val(row.kriStatus).trigger('change');
                $('#kriModalLabel').text('Edit Template');
                RiskPulse.showModal('kriModal');
            });

            $('#kriTable tbody').on('click', '.delete-kri-btn', function () {
                var row = kriTable.row($(this).closest('tr')).data();
                deleteHeader(row.kriHeaderId, row.kriHeaderDesc);
            });

            $('#kriModal').on('hidden.bs.modal', function () {
                $('#kriHeaderId').val(0);
                $('#kriLinkType').val('group').trigger('change');
                $('#kriGroupId').val(0).trigger('change');
                $('#kriUnitId').val(0).trigger('change');
                $('#kriModalLabel').text('Add Template');
            });

            $('#kriForm').on('submit', function (e) {
                e.preventDefault();
                var payload = getHeaderPayload($(this));
                if (validateHeaderPayload(payload)) submitHeader(payload, $(this));
            });

            // Open Design modal
            $('#kriTable tbody').on('click', '.design-kri-btn', function () {
                var row = kriTable.row($(this).closest('tr')).data();
                currentKriId = row.kriHeaderId;
                currentKriLocked = row.kriStatus === 'Locked';

                $('#designModalLabel').text('Design: ' + row.kriHeaderDesc);
                $('#designStatusPill').html(statusPill(row.kriStatus));

                if (currentKriLocked) {
                    $('#lockedNotice').show();
                    $('#addKriItemBtn').hide();
                } else {
                    $('#lockedNotice').hide();
                    $('#addKriItemBtn').show();
                }

                hideEditor();
                loadKris();
                RiskPulse.showModal('designModal');
            });

            // Reload the grid when the designer closes so KRI counts stay fresh
            $('#designModal').on('hidden.bs.modal', function () {
                kriTable.ajax.reload(null, false);
            });

            // Left panel: click KRI to edit
            $('#kriList').on('click', '.kri-item', function (e) {
                if ($(e.target).closest('.kri-delete-btn').length) return;
                if (currentKriLocked) return;
                showEditor($(this).data('kri'));
            });

            // Left panel: delete button
            $('#kriList').on('click', '.kri-delete-btn', function (e) {
                e.stopPropagation();
                deleteKri($(this).data('kri'));
            });

            // Add KRI
            $('#addKriItemBtn').on('click', function () {
                if (!currentKriLocked) showEditor(null);
            });

            // Save / Cancel KRI
            $('#saveKriItemBtn').on('click', function () {
                var payload = getKriPayload();
                if (validateKriPayload(payload)) submitKri(payload);
            });

            $('#cancelKriItemBtn').on('click', function () {
                hideEditor();
            });

            // Color form
            $('#colorModal').on('shown.bs.modal', function () {
                $('#colorDesc').trigger('focus');
            });

            $('#hexCode').on('input', function () {
                var hex = $.trim($(this).val());
                $('#colorSwatch').css('background', /^#[0-9A-Fa-f]{6}$/.test(hex) ? hex : 'transparent');
            });

            $('#colorTable tbody').on('click', '.edit-color-btn', function () {
                var row = colorTable.row($(this).closest('tr')).data();
                $('#colorId').val(row.colorId);
                $('#colorDesc').val(row.colorDesc);
                $('#hexCode').val(row.hexCode).trigger('input');
                $('#colorModalLabel').text('Edit Color');
                RiskPulse.showModal('colorModal');
            });

            $('#colorTable tbody').on('click', '.delete-color-btn', function () {
                var row = colorTable.row($(this).closest('tr')).data();
                deleteColor(row.colorId, row.colorDesc);
            });

            $('#colorModal').on('hidden.bs.modal', function () {
                $('#colorId').val(0);
                $('#colorDesc').val('');
                $('#hexCode').val('');
                $('#colorModalLabel').text('Add Color');
                $('#colorSwatch').css('background', 'transparent');
            });

            $('#colorForm').on('submit', function (e) {
                e.preventDefault();
                var payload = getColorPayload($(this));
                if (validateColorPayload(payload)) submitColor(payload, $(this));
            });

            // Group form
            $('#groupTable tbody').on('click', '.edit-group-btn', function () {
                var row = groupTable.row($(this).closest('tr')).data();
                $('#groupModalId').val(row.kriThresholdGroupId);
                $('#groupDesc').val(row.kriThresholdGroupDesc);
                $('#groupModalLabel').text('Edit Group');
                RiskPulse.showModal('groupModal');
            });

            $('#groupTable tbody').on('click', '.delete-group-btn', function () {
                var row = groupTable.row($(this).closest('tr')).data();
                deleteGroup(row.kriThresholdGroupId, row.kriThresholdGroupDesc);
            });

            $('#groupModal').on('hidden.bs.modal', function () {
                $('#groupModalId').val(0);
                $('#groupDesc').val('');
                $('#groupModalLabel').text('Add Group');
            });

            $('#groupForm').on('submit', function (e) {
                e.preventDefault();
                var payload = getGroupPayload($(this));
                if (validateGroupPayload(payload)) submitGroup(payload, $(this));
            });

            // Bands
            $('#groupTable tbody').on('click', '.bands-btn', function () {
                var row = groupTable.row($(this).closest('tr')).data();
                currentGroupId = row.kriThresholdGroupId;
                $('#bandsModalLabel').text('Threshold Bands');
                $('#bandsGroupLabel').text(row.kriThresholdGroupDesc);
                RiskPulse.getJson(colorsGridUrl, {}, {
                    success: function (res) {
                        colors = (res.data || []).map(function (c) {
                            return { colorId: c.colorId, colorDesc: c.colorDesc };
                        });
                        loadBands();
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to load colors.');
                    }
                });
                RiskPulse.showModal('bandsModal');
            });

            $('#addBandBtn').on('click', function () {
                $('#bandRows').append(bandRowHtml(null));
            });

            $('#bandRows').on('click', '.remove-band-btn', function () {
                $(this).closest('.band-row').remove();
            });

            $('#saveBandsBtn').on('click', function () {
                submitBands();
            });
        })(jQuery);
    </script>
}
