@model RiskPulse.Models.ViewModel.KriTemplatesIndexViewModel
@{
    ViewData["Title"] = "KRI Templates";

    var unitGroupsJson = Json.Serialize(Model.UnitGroups);
    var unitsJson = Json.Serialize(Model.Units);
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<header class="rp-hero rp-hero--violet">
    <h1 class="rp-display-lg">KRI Templates</h1>
    <p class="rp-hero-sub">
        Manage Key Risk Indicator templates — define indicators and their Green / Amber / Red thresholds.
    </p>
    <div class="rp-hero-actions">
        <button type="button" class="rp-btn rp-btn-primary" id="addKriTemplateBtn">
            <i class="fas fa-plus"></i> Add Template
        </button>
    </div>
</header>

<div class="rp-card p-2">
    <div class="table-responsive">
    <table id="kriTable" class="table rp-table table-sm w-100 align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Code</th>
                <th>Assigned To</th>
                <th>Status</th>
                <th>KRIs</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
    </table>
    </div>
</div>

<!-- ============================================================
     TEMPLATE MODAL — Header Fields + Split-Pane KRI Builder
     ============================================================ -->
<div class="modal fade" id="kriTemplateModal" tabindex="-1" aria-labelledby="kriTemplateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <form id="kriTemplateForm" novalidate>
                <input type="hidden" id="kriHeaderId" name="kriHeaderId" value="0" />
                <div class="modal-header py-2">
                    <div>
                        <h5 class="modal-title" id="kriTemplateModalLabel">Add KRI Template</h5>
                        <div id="kriTemplateStatusPill" class="mt-1"></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <!-- HEADER FIELDS -->
                    <div class="p-3 border-bottom" id="kriHeaderFields">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="rp-label" for="kriLinkType">Link Type</label>
                                <select id="kriLinkType" class="rp-input">
                                    <option value="group">Unit Group</option>
                                    <option value="unit">Unit</option>
                                </select>
                            </div>
                            <div class="col-md-4" id="kriGroupRow">
                                <label class="rp-label" for="kriGroup">Unit Group</label>
                                <select id="kriGroup" name="groupId" class="rp-input"></select>
                            </div>
                            <div class="col-md-4 d-none" id="kriUnitRow">
                                <label class="rp-label" for="kriUnit">Unit</label>
                                <select id="kriUnit" name="unitId" class="rp-input"></select>
                            </div>
                            <div class="col-md-4 d-none" id="kriCodeCol">
                                <label class="rp-label" for="kriCode">Code</label>
                                <input type="text" id="kriCode" name="kriCode" class="rp-input" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="rp-label" for="kriActive">Status</label>
                                <div class="form-check d-flex align-items-center gap-2" style="min-height: 36px;">
                                    <input class="form-check-input m-0" type="checkbox" id="kriActive" />
                                    <label class="form-check-label" for="kriActive">Active</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="rp-label" for="kriDesc">Description <span class="text-muted fw-normal">(optional)</span></label>
                                <input type="text" id="kriDesc" name="kriHeaderDesc" class="rp-input" autocomplete="off" />
                            </div>
                        </div>
                    </div>
                    <!-- SPLIT-PANE DESIGNER -->
                    <div class="rp-design-split">
                        <!-- LEFT PANEL: KRI List -->
                        <div class="rp-design-left">
                            <div class="p-2 border-bottom d-flex justify-content-between align-items-center">
                                <span class="rp-label-md rp-text-muted">Indicators (<span id="kriCount">0</span>)</span>
                                <button type="button" class="rp-btn rp-btn-primary" id="addKriBtn">
                                    <i class="fas fa-plus"></i> Add
                                </button>
                            </div>
                            <div class="rp-design-left-list" id="kriList"></div>
                        </div>
                        <!-- RIGHT PANEL: Editor -->
                        <div class="rp-design-right">
                            <div id="editorEmptyState" class="rp-empty-state">
                                <i class="fas fa-chart-line fa-2x mb-3 rp-empty-state-icon"></i>
                                <p class="rp-body-md mb-0">Select an indicator on the left, or click <strong>Add</strong> to create one.</p>
                            </div>
                            <div id="kriEditor" class="p-3 d-none">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0" id="editorTitle">New Indicator</h6>
                                    <input type="hidden" id="editorKriId" value="0" />
                                </div>
                                <div class="mb-2">
                                    <label class="rp-label" for="editorKriDesc">Indicator Description</label>
                                    <textarea id="editorKriDesc" class="rp-input w-100" rows="2" autocomplete="off" placeholder="e.g. Number of cash shortage incidents per week"></textarea>
                                </div>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="editorAllowComment" checked />
                                    <label class="form-check-label rp-body-md" for="editorAllowComment">Allow comments for this indicator</label>
                                </div>
                                <label class="rp-label mb-2">Thresholds (Green / Amber / Red)</label>
                                <div class="row g-2 mb-2">
                                    <div class="col-4">
                                        <label class="rp-label rp-body-sm" for="editorGreenLimit">Green ≤</label>
                                        <input type="number" min="0" step="1" id="editorGreenLimit" class="rp-input" />
                                    </div>
                                    <div class="col-4">
                                        <label class="rp-label rp-body-sm" for="editorAmberLimit">Amber ≤</label>
                                        <input type="number" min="0" step="1" id="editorAmberLimit" class="rp-input" />
                                    </div>
                                    <div class="col-4">
                                        <label class="rp-label rp-body-sm" for="editorRedLimit">Red &gt;</label>
                                        <input type="number" min="0" step="1" id="editorRedLimit" class="rp-input" />
                                    </div>
                                </div>
                                <div class="mt-3 d-flex gap-2">
                                    <button type="button" class="rp-btn rp-btn-primary" id="saveKriBtn">
                                        <i class="fas fa-check"></i> Save Indicator
                                    </button>
                                    <button type="button" class="rp-btn rp-btn-secondary" id="cancelKriBtn">Cancel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <span class="rp-locked-note text-muted rp-body-sm me-auto" id="lockedNotice">
                        <i class="fas fa-lock me-1"></i> This template is locked and cannot be modified.
                    </span>
                    <button type="button" class="rp-btn rp-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="rp-btn rp-btn-primary" id="saveKriTemplateBtn">
                        <i class="fas fa-check"></i> Save Template
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var unitGroups = @Html.Raw(unitGroupsJson);
            var units = @Html.Raw(unitsJson);
            var gridUrl = '@Url.Action("Grid", "KriTemplates")';
            var saveFullUrl = '@Url.Action("SaveFull", "KriTemplates")';
            var deleteUrl = '@Url.Action("Delete", "KriTemplates")';
            var krisGridUrl = '@Url.Action("KrisGrid", "KriTemplates")';

            var currentKriId = 0;
            var currentKriLocked = false;
            var loadedKris = [];
            var selectedKriId = null;
            var nextTempKriId = 0;

            /* =================================================================
               SECTION 2 — UI RENDERERS
               ================================================================= */
            function limitPills(kri) {
                return [
                    '<span class="rp-pill rp-pill-success">G ≤ ' + kri.greenLimit + '</span>',
                    '<span class="rp-pill rp-pill-warning">A ≤ ' + kri.amberLimit + '</span>',
                    '<span class="rp-pill rp-pill-danger">R > ' + kri.redLimit + '</span>'
                ].join(' ');
            }

            function renderKriList(kris) {
                loadedKris = kris || [];
                var $container = $('#kriList').empty();
                $('#kriCount').text(loadedKris.length);

                if (!loadedKris.length) {
                    $container.append('<div class="text-center text-muted rp-body-sm py-4">No indicators yet.</div>');
                    return;
                }

                $.each(loadedKris, function (i, k) {
                    var $item = $('<div class="rp-design-item rp-card p-2 mb-1" tabindex="0">').data('kri', k);
                    if (k.kriId === selectedKriId) $item.addClass('selected');

                    var $top = $('<div class="d-flex justify-content-between align-items-center gap-1">');
                    var $label = $('<div class="rp-body-md fw-semibold rp-truncate">');
                    $label.append($('<span class="text-muted me-1">').text('K' + (i + 1) + '.'));
                    $label.append($('<span>').text(k.kriDesc));
                    $top.append($label);

                    if (!currentKriLocked) {
                        $top.append(
                            $('<button type="button" class="rp-btn rp-btn-delete rp-design-item-delete" title="Delete">')
                                .append('<i class="fas fa-trash-can"></i>')
                                .data('kri', k)
                        );
                    }
                    $item.append($top);

                    $item.append(
                        $('<div class="rp-body-sm text-muted mt-1 d-flex flex-wrap gap-1">').append(limitPills(k))
                    );

                    $container.append($item);
                });
            }

            function showEditor(kri) {
                selectedKriId = kri ? kri.kriId : null;
                $('#editorKriId').val(kri ? kri.kriId : 0);
                $('#editorKriDesc').val(kri ? kri.kriDesc : '');
                $('#editorAllowComment').prop('checked', kri ? kri.allowComment : true);
                $('#editorGreenLimit').val(kri ? kri.greenLimit : 0);
                $('#editorAmberLimit').val(kri ? kri.amberLimit : 0);
                $('#editorRedLimit').val(kri ? kri.redLimit : 0);
                var num = kri ? (loadedKris.indexOf(kri) + 1) : 0;
                $('#editorTitle').text(kri ? 'Edit Indicator #' + num : 'New Indicator');

                $('#editorEmptyState').addClass('d-none');
                $('#kriEditor').removeClass('d-none');
                highlightSelected();
                $('#editorKriDesc').trigger('focus');
            }

            function hideEditor() {
                selectedKriId = null;
                $('#kriEditor').addClass('d-none');
                $('#editorEmptyState').removeClass('d-none');
                highlightSelected();
            }

            function highlightSelected() {
                $('#kriList .rp-design-item').removeClass('selected');
                if (selectedKriId !== null) {
                    $('#kriList .rp-design-item').each(function () {
                        if ($(this).data('kri').kriId === selectedKriId) {
                            $(this).addClass('selected');
                        }
                    });
                }
            }

            function setLockedMode(locked) {
                currentKriLocked = locked;
                $('#lockedNotice').toggle(locked);
                $('#addKriBtn').toggle(!locked);
                $('#saveKriTemplateBtn').prop('disabled', locked);
                $('#kriHeaderFields :input').prop('disabled', locked);
                $('#kriEditor :input').prop('disabled', locked);
            }

            /* =================================================================
               SECTION 3 — FORM PAYLOAD BUILDERS
               ================================================================= */
            function getHeaderPayload($form) {
                var payload = RiskPulse.serializeForm($form, {
                    numbers: ['kriHeaderId']
                });
                var isGroup = $('#kriLinkType').val() === 'group';
                payload.groupId = isGroup ? (+$('#kriGroup').val() || null) : null;
                payload.unitId = !isGroup ? (+$('#kriUnit').val() || null) : null;
                payload.kriStatus = $('#kriActive').is(':checked') ? 'Active' : 'Inactive';
                return payload;
            }

            function getKriPayload() {
                var payload = {};
                payload.kriId = +$('#editorKriId').val() || 0;
                payload.kriDesc = $.trim($('#editorKriDesc').val());
                payload.allowComment = $('#editorAllowComment').is(':checked');
                payload.greenLimit = +$('#editorGreenLimit').val() || 0;
                payload.amberLimit = +$('#editorAmberLimit').val() || 0;
                payload.redLimit = +$('#editorRedLimit').val() || 0;
                return payload;
            }

            function getFullPayload($form) {
                return {
                    header: getHeaderPayload($form),
                    kris: $.map(loadedKris, function (k) {
                        return {
                            kriId: k.kriId < 0 ? 0 : k.kriId,
                            kriDesc: k.kriDesc,
                            allowComment: k.allowComment,
                            greenLimit: k.greenLimit,
                            amberLimit: k.amberLimit,
                            redLimit: k.redLimit
                        };
                    })
                };
            }

            /* =================================================================
               SECTION 4 — VALIDATION
               ================================================================= */
            function validateHeaderPayload(payload, $form) {
                if (!payload.groupId && !payload.unitId) { return RiskPulse.validationError($form.find('[name="groupId"], [name="unitId"]'), 'Please select a unit group or a unit.'); }
                if (payload.groupId && payload.unitId) { return RiskPulse.validationError($form.find('[name="groupId"], [name="unitId"]'), 'Please select either a unit group or a unit, not both.'); }
                return true;
            }

            function validateKriPayload(payload) {
                if (!payload.kriDesc) { return RiskPulse.validationError($('#editorKriDesc'), 'Indicator description is required.'); }
                if (payload.greenLimit > payload.amberLimit) { return RiskPulse.validationError(null, 'Green limit must not exceed amber limit.'); }
                if (payload.amberLimit > payload.redLimit) { return RiskPulse.validationError(null, 'Amber limit must not exceed red limit.'); }
                return true;
            }

            function validateFullPayload(payload, $form) {
                if (!validateHeaderPayload(payload.header, $form)) return false;
                if (!payload.kris.length) { return RiskPulse.validationError(null, 'At least one KRI is required.'); }
                for (var i = 0; i < payload.kris.length; i++) {
                    var k = payload.kris[i];
                    if (!$.trim(k.kriDesc)) { return RiskPulse.validationError(null, 'Indicator description is required.'); }
                    if (k.greenLimit > k.amberLimit) { return RiskPulse.validationError(null, 'Green limit must not exceed amber limit.'); }
                    if (k.amberLimit > k.redLimit) { return RiskPulse.validationError(null, 'Amber limit must not exceed red limit.'); }
                }
                return true;
            }

            /* =================================================================
               SECTION 5 — CONTROLLER CALLS (AJAX)
               ================================================================= */
            function submitFull(payload, $form) {
                RiskPulse.postJson(saveFullUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        kriTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'Template saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save template.');
                    }
                }, $('#saveKriTemplateBtn'));
            }

            function deleteHeader(kriHeaderId, desc, code) {
                var display = desc || code;
                RiskPulse.confirmDelete(
                    'Delete template?',
                    'This will permanently delete "' + display + '" and all of its indicators.',
                    function () {
                        RiskPulse.postJson(deleteUrl, { id: kriHeaderId }, {
                            success: function (res) {
                                kriTable.ajax.reload(null, false);
                                RiskPulse.toastSuccess(res.message || 'Template deleted successfully.');
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to delete template.');
                            }
                        });
                    }
                );
            }

            function loadKris(kriHeaderId) {
                RiskPulse.getJson(krisGridUrl, { kriHeaderId: kriHeaderId }, {
                    success: function (res) {
                        renderKriList(res.data);
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to load indicators.');
                    }
                });
            }

            /* =================================================================
               SECTION 6 — DATA GRID (DataTables)
               ================================================================= */
            var kriTable = RiskPulse.initGrid($('#kriTable'), {
                ajax: { url: gridUrl },
                columns: [
                    { data: 'kriHeaderId' },
                    { data: 'kriCode' },
                    { data: 'groupDesc', render: function (d, type, row) { return RiskPulse.pill(d || row.unitDesc || ''); } },
                    { data: 'kriStatus', render: function (d) { return RiskPulse.statusPill(d); } },
                    { data: 'kriCount', render: function (d) { return RiskPulse.pill(d || 0); } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function (data, type, row) {
                        var locked = row.kriStatus === 'Locked';
                        return [
                            locked
                                ? '<button type="button" class="rp-btn rp-btn-secondary" disabled title="Locked templates cannot be edited"><i class="fas fa-pen-to-square"></i> Edit</button>'
                                : '<button type="button" class="rp-btn rp-btn-edit edit-kri-btn"><i class="fas fa-pen-to-square"></i> Edit</button>',
                            locked
                                ? '<button type="button" class="rp-btn rp-btn-secondary" disabled title="Locked templates cannot be deleted"><i class="fas fa-trash-can"></i> Delete</button>'
                                : '<button type="button" class="rp-btn rp-btn-delete delete-kri-btn"><i class="fas fa-trash-can"></i> Delete</button>'
                        ].join(' ');
                    } }
                ],
                order: [[0, 'desc']]
            });

            /* =================================================================
               SECTION 7 — EVENT WIRING & INIT
               ================================================================= */
            $('#kriGroup').empty();
            RiskPulse.populateSelect($('#kriGroup'), unitGroups, '0', 'Select a unit group...');
            $('#kriUnit').empty();
            RiskPulse.populateSelect($('#kriUnit'), units, '0', 'Select a unit...');

            function toggleKriLinkType() {
                var isGroup = $('#kriLinkType').val() === 'group';
                $('#kriGroupRow').toggleClass('d-none', !isGroup);
                $('#kriUnitRow').toggleClass('d-none', isGroup);
                if (isGroup) { $('#kriUnit').val(0).trigger('change'); }
                else { $('#kriGroup').val(0).trigger('change'); }
            }
            $('#kriLinkType').on('change', toggleKriLinkType);
            $('#kriActive').on('change', function () {
                $('#kriTemplateStatusPill').html(RiskPulse.statusPill($(this).is(':checked') ? 'Active' : 'Inactive'));
            });

            function resetHeaderFields() {
                $('#kriHeaderId').val(0);
                $('#kriCode').val('').prop('readonly', true);
                $('#kriCodeCol').addClass('d-none');
                $('#kriDesc').val('');
                $('#kriLinkType').val('group').trigger('change');
                $('#kriGroup').val(0).trigger('change');
                $('#kriUnit').val(0).trigger('change');
                $('#kriActive').prop('checked', true);
                RiskPulse.clearFieldErrors($('#kriTemplateForm'));
            }

            function openAddTemplateModal() {
                currentKriId = 0;
                selectedKriId = null;
                nextTempKriId = 0;
                setLockedMode(false);
                resetHeaderFields();
                $('#kriTemplateModalLabel').text('Add KRI Template');
                $('#kriTemplateStatusPill').html(RiskPulse.statusPill('Active'));
                hideEditor();
                renderKriList([]);
                RiskPulse.showModal('kriTemplateModal');
            }

            function openEditTemplateModal(row) {
                currentKriId = row.kriHeaderId;
                currentKriLocked = row.kriStatus === 'Locked';
                selectedKriId = null;
                nextTempKriId = 0;
                setLockedMode(currentKriLocked);

                $('#kriHeaderId').val(row.kriHeaderId);
                $('#kriCode').val(row.kriCode).prop('readonly', true);
                $('#kriCodeCol').removeClass('d-none');
                $('#kriDesc').val(row.kriHeaderDesc);
                if (row.groupId) {
                    $('#kriLinkType').val('group').trigger('change');
                    $('#kriGroup').val(row.groupId).trigger('change');
                    $('#kriUnit').val(0).trigger('change');
                } else {
                    $('#kriLinkType').val('unit').trigger('change');
                    $('#kriUnit').val(row.unitId).trigger('change');
                    $('#kriGroup').val(0).trigger('change');
                }
                $('#kriActive').prop('checked', row.kriStatus === 'Active');
                RiskPulse.clearFieldErrors($('#kriTemplateForm'));

                $('#kriTemplateModalLabel').text('Edit KRI Template');
                $('#kriTemplateStatusPill').html(RiskPulse.statusPill(row.kriStatus));
                hideEditor();
                loadKris(currentKriId);
                RiskPulse.showModal('kriTemplateModal');
            }

            $('#addKriTemplateBtn').on('click', openAddTemplateModal);

            $('#kriTable tbody').on('click', '.edit-kri-btn', function () {
                var row = kriTable.row($(this).closest('tr')).data();
                openEditTemplateModal(row);
            });

            $('#kriTable tbody').on('click', '.delete-kri-btn', function () {
                var row = kriTable.row($(this).closest('tr')).data();
                deleteHeader(row.kriHeaderId, row.kriHeaderDesc, row.kriCode);
            });

            $('#kriTemplateForm').on('submit', function (e) {
                e.preventDefault();
                if (currentKriLocked) return;
                var $form = $(this);
                var payload = getFullPayload($form);
                if (validateFullPayload(payload, $form)) submitFull(payload, $form);
            });

            // Left panel: click indicator to edit
            $('#kriList').on('click', '.rp-design-item', function (e) {
                if ($(e.target).closest('.rp-design-item-delete').length) return;
                if (currentKriLocked) return;
                showEditor($(this).data('kri'));
            });

            // Left panel: delete button (local list only — SaveFull reconciles the server)
            $('#kriList').on('click', '.rp-design-item-delete', function (e) {
                e.stopPropagation();
                var kri = $(this).data('kri');
                var index = $.inArray(kri, loadedKris);
                if (index >= 0) {
                    loadedKris.splice(index, 1);
                    if (selectedKriId === kri.kriId) hideEditor();
                    renderKriList(loadedKris);
                }
            });

            // Keyboard navigation for designer items
            $('#kriList').on('keydown', '.rp-design-item', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    if (currentKriLocked) return;
                    showEditor($(this).data('kri'));
                }
            });
            $('#kriList').on('keydown', '.rp-design-item-delete', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    e.stopPropagation();
                    var kri = $(this).data('kri');
                    var index = $.inArray(kri, loadedKris);
                    if (index >= 0) {
                        loadedKris.splice(index, 1);
                        if (selectedKriId === kri.kriId) hideEditor();
                        renderKriList(loadedKris);
                    }
                }
            });

            // Add Indicator
            $('#addKriBtn').on('click', function () {
                if (!currentKriLocked) showEditor(null);
            });

            // Commit the editor into the local list (no per-KRI POST anymore)
            $('#saveKriBtn').on('click', function () {
                var payload = getKriPayload();
                if (!validateKriPayload(payload)) return;

                var kid = payload.kriId;
                var found = false;
                $.each(loadedKris, function (i, k) {
                    if (k.kriId === kid) {
                        k.kriDesc = payload.kriDesc;
                        k.allowComment = payload.allowComment;
                        k.greenLimit = payload.greenLimit;
                        k.amberLimit = payload.amberLimit;
                        k.redLimit = payload.redLimit;
                        found = true;
                        return false;
                    }
                });
                if (!found) {
                    loadedKris.push({
                        kriId: --nextTempKriId,
                        kriDesc: payload.kriDesc,
                        allowComment: payload.allowComment,
                        greenLimit: payload.greenLimit,
                        amberLimit: payload.amberLimit,
                        redLimit: payload.redLimit
                    });
                }
                renderKriList(loadedKris);
                hideEditor();
            });

            $('#cancelKriBtn').on('click', function () {
                hideEditor();
            });
        })(jQuery);
    </script>
}