@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - RiskPulse</title>
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--background);
            padding: 24px;
            position: relative;
            overflow: hidden;
            margin: 0;
        }

        .login-bg-pattern {
            position: absolute;
            inset: 0;
            z-index: 0;
            opacity: 0.06;
            background-image:
                radial-gradient(circle at 20% 30%, var(--primary-container) 1px, transparent 1px),
                radial-gradient(circle at 80% 70%, var(--primary-container) 1px, transparent 1px),
                radial-gradient(circle at 50% 50%, var(--outline) 0.5px, transparent 0.5px);
            background-size: 60px 60px, 80px 80px, 40px 40px;
            pointer-events: none;
        }

        .login-card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 420px;
            background: var(--surface-container-lowest);
            border: 1px solid var(--outline-variant);
            border-radius: 8px;
            padding: 32px;
            box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.03);
            display: flex;
            flex-direction: column;
            gap: 32px;
        }

        .login-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 8px;
        }

        .login-header h1 {
            margin: 0;
        }

        .login-header p {
            margin: 0;
        }

        .login-icon-circle {
            width: 64px;
            height: 64px;
            background-color: var(--surface-container);
            border: 1px solid var(--outline-variant);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 8px;
        }

        .login-icon-circle i {
            font-size: 32px;
            color: var(--primary-container);
        }

        .login-form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .login-field {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .login-input-wrapper {
            position: relative;
        }

        .login-input-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--outline);
            font-size: 14px;
            pointer-events: none;
        }

        .login-input {
            padding-left: 40px;
        }

        .login-submit {
            width: 100%;
            justify-content: center;
            padding: 10px 16px;
            border: none;
            border-radius: 4px;
            margin-top: 8px;
        }

        .login-footer {
            border-top: 1px solid var(--outline-variant);
            padding-top: 16px;
            text-align: center;
        }

        .login-footer p {
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .login-submit .fa-spinner {
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="login-page">

    <!-- Subtle geometric background pattern -->
    <div class="login-bg-pattern"></div>

    <main class="login-card">

        <!-- Header & Logo -->
        <div class="login-header">
            <div class="login-icon-circle">
                <i class="fas fa-shield-halved"></i>
            </div>
            <h1 class="font-headline-md" style="color: var(--primary-container);">RiskPulse</h1>
            <p class="font-body-sm" style="color: var(--on-surface-variant);">Secure Authentication</p>
        </div>

        <!-- Form -->
        <form class="login-form" id="loginForm">

            <!-- Username -->
            <div class="login-field">
                <label class="input-label" for="username">Username</label>
                <div class="login-input-wrapper">
                    <i class="fas fa-user login-input-icon"></i>
                    <input class="input-stasis login-input"
                           type="text"
                           id="username"
                           name="username"
                           placeholder="Enter your username"
                           required />
                </div>
            </div>

            <!-- Password -->
            <div class="login-field">
                <label class="input-label" for="password">Password</label>
                <div class="login-input-wrapper">
                    <i class="fas fa-key login-input-icon"></i>
                    <input class="input-stasis login-input"
                           type="password"
                           id="password"
                           name="password"
                           placeholder="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;"
                           required />
                </div>
            </div>

            <!-- Validation Error -->
            <div id="loginError" style="display:none; background: var(--error-container); color: var(--on-error-container); padding: 8px 12px; border-radius: 4px; font-size: 12px;"></div>

            <!-- Submit -->
            <button class="btn-stasis-primary login-submit" type="submit" id="loginBtn">
                <span class="btn-text">Authenticate</span>
            </button>

        </form>

        <!-- Footer -->
        <div class="login-footer">
            <p class="font-body-sm" style="color: var(--outline);">
                <i class="fas fa-circle-info" style="font-size: 12px;"></i>
                Authorized personnel only.
            </p>
        </div>

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        function resetBtn() {
            $('#loginBtn').prop('disabled', false)
                .find('.btn-text').text('Authenticate');
        }

        $('#loginForm').on('submit', function (e) {
            e.preventDefault();
            var $error = $('#loginError');
            $error.hide();

            $('#loginBtn').prop('disabled', true)
                .find('.btn-text').html('<i class="fas fa-spinner"></i> Authenticating...');

            $.ajax({
                url: '@Url.Action("Login", "Auth")',
                type: 'POST',
                data: {
                    username: $('#username').val(),
                    password: $('#password').val()
                },
                success: function (response) {
                    if (response.success) {
                        window.location.href = response.redirectUrl;
                    } else {
                        $error.text(response.message).show();
                        resetBtn();
                    }
                },
                error: function () {
                    $error.text('An error occurred. Please try again.').show();
                    resetBtn();
                }
            });
        });
    </script>

</body>
</html>
