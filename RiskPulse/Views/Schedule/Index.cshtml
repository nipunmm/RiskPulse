@{
    ViewData["Title"] = "Schedule";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<div class="rp-page-header gap-3 mb-3">
    <div>
        <h2 class="rp-display-lg">Schedule</h2>
        <p class="rp-body-md mt-1 mb-0 rp-text-muted">
            Set up scheduled risk assessments as a guided flow — choose the schedule type and the SAQ and KRI templates, then activate.
        </p>
    </div>
</div>

<div class="rp-card p-2">
    <div class="rp-grid-toolbar">
        <p class="mb-0 rp-body-sm rp-text-muted">Create scheduled risk assessments as a guided flow.</p>
        <a href="@Url.Action("Wizard", "Schedule")" class="rp-btn rp-btn-primary d-inline-flex align-items-center gap-2">
            <i class="fas fa-plus"></i> New Schedule
        </a>
    </div>
    <table id="scheduleTable" class="table rp-table table-sm w-100 align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Code</th>
                <th>SAQ Templates</th>
                <th>KRI Templates</th>
                <th>Type</th>
                <th>Window</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var gridUrl = '@Url.Action("Grid", "Schedule")';
            var wizardUrl = '@Url.Action("Wizard", "Schedule")';
            var deleteUrl = '@Url.Action("Delete", "Schedule")';
            var wizardError = @Html.Raw(Json.Serialize(ViewData["WizardError"] ?? (object?)null));

            /* =================================================================
               SECTION 2 — DATA GRID (DataTables)
               ================================================================= */
            function renderWindow(row) {
                if (row.scheduleType === 'OneTime') {
                    var dates = ['Start:', row.startDate || '—', 'End:', row.endDate || '—'].join(' ');
                    return dates;
                }
                if (row.scheduleType === 'Recurring') {
                    var month = row.startMonth ? row.startMonth.slice(0, 7) : '—';
                    return month + ' · day ' + (row.recurringDay || '—');
                }
                return '<em class="text-muted">Not set</em>';
            }

            function renderTemplateCell(count, codes) {
                if (!count) return '<em class="text-muted">Not set</em>';
                var shown = (codes || []).slice(0, 2).map(RiskPulse.escapeHtml).join(', ');
                var overflow = count - 2;
                if (overflow > 0) shown += ' <span class="text-muted">+' + overflow + ' more</span>';
                return RiskPulse.pill(count, 'neutral') + ' ' + shown;
            }

            var scheduleTable = RiskPulse.initGrid($('#scheduleTable'), {
                ajax: { url: gridUrl },
                columns: [
                    { data: 'scheduleId' },
                    { data: 'scheduleCode' },
                    { data: 'saqCount', render: function (d, t, row) { return renderTemplateCell(d, row.saqCodes); } },
                    { data: 'kriCount', render: function (d, t, row) { return renderTemplateCell(d, row.kriCodes); } },
                    { data: 'scheduleType', render: function (d) { return d || '<em class="text-muted">Not set</em>'; } },
                    { data: null, orderable: false, searchable: false, render: function (data) { return renderWindow(data); } },
                    { data: 'scheduleStatus', render: function (d) {
                        return RiskPulse.statusPill(d);
                    } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function (data, type, row) {
                        if (row.scheduleStatus !== 'Draft') {
                            return '<span class="text-muted">—</span>';
                        }
                        return '<button type="button" class="rp-btn rp-btn-edit edit-schedule-btn"><i class="fas fa-pen-to-square"></i> Edit</button> ' +
                               '<button type="button" class="rp-btn rp-btn-delete delete-schedule-btn"><i class="fas fa-trash-can"></i> Delete</button>';
                    } }
                ],
                order: [[0, 'asc']]
            });

            /* =================================================================
               SECTION 3 — EVENT WIRING & INIT
               ================================================================= */
            $('#scheduleTable tbody').on('click', '.edit-schedule-btn', function () {
                var row = scheduleTable.row($(this).closest('tr')).data();
                window.location.href = wizardUrl + '?id=' + row.scheduleId;
            });

            $('#scheduleTable tbody').on('click', '.delete-schedule-btn', function () {
                var row = scheduleTable.row($(this).closest('tr')).data();
                RiskPulse.confirmDelete('Delete Draft Schedule?', 'This permanently deletes the draft "' + (row.scheduleCode || 'Untitled') + '".', function () {
                    RiskPulse.postJson(deleteUrl, { id: row.scheduleId }, {
                        success: function (res) {
                            scheduleTable.ajax.reload(null, false);
                            RiskPulse.toastSuccess(res.message || 'Draft schedule deleted.');
                        },
                        fail: function (res) {
                            RiskPulse.toastError(res.message || 'Unable to delete the schedule.');
                        }
                    });
                });
            });

            if (wizardError) {
                RiskPulse.toastError(wizardError);
            }
        })(jQuery);
    </script>
}