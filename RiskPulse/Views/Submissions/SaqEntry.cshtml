@model RiskPulse.Models.ViewModel.SaqEntryViewModel
@{
    ViewData["Title"] = $"{Model.AssessmentCode} \u2014 {Model.ItemTitle}";

    string PillClass(string label) => label switch
    {
        "InProgress" => "warning",
        "Submitted" => "warning",
        "Approved" => "success",
        "Authorized" => "success",
        _ => "neutral"
    };
}

<div class="rp-page-header">
    <div>
        <a href="@Url.Action("Detail", "Submissions", new { id = Model.AssessmentUnitId })" class="rp-body-sm rp-text-muted text-decoration-none">
            <i class="fas fa-arrow-left me-1"></i>Back to assessment
        </a>
        <h2 class="rp-display-lg mt-2 mb-1">@Model.ItemTitle</h2>
        <p class="rp-body-md mb-0 rp-text-muted">
            @Model.AssessmentCode &middot; @Model.UnitDesc
        </p>
    </div>
    <div class="text-end">
        <span class="rp-pill rp-pill-@PillClass(Model.StatusLabel)">@Model.StatusLabel</span>
    </div>
</div>

@if (!Model.Editable)
{
    <div class="rp-card p-3 mb-3">
        <p class="mb-0 rp-body-md rp-text-muted">
            <i class="fas fa-lock me-2"></i>
            This questionnaire has been submitted and is now read-only.
        </p>
    </div>
}

<form id="saqForm" novalidate>
    @foreach (var question in Model.Questions)
    {
        <div class="rp-card p-3 mb-2 saq-question" data-question-id="@question.QuestionId" data-question-index="@question.DisplayOrder">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <p class="rp-body-md fw-semibold mb-2">
                    <span class="rp-text-muted me-1">Q@(question.DisplayOrder).</span>@question.QuestionText
                </p>
            </div>
            <div class="d-flex flex-column gap-2">
                @foreach (var option in question.Options)
                {
                    <div class="form-check mb-0">
                        <input class="form-check-input answer-radio" type="radio"
                               name="answer-q-@question.QuestionId"
                               id="answer-q-@question.QuestionId-@option.OptionId"
                               value="@option.OptionId"
                               @(question.SelectedOptionId == option.OptionId ? "checked" : "")
                               @(Model.Editable ? "" : "disabled") />
                        <label class="form-check-label rp-body-md" for="answer-q-@question.QuestionId-@option.OptionId">@option.OptionText</label>
                    </div>
                }
            </div>
            @if (question.AllowComment)
            {
                <div class="mt-3">
                    <label class="rp-label" for="comment-q-@question.QuestionId">Comments <span class="rp-text-muted rp-body-sm">(optional)</span></label>
                    <textarea id="comment-q-@question.QuestionId" class="rp-input w-100 comment-input" rows="2"
                              placeholder="Add any clarifying notes about this answer..."
                              @(Model.Editable ? "" : "disabled")>@question.Comment</textarea>
                </div>
            }
        </div>
    }

    @if (Model.Editable)
    {
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="rp-btn rp-btn-secondary" id="saveSaqDraftBtn"><i class="fas fa-floppy-disk me-1"></i>Save Draft</button>
            <button type="button" class="rp-btn rp-btn-primary" id="submitSaqBtn"><i class="fas fa-paper-plane me-1"></i>Submit</button>
        </div>
    }
</form>

@section Scripts {
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var saveUrl = '@Url.Action("SaveSaq", "Submissions")';
            var submitUrl = '@Url.Action("SubmitItem", "Submissions")';
            var detailUrl = '@Url.Action("Detail", "Submissions")';
            var assessmentItemId = @Model.AssessmentItemId;
            var assessmentUnitId = @Model.AssessmentUnitId;
            var editable = @(Model.Editable ? "true" : "false");

            /* =================================================================
               SECTION 2 — PAYLOAD BUILDERS
               ================================================================= */
            function buildPayload() {
                var answers = [];
                $('.saq-question').each(function () {
                    var $question = $(this);
                    answers.push({
                        questionId: +$question.data('question-id'),
                        optionId: +($question.find('.answer-radio:checked').val() || 0),
                        comment: $.trim($question.find('.comment-input').val()) || null
                    });
                });
                return { assessmentItemId: assessmentItemId, answers: answers };
            }

            /* =================================================================
               SECTION 3 — VALIDATION
               ================================================================= */
            function validateForSubmit(payload) {
                var $missing = null;
                $.each(payload.answers, function () {
                    if (this.optionId) return;
                    var $question = $('.saq-question[data-question-id="' + this.questionId + '"]');
                    $missing = $question.find('.answer-radio').first();
                    RiskPulse.validationError($missing, 'Please select an answer for every question.');
                    return false;
                });
                return !$missing;
            }

            /* =================================================================
               SECTION 4 — ACTIONS
               ================================================================= */
            function saveDraft() {
                RiskPulse.postJson(saveUrl, buildPayload(), {
                    success: function (res) {
                        RiskPulse.toastSuccess(res.message || 'Draft saved.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save the draft.');
                    }
                });
            }

            function submitSaq() {
                var payload = buildPayload();
                if (!validateForSubmit(payload)) return;

                RiskPulse.postJson(submitUrl, { assessmentItemId: assessmentItemId }, {
                    success: function () {
                        RiskPulse.toastSuccess('Questionnaire submitted successfully.');
                        window.setTimeout(function () {
                            window.location = detailUrl + '?id=' + assessmentUnitId;
                        }, 900);
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to submit the questionnaire.');
                    }
                });
            }

            /* =================================================================
               SECTION 5 — EVENT WIRING
               ================================================================= */
            $('#saveSaqDraftBtn').on('click', saveDraft);
            $('#submitSaqBtn').on('click', submitSaq);

            // Clear field errors as the user interacts
            $('#saqForm').on('change', '.answer-radio, .comment-input', function () {
                RiskPulse.clearFieldErrors($('#saqForm'));
            });
        })(jQuery);
    </script>
}