@model RiskPulse.Models.ViewModel.SubmissionsIndexViewModel
@{
    ViewData["Title"] = "Submissions";

    string PillClass(string stepCode) => stepCode switch
    {
        "FinalApproved" => "success",
        "UnitApproved" or "RiskReviewed" => "info",
        "Returned" => "danger",
        "InProgress" => "warning",
        _ => "neutral"
    };
}

<header class="rp-hero rp-hero--slate">
    <h1 class="rp-display-lg">Submissions</h1>
    <p class="rp-hero-sub">
        Track the risk assessments assigned to <strong>@Model.UnitDesc</strong> and complete their questionnaires.
    </p>
</header>

<div class="row g-2">
    @foreach (var column in new[]
    {
        (Title: "Pending", Icon: "fa-hourglass-start", Accent: "neutral", Items: Model.Pending),
        (Title: "In Progress", Icon: "fa-spinner", Accent: "warning", Items: Model.InProgress),
        (Title: "Completed", Icon: "fa-circle-check", Accent: "success", Items: Model.Completed)
    })
    {
        <div class="col-12 col-xl-4">
            <div class="rp-card h-100 d-flex flex-column">
                <div class="rp-card-head">
                    <h2 class="rp-card-title"><i class="fas @column.Icon me-2"></i>@column.Title</h2>
                    <span class="rp-pill rp-pill-@column.Accent">@column.Items.Count</span>
                </div>
                <div class="rp-card-body d-flex flex-column gap-2">
                    @foreach (var item in column.Items)
                    {
                        <a href="@Url.Action("Detail", "Submissions", new { id = item.AssessmentUnitId })"
                           class="border rounded p-3 text-decoration-none text-reset d-block">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                <span class="rp-body-md fw-semibold">@item.AssessmentCode</span>
                                <span class="rp-pill rp-pill-@PillClass(item.StepCode)">@item.StatusLabel</span>
                            </div>
                            <p class="rp-body-sm rp-text-muted mb-1">
                                <i class="fas fa-building me-1"></i>@item.UnitDesc
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="rp-body-xs rp-text-muted">
                                    @(item.PeriodStart?.ToString("dd MMM yy")) &rarr; @(item.PeriodEnd?.ToString("dd MMM yy"))
                                </span>
                                <span class="rp-pill rp-pill-neutral">@item.SubmittedCount of @item.ItemCount</span>
                            </div>
                        </a>
                    }

                    @if (!column.Items.Any())
                    {
                        <div class="rp-empty-state">
                            <i class="fas @column.Icon rp-empty-state-icon"></i>
                            <p class="rp-body-sm mb-0">Nothing here.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
