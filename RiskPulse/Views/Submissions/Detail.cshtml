@model RiskPulse.Models.ViewModel.AssessmentDetailViewModel
@{
    ViewData["Title"] = "Assessment " + Model.AssessmentCode;

    string PillClass(string label) => label switch
    {
        "InProgress" => "warning",
        "Submitted" => "warning",
        "Approved" => "success",
        "Authorized" => "success",
        _ => "neutral"
    };

    string StepPill(string label) => $"<span class=\"rp-pill rp-pill-{PillClass(label)}\">{label}</span>";
    string TypePill(string type) => $"<span class=\"rp-pill rp-pill-neutral\">{type}</span>";
}

<div class="rp-page-header">
    <div>
        <a href="@Url.Action("Index")" class="rp-body-sm rp-text-muted text-decoration-none">
            <i class="fas fa-arrow-left me-1"></i>Back to Submissions
        </a>
        <h2 class="rp-display-lg mt-2 mb-1">@Model.AssessmentCode</h2>
        <p class="rp-body-md mb-0 rp-text-muted">
            @Model.UnitDesc &middot; @(Model.PeriodStart?.ToString("dd MMM yyyy")) &rarr; @(Model.PeriodEnd?.ToString("dd MMM yyyy"))
        </p>
    </div>
    <div class="text-end">
        <span id="unitStatusPill">@Html.Raw(StepPill(Model.StatusLabel))</span>
    </div>
</div>

<div class="rp-card p-3 mb-3">
    <h6 class="rp-display-md mb-2"><i class="fas fa-timeline me-2 text-primary"></i>Assessment Approval Trail</h6>
    <div class="row g-3">
        <!-- Level 2: Unit Approval -->
        <div class="col-md-4">
            <div class="border rounded p-2 h-100 bg-light">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="rp-body-sm fw-semibold">Level 2: Unit Sign-off</span>
                    @if (!string.IsNullOrEmpty(Model.UnitApprovedBy))
                    {
                        <span class="rp-pill rp-pill-success"><i class="fas fa-check"></i> Approved</span>
                    }
                    else
                    {
                        <span class="rp-pill rp-pill-neutral">Pending</span>
                    }
                </div>
                <p class="rp-body-xs text-muted mb-0">
                    @(string.IsNullOrEmpty(Model.UnitApprovedBy) ? "Awaiting unit approver sign-off" : $"By {Model.UnitApprovedBy} on {Model.UnitApprovedOn:dd MMM yyyy HH:mm}")
                </p>
            </div>
        </div>

        <!-- Level 3: Risk Dept Review -->
        <div class="col-md-4">
            <div class="border rounded p-2 h-100 bg-light">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="rp-body-sm fw-semibold">Level 3: Risk Dept Review</span>
                    @if (!string.IsNullOrEmpty(Model.RiskReviewedBy))
                    {
                        <span class="rp-pill rp-pill-success"><i class="fas fa-check"></i> Reviewed</span>
                    }
                    else
                    {
                        <span class="rp-pill rp-pill-neutral">Pending</span>
                    }
                </div>
                <p class="rp-body-xs text-muted mb-0">
                    @(string.IsNullOrEmpty(Model.RiskReviewedBy) ? "Awaiting risk department review" : $"By {Model.RiskReviewedBy} on {Model.RiskReviewedOn:dd MMM yyyy HH:mm}")
                </p>
                @if (!string.IsNullOrEmpty(Model.RiskReviewerRemarks))
                {
                    <p class="rp-body-xs text-secondary mt-1 mb-0 fst-italic">Remarks: "@Model.RiskReviewerRemarks"</p>
                }
            </div>
        </div>

        <!-- Level 4: Risk Dept Final Approval -->
        <div class="col-md-4">
            <div class="border rounded p-2 h-100 bg-light">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="rp-body-sm fw-semibold">Level 4: CRO Final Approval</span>
                    @if (!string.IsNullOrEmpty(Model.FinalApprovedBy))
                    {
                        <span class="rp-pill rp-pill-success"><i class="fas fa-lock"></i> Final Approved</span>
                    }
                    else
                    {
                        <span class="rp-pill rp-pill-neutral">Pending</span>
                    }
                </div>
                <p class="rp-body-xs text-muted mb-0">
                    @(string.IsNullOrEmpty(Model.FinalApprovedBy) ? "Awaiting CRO / Head of Risk sign-off" : $"By {Model.FinalApprovedBy} on {Model.FinalApprovedOn:dd MMM yyyy HH:mm}")
                </p>
                @if (!string.IsNullOrEmpty(Model.FinalApproverRemarks))
                {
                    <p class="rp-body-xs text-secondary mt-1 mb-0 fst-italic">Remarks: "@Model.FinalApproverRemarks"</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="rp-card p-2">
    <div class="rp-grid-toolbar">
        <p class="mb-0 rp-body-sm rp-text-muted">Items in this assessment. Fill and complete each questionnaire, then submit and approve.</p>
    </div>
    <table id="detailTable" class="table rp-table table-sm w-100 align-middle">
        <thead>
            <tr>
                <th>Type</th>
                <th>Reference</th>
                <th>Template</th>
                <th>Status</th>
                <th>Submitted / Approved</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr data-item-id="@item.AssessmentItemId" data-step-code="@item.StepCode">
                    <td>@Html.Raw(TypePill(item.ItemType))</td>
                    <td>@item.ReferenceCode</td>
                    <td>@item.ItemTitle</td>
                    <td>@Html.Raw(StepPill(item.StatusLabel))</td>
                    <td class="rp-body-sm rp-text-muted">
                        @if (item.SubmittedOn.HasValue)
                        {
                            <span>@item.SubmittedBy &middot; @item.SubmittedOn.Value.ToString("dd MMM yy")</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                        @if (item.ApprovedOn.HasValue)
                        {
                            <div class="mt-1"><i class="fas fa-check-circle text-success me-1"></i>@item.ApprovedBy &middot; @item.ApprovedOn.Value.ToString("dd MMM yy")</div>
                        }
                    </td>
                    <td class="text-end">
                        @{
                            var entryAction = item.ItemType == "Saq" ? "SaqEntry" : "KriEntry";
                            var entryUrl = Url.Action(entryAction, "Submissions", new { id = item.AssessmentItemId });
                        }
                        <a href="@entryUrl" class="rp-btn @(item.Editable ? "rp-btn-edit" : "rp-btn-secondary")">
                            <i class="fas @(item.Editable ? "fa-pen-to-square" : "fa-eye")"></i> @(item.Editable ? "Fill" : "View")
                        </a>
                        @if (item.StepCode == "Submitted" && (Model.CurrentUserRole == "Unit Approver" || Model.CurrentUserRole == "Administrator"))
                        {
                            <button type="button" class="rp-btn rp-btn-primary approve-item-btn" data-item-id="@item.AssessmentItemId">
                                <i class="fas fa-check"></i> Approve
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Items.Any())
    {
        <p class="rp-body-md rp-text-muted text-center py-4 mb-0">No items have been assigned to this assessment.</p>
    }
</div>

<!-- Workflow Level Actions -->
<div class="d-flex justify-content-end gap-2 mt-3">
    @if (Model.CanReturn)
    {
        <button type="button" id="returnUnitBtn" class="rp-btn rp-btn-secondary text-danger border-danger">
            <i class="fas fa-arrow-rotate-left me-1"></i> Return for Revision
        </button>
    }

    @if (Model.CanUnitApprove)
    {
        <button type="button" id="unitApproveBtn" class="rp-btn rp-btn-primary">
            <i class="fas fa-paper-plane me-1"></i> Sign-off & Pass to Risk Dept
        </button>
    }

    @if (Model.CanRiskReview)
    {
        <button type="button" id="riskReviewBtn" class="rp-btn rp-btn-primary">
            <i class="fas fa-check-double me-1"></i> Verify & Pass to CRO Approver
        </button>
    }

    @if (Model.CanFinalApprove)
    {
        <button type="button" id="finalApproveBtn" class="rp-btn rp-btn-primary">
            <i class="fas fa-stamp me-1"></i> Final Sign-Off (Approve)
        </button>
    }
</div>

@section Scripts {
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — ENDPOINTS
               ================================================================= */
            var approveUrl = '@Url.Action("ApproveItem", "Submissions")';
            var unitApproveUrl = '@Url.Action("UnitApprove", "Submissions")';
            var riskReviewUrl = '@Url.Action("RiskReview", "Submissions")';
            var finalApproveUrl = '@Url.Action("FinalApprove", "Submissions")';
            var returnUrl = '@Url.Action("ReturnAssessment", "Submissions")';
            var currentAssessmentUnitId = @Model.AssessmentUnitId;

            /* =================================================================
               SECTION 2 — ACTIONS
               ================================================================= */
            function approveItem(itemId) {
                RiskPulse.postJson(approveUrl, { assessmentItemId: itemId }, {
                    success: function () {
                        window.location.reload();
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to approve the item.');
                    }
                });
            }

            function promptAction(url, title, inputLabel, confirmText) {
                Swal.fire({
                    title: title,
                    input: 'textarea',
                    inputLabel: inputLabel || 'Remarks (optional)',
                    inputPlaceholder: 'Enter any comments or observations...',
                    showCancelButton: true,
                    confirmButtonText: confirmText || 'Proceed',
                    confirmButtonColor: '#008080'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        RiskPulse.postJson(url, { 
                            assessmentUnitId: currentAssessmentUnitId,
                            remarks: result.value || null
                        }, {
                            success: function () {
                                window.location.reload();
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to complete the action.');
                            }
                        });
                    }
                });
            }

            /* =================================================================
               SECTION 3 — EVENT WIRING
               ================================================================= */
            $('#detailTable').on('click', '.approve-item-btn', function () {
                approveItem(+$(this).data('item-id'));
            });

            $('#unitApproveBtn').on('click', function () {
                RiskPulse.postJson(unitApproveUrl, { assessmentUnitId: currentAssessmentUnitId }, {
                    success: function () {
                        window.location.reload();
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to authorize the assessment.');
                    }
                });
            });

            $('#riskReviewBtn').on('click', function () {
                promptAction(riskReviewUrl, 'Risk Department Review', 'Review Remarks (optional)', 'Verify & Pass to Approver');
            });

            $('#finalApproveBtn').on('click', function () {
                promptAction(finalApproveUrl, 'Final Organizational Approval', 'Final Approval Remarks (optional)', 'Final Sign-Off');
            });

            $('#returnUnitBtn').on('click', function () {
                Swal.fire({
                    title: 'Return Assessment to Unit',
                    input: 'textarea',
                    inputLabel: 'Reason for return (required)',
                    inputPlaceholder: 'Explain what needs to be revised by the branch...',
                    showCancelButton: true,
                    confirmButtonText: 'Return for Revision',
                    confirmButtonColor: '#d33',
                    inputValidator: function (value) {
                        if (!value) {
                            return 'You must provide a reason when returning an assessment.';
                        }
                    }
                }).then(function (result) {
                    if (result.isConfirmed) {
                        RiskPulse.postJson(returnUrl, { 
                            assessmentUnitId: currentAssessmentUnitId,
                            remarks: result.value
                        }, {
                            success: function () {
                                window.location.reload();
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to return the assessment.');
                            }
                        });
                    }
                });
            });
        })(jQuery);
    </script>
}