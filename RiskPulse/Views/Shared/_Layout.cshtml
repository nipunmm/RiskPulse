<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RiskIntel MIS</title>

    <!-- Icons: Font Awesome -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Stasis Enterprise Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex">

    <!-- ================================ -->
    <!-- SIDEBAR (Dark Navy)              -->
    <!-- ================================ -->
    <nav class="sidebar" aria-label="Main navigation">
        <!-- Logo -->
        <div class="sidebar-logo">
            <div class="sidebar-logo-icon">
                <i class="fas fa-shield-halved"></i>
            </div>
            <div class="sidebar-logo-text">
                <h5>Risk Pulse</h5>
                <small>Risk Managment System</small>
            </div>
        </div>

        <!-- Navigation Links -->
        <div class="sidebar-nav">
            <a asp-controller="Dashboard" asp-action="Index"
               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="fas fa-chart-line"></i>
                <span>Dashboard</span>
            </a>
            <a asp-controller="Submissions" asp-action="Index"
               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Submissions" ? "active" : "")">
                <i class="fas fa-inbox"></i>
                <span>Submissions</span>
            </a>
            <a asp-controller="AssessmentControl" asp-action="Index"
               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AssessmentControl" ? "active" : "")">
                <i class="fas fa-clipboard-check"></i>
                <span>Assessment Control</span>
            </a>
            <a asp-controller="FormBuilder" asp-action="Index"
               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FormBuilder" ? "active" : "")">
                <i class="fas fa-wpforms"></i>
                <span>Form Builder</span>
            </a>
        </div>

        <!-- Footer -->
        <div class="sidebar-footer">
            <a asp-controller="Auth" asp-action="Logout" class="nav-link">
                <i class="fas fa-right-from-bracket"></i>
                <span>Logout</span>
            </a>
        </div>
    </nav>

    <!-- ================================ -->
    <!-- MAIN CONTENT AREA                -->
    <!-- ================================ -->
    <main class="main-content">

        <!-- Top Header Bar -->
        <header class="top-header">
            <div class="d-flex align-items-center gap-3">
                <!-- Mobile Menu Toggle -->
                <button class="btn p-1 d-md-none" onclick="toggleSidebar()" aria-label="Toggle navigation">
                    <i class="fas fa-bars fa-lg" style="color: var(--on-surface-variant);"></i>
                </button>
                <h1 class="app-title">RiskIntel MIS</h1>
            </div>
            <div class="d-flex align-items-center gap-3">
                <!-- Search -->
                <div class="search-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" class="search-input" placeholder="Search entity or ID... (/)" />
                </div>
                <!-- Notifications -->
                <button class="header-icon-btn" aria-label="Notifications">
                    <i class="fas fa-bell"></i>
                </button>
                <!-- Account -->
                <button class="header-icon-btn" aria-label="Account">
                    <i class="fas fa-circle-user fa-lg"></i>
                </button>
            </div>
        </header>

        <!-- Page Canvas -->
        <div class="page-canvas">
            @RenderBody()
        </div>
    </main>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
