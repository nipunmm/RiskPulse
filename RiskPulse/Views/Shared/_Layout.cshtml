<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Risk Pulse</title>

    <!-- Icons: Font Awesome -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />

    <!-- Select2 (styled by the rp theme in site.css) -->
    <link rel="stylesheet" href="~/lib/select2/select2.min.css" />

    <!-- RiskPulse Design System (UI Style Guide) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column">

<a href="#main-content" class="rp-skip-link">Skip to content</a>

<!-- ================================ -->
<!-- TOP NAVIGATION (standard shell)  -->
<!-- ================================ -->
<nav id="rpTopnav" class="rp-topnav rp-shell-fade" aria-label="Main navigation">
        <div class="rp-topnav-inner">
            <div class="rp-brand">
                <span class="rp-brand-badge"><i class="fas fa-shield-halved"></i></span>
                <span class="rp-brand-name">Risk Pulse</span>
            </div>

            <button type="button" class="rp-nav-toggle" id="rpNavToggle"
                    aria-expanded="false" aria-controls="rpNav" aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>

            @{
                var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                var canViewUsers = User.HasClaim("Permission", PermissionCatalog.Users);
                var canViewRoles = User.HasClaim("Permission", PermissionCatalog.Roles);
                var canViewUnits = User.HasClaim("Permission", PermissionCatalog.Units);
                var canViewAdministration = canViewUsers || canViewRoles || canViewUnits;
                var isAdministrationActive = currentCtrl == "Roles" || currentCtrl == "Users" || currentCtrl == "Units";
                var canViewTemplates = User.HasClaim("Permission", PermissionCatalog.Saq)
                    || User.HasClaim("Permission", PermissionCatalog.Kri)
                    || User.HasClaim("Permission", PermissionCatalog.AssessmentTemplates)
                    || User.HasClaim("Permission", PermissionCatalog.RiskRegister);
                var isTemplatesActive = currentCtrl == "SaqTemplates" || currentCtrl == "KriTemplates"
                    || currentCtrl == "AssessmentTemplates" || currentCtrl == "RiskRegisterTemplates";
                var canViewAssessment = User.HasClaim("Permission", PermissionCatalog.Assessment);
                var isAssessmentActive = currentCtrl == "Assessment" || currentCtrl == "Monitor";
                var canViewMonitor = User.HasClaim("Permission", PermissionCatalog.Monitoring);
                var isMonitorActive = currentCtrl == "Monitor";
            }

            <div class="rp-nav" id="rpNav">
                @if (User.HasClaim("Permission", PermissionCatalog.Dashboard))
                {
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="rp-nav-link @(currentCtrl == "Dashboard" ? "active" : "")">
                        <i class="fas fa-chart-line"></i><span>Dashboard</span>
                    </a>
                }

                @if (User.HasClaim("Permission", PermissionCatalog.Submissions))
                {
                    <a asp-controller="Submissions" asp-action="Index"
                       class="rp-nav-link @(currentCtrl == "Submissions" ? "active" : "")">
                        <i class="fas fa-inbox"></i><span>Submissions</span>
                    </a>
                }

                @if (canViewAssessment || canViewMonitor)
                {
                    <div class="dropdown">
                        <button type="button" class="rp-nav-link dropdown-toggle @(isAssessmentActive ? "active" : "")"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-clipboard-check"></i><span>Assessment</span><i class="fas fa-chevron-down rp-caret"></i>
                        </button>
                        <ul class="dropdown-menu rp-nav-menu">
                            <li class="dropdown-header">Assessment</li>
                            @if (canViewAssessment)
                            {
                                <li>
                                    <a asp-controller="Assessment" asp-action="Activation"
                                       class="dropdown-item @(currentCtrl == "Assessment" ? "active" : "")">
                                        <i class="fas fa-bolt"></i><span>Assessment Activation</span>
                                    </a>
                                </li>
                            }
                            @if (canViewMonitor)
                            {
                                <li>
                                    <a asp-controller="Monitor" asp-action="Index"
                                       class="dropdown-item @(currentCtrl == "Monitor" ? "active" : "")">
                                        <i class="fas fa-magnifying-glass-chart"></i><span>Monitoring</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (canViewTemplates)
                {
                    <div class="dropdown">
                        <button type="button" class="rp-nav-link dropdown-toggle @(isTemplatesActive ? "active" : "")"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-copy"></i><span>Templates</span><i class="fas fa-chevron-down rp-caret"></i>
                        </button>
                        <ul class="dropdown-menu rp-nav-menu">
                            <li class="dropdown-header">Template management</li>
                            @if (User.HasClaim("Permission", PermissionCatalog.Saq))
                            {
                                <li>
                                    <a asp-controller="SaqTemplates" asp-action="Index"
                                       class="dropdown-item @(currentCtrl == "SaqTemplates" ? "active" : "")">
                                        <i class="fas fa-clipboard-question"></i><span>SAQ</span>
                                    </a>
                                </li>
                            }
                            @if (User.HasClaim("Permission", PermissionCatalog.Kri))
                            {
                                <li>
                                    <a asp-controller="KriTemplates" asp-action="Index"
                                       class="dropdown-item @(currentCtrl == "KriTemplates" ? "active" : "")">
                                        <i class="fas fa-gauge-high"></i><span>KRI</span>
                                    </a>
                                </li>
                            }
                            @if (User.HasClaim("Permission", PermissionCatalog.RiskRegister))
                            {
                                <li>
                                    <a asp-controller="RiskRegisterTemplates" asp-action="Index"
                                       class="dropdown-item @(currentCtrl == "RiskRegisterTemplates" ? "active" : "")">
                                        <i class="fas fa-triangle-exclamation"></i><span>Risk Register Templates</span>
                                    </a>
                                </li>
                            }
                            @if (User.HasClaim("Permission", PermissionCatalog.AssessmentTemplates))
                            {
                                <li>
                                    <a asp-controller="AssessmentTemplates" asp-action="Index"
                                       class="dropdown-item @(currentCtrl == "AssessmentTemplates" ? "active" : "")">
                                        <i class="fas fa-layer-group"></i><span>Assessment Templates</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (canViewAdministration)
                {
                    <div class="dropdown">
                        <button type="button" class="rp-nav-link dropdown-toggle @(isAdministrationActive ? "active" : "")"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-users-gear"></i><span>Administration</span><i class="fas fa-chevron-down rp-caret"></i>
                        </button>
                        <ul class="dropdown-menu rp-nav-menu">
                            <li class="dropdown-header">Access administration</li>
                            @if (canViewUsers)
                            {
                                <li>
                                    <a asp-controller="Users" asp-action="Index"
                                       class="dropdown-item @(currentCtrl == "Users" ? "active" : "")">
                                        <i class="fas fa-user-group"></i><span>Users</span>
                                    </a>
                                </li>
                            }
                            @if (canViewRoles)
                            {
                                <li>
                                    <a asp-controller="Roles" asp-action="Index"
                                       class="dropdown-item @(currentCtrl == "Roles" ? "active" : "")">
                                        <i class="fas fa-user-shield"></i><span>Roles</span>
                                    </a>
                                </li>
                            }
                            @if (canViewUnits)
                            {
                                <li>
                                    <a asp-controller="Units" asp-action="Index"
                                       class="dropdown-item @(currentCtrl == "Units" ? "active" : "")">
                                        <i class="fas fa-building"></i><span>Units</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <div class="rp-nav-right">
                <span class="rp-user-chip">
                    <i class="fas fa-circle-user"></i>
                    <span class="rp-chip-name">@User.Identity?.Name</span>
                    <span class="rp-chip-role">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")</span>
                </span>
                <a asp-controller="Login" asp-action="Logout" class="rp-nav-logout">
                    <i class="fas fa-right-from-bracket"></i><span>Log out</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- ================================ -->
    <!-- MAIN CONTENT AREA                -->
    <!-- ================================ -->
    <main id="main-content" class="rp-main" tabindex="-1">
        <div class="rp-bg-pattern"></div>
        <div class="rp-main-ambient" aria-hidden="true"></div>

        <!-- Page Canvas -->
        <div class="rp-page">
            @RenderBody()
        </div>

        <footer class="rp-footer">
            <hr />
            <p>Risk Pulse — Risk Management System</p>
        </footer>
    </main>

<!-- Re-host modals as direct children of <body> so their z-index (1055) escapes
     the .rp-page stacking context; otherwise Bootstrap's body-level backdrop
     (z-index 1050) paints over them and blocks all interaction. -->
<script>
    document.querySelectorAll('.modal').forEach(function (m) { document.body.appendChild(m); });
</script>

<!-- Scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
<script src="~/lib/select2/select2.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/modules/riskpulse.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
