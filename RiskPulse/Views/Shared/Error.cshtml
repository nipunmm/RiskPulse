@model ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = "Error";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error @Model.StatusCode - Risk Pulse</title>
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .error-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--surface-container-low);
            padding: 16px;
            margin: 0;
        }

        .error-card {
            width: 100%;
            max-width: 480px;
            background: var(--surface-container-lowest);
            border: 1px solid var(--outline-variant);
            border-radius: 8px;
            padding: 48px;
            text-align: center;
        }

        .error-icon-circle {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background-color: var(--error-container);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
        }

        .error-icon-circle i {
            font-size: 28px;
            color: var(--on-error-container);
        }

        .error-status-code {
            font-family: 'Inter', sans-serif;
            font-size: 64px;
            line-height: 1;
            font-weight: 700;
            color: var(--on-surface);
            margin-bottom: 8px;
        }

        .error-request-id {
            background-color: var(--surface-container-low);
            border-radius: 4px;
            padding: 8px 16px;
            margin-bottom: 32px;
        }

        .error-technical-details {
            text-align: left;
            margin-bottom: 24px;
        }

        .error-technical-details summary {
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            color: var(--on-surface-variant);
            margin-bottom: 8px;
        }

        .error-technical-details pre {
            background-color: var(--surface-container-low);
            border: 1px solid var(--outline-variant);
            border-radius: 4px;
            padding: 12px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: var(--on-surface-variant);
            overflow-x: auto;
            max-height: 300px;
            overflow-y: auto;
            white-space: pre-wrap;
            word-break: break-word;
        }
    </style>
</head>
<body class="error-page">

    <div class="error-card">

        <!-- Branding -->
        <div class="mb-lg">
            <img alt="Risk Pulse Logo"
                 class="mb-3"
                 style="width: 64px; height: 64px; object-fit: contain;"
                 src="~/images/logo.png" />
            <h2 class="font-headline-sm" style="color: var(--on-surface); margin: 0;">Risk Pulse</h2>
        </div>

        <!-- Error Icon -->
        <div class="error-icon-circle">
            <i class="fas fa-triangle-exclamation"></i>
        </div>

        <!-- Status Code -->
        <div class="error-status-code">@Model.StatusCode</div>

        <!-- Friendly Message -->
        <h1 class="font-headline-sm mb-2" style="color: var(--on-surface);">Error</h1>
        <p class="font-body-lg mb-lg" style="color: var(--on-surface-variant);">
            @Model.FriendlyMessage
        </p>

        <!-- Technical Details (Development only) -->
        @if (!string.IsNullOrEmpty(Model.TechnicalDetails))
        {
            <details class="error-technical-details">
                <summary>Technical Details</summary>
                <pre>@Model.TechnicalDetails</pre>
            </details>
        }

        <!-- Request ID -->
        @if (Model.ShowRequestId)
        {
            <div class="error-request-id">
                <span class="font-data-mono" style="color: var(--on-surface-variant); select-all;">
                    Request ID: @Model.RequestId
                </span>
            </div>
        }

        <!-- Return Button -->
        <a href="@Url.Action("Index", "Dashboard")"
           class="btn-stasis-primary w-100 d-inline-flex justify-content-center">
            Return to Dashboard
        </a>

    </div>

</body>
</html>
