@{
    Layout = null;
    ViewData["Title"] = "Access Denied";
    var (returnController, returnAction) = PermissionPageMapper.GetRouteForPermission(User.FindFirst("DefaultPage")?.Value);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - Risk Pulse</title>
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="rp-shell-centered">

    <div class="rp-bg-pattern"></div>

    <main class="rp-panel rp-panel-message">

        <div class="d-flex flex-column align-items-center gap-2 mb-3">
            <div class="rp-mark-brand">
                <i class="fas fa-shield-halved"></i>
            </div>
            <h2 class="rp-headline-md rp-text-primary">Risk Pulse</h2>
            <p class="rp-body-sm rp-text-muted m-0">Access Control</p>
        </div>

        <div class="rp-mark-warning mb-3">
            <i class="fas fa-lock"></i>
        </div>

        <h1 class="rp-display-lg">Access Denied</h1>
        <p class="rp-body-lg rp-text-muted">
            You don't have permission to access this page. If you believe this is a mistake, please contact your administrator.
        </p>

        <div class="rp-request-chip">
            <span class="rp-mono rp-text-muted">
                Request ID: @ViewData["RequestId"]
            </span>
        </div>

        <div class="d-flex flex-column gap-2 w-100">
            <a href="@Url.Action(returnAction, returnController)"
               class="rp-btn rp-btn-primary w-100 d-inline-flex justify-content-center">
                Return to Home
            </a>
            <a asp-controller="Login" asp-action="Logout"
               class="rp-btn rp-btn-secondary w-100 d-inline-flex justify-content-center">
                Logout
            </a>
        </div>

    </main>

</body>
</html>
