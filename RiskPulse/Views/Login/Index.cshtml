@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Risk Pulse</title>
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="rp-shell-centered rp-login-page">

    <div class="rp-bg-pattern"></div>

    <!-- DECORATIVE: breathing glow behind the panel -->
    <div class="rp-login-ambient" aria-hidden="true"></div>

    <main class="rp-panel rp-panel-login">

        <div class="rp-login-header">
            <div class="rp-login-brandmark" aria-hidden="true">
                <span class="rp-login-sonar"></span>
                <div class="rp-mark-hero">
                    <i class="fas fa-shield-halved"></i>
                </div>
            </div>
            <p class="rp-login-eyebrow">Secure Access</p>
            <h1 class="rp-headline-md rp-text-primary">Risk Pulse</h1>
            <p class="rp-body-sm rp-text-muted">Collect, assess, and monitor organizational risk data</p>
        </div>

        <form class="rp-login-form" id="loginForm" novalidate>

            <div class="rp-login-field">
                <label class="rp-label" for="username">Username</label>
                <div class="rp-login-input-wrapper">
                    <i class="fas fa-user rp-login-input-icon"></i>
                    <input class="rp-input rp-login-input"
                           type="text"
                           id="username"
                           name="username"
                           placeholder="Enter your username" />
                </div>
            </div>

            <div class="rp-login-field">
                <label class="rp-label" for="password">Password</label>
                <div class="rp-login-input-wrapper">
                    <i class="fas fa-key rp-login-input-icon"></i>
                    <input class="rp-input rp-login-input"
                           type="password"
                           id="password"
                           name="password"
                           placeholder="Enter your password" />
                </div>
            </div>

            <button class="rp-btn rp-btn-primary rp-login-submit" type="submit" id="loginBtn">
                <span class="btn-text">Authenticate</span>
            </button>

        </form>

        <div class="rp-login-footer">
            <p class="rp-body-sm rp-text-outline">
                <i class="fas fa-circle-info"></i>
                Authorized personnel only.
            </p>
        </div>

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/js/modules/riskpulse.js" asp-append-version="true"></script>
    <script>
        /* =================================================================
           SECTION 1 — VALIDATION (client-side rules)
           ================================================================= */
        function validateLoginForm() {
            var username = $.trim($('#username').val());
            if (!username) {
                return RiskPulse.validationError($('#username'), 'Username is required.');
            }

            if (!/^[a-z]+$/.test(username)) {
                return RiskPulse.validationError($('#username'), 'Username must be lowercase letters only (a-z).');
            }

            if (!$('#password').val()) {
                return RiskPulse.validationError($('#password'), 'Password is required.');
            }

            return true;
        }

        /* =================================================================
           SECTION 2 — CONTROLLER CALLS (AJAX) — uses shared transport
           ================================================================= */
        function submitLogin(username, password) {
            var $btn = $('#loginBtn');
            // Swap label only — the shared transport owns the disable/re-enable
            // lock; pre-disabling here trips its "already in flight" guard and
            // silently cancels the request.
            $btn.find('.btn-text').html('<i class="fas fa-spinner"></i> Authenticating...');

            RiskPulse.postJson('@Url.Action("Login", "Login")',
                { username: username, password: password },
                {
                    success: function (res) {
                        window.location.href = res.data.redirectUrl;
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Login failed.');
                    },
                    complete: function () {
                        $btn.prop('disabled', false).find('.btn-text').text('Authenticate');
                    }
                },
                $btn
            );
        }

        /* =================================================================
           SECTION 3 — EVENT WIRING
           ================================================================= */
        $('#loginForm').on('submit', function (e) {
            e.preventDefault();
            if (validateLoginForm()) {
                submitLogin($.trim($('#username').val()), $('#password').val());
            }
        });
    </script>

</body>
</html>
