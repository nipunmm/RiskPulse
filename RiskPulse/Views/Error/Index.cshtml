@model ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = "Error";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var (returnController, returnAction) = isAuthenticated
        ? PermissionPageMapper.GetRouteForPermission(User.FindFirst("DefaultPage")?.Value)
        : ("Login", "Index");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error @Model.RequestId - Risk Pulse</title>
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="rp-shell-centered">

    <div class="rp-bg-pattern"></div>

    <main class="rp-panel rp-panel-message">

        <div class="d-flex flex-column align-items-center gap-2 mb-3">
            <div class="rp-mark-brand">
                <i class="fas fa-shield-halved"></i>
            </div>
            <h2 class="rp-headline-md rp-text-primary">Risk Pulse</h2>
            <p class="rp-body-sm rp-text-muted m-0">System Error</p>
        </div>

        <div class="rp-mark-error mb-3">
            <i class="fas fa-triangle-exclamation"></i>
        </div>

        <h1 class="rp-display-lg">Something went wrong.</h1>
        <p class="rp-body-lg rp-text-muted">
            The system encountered an unexpected issue while processing your request. Please try again or contact support if the issue persists.
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="rp-request-chip">
                <span class="rp-mono rp-text-muted">
                    Request ID: @Model.RequestId
                </span>
            </div>
        }

        <div class="d-flex flex-column gap-2 w-100">
            <a href="@Url.Action(returnAction, returnController)"
               class="rp-btn rp-btn-primary w-100 d-inline-flex justify-content-center">
                Return to Home
            </a>
            <a asp-controller="Login" asp-action="Logout"
               class="rp-btn rp-btn-secondary w-100 d-inline-flex justify-content-center">
                Logout
            </a>
        </div>

    </main>

</body>
</html>
