@model RiskPulse.Models.ViewModel.UnitsIndexViewModel
@{
    ViewData["Title"] = "Unit Management";

    var unitsJson = Json.Serialize(Model.Units);
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<header class="rp-hero rp-hero--teal">
    <h1 class="rp-display-lg">Unit Management</h1>
    <p class="rp-hero-sub">
        Maintain the organizational units and group them for assessments and reporting.
    </p>
</header>

<!-- ============================================================
     TABS — UNITS | UNIT GROUPS
     ============================================================ -->
<div class="rp-card p-2">
    <ul class="nav nav-tabs" id="unitsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="unitsTab" data-bs-toggle="tab" data-bs-target="#unitsPane" type="button" role="tab" aria-controls="unitsPane" aria-selected="true">
                <i class="fas fa-building"></i> Units
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="groupsTab" data-bs-toggle="tab" data-bs-target="#groupsPane" type="button" role="tab" aria-controls="groupsPane" aria-selected="false">
                <i class="fas fa-layer-group"></i> Unit Groups
            </button>
        </li>
    </ul>

    <div class="tab-content pt-3">
        <!-- ============================================================
             UNITS PANE
             ============================================================ -->
        <div class="tab-pane fade show active" id="unitsPane" role="tabpanel" aria-labelledby="unitsTab">
            <div class="rp-grid-toolbar rp-grid-toolbar--end">
                <button type="button" class="rp-btn rp-btn-primary" data-bs-toggle="modal" data-bs-target="#addUnitModal">
                    <i class="fas fa-plus"></i> Add Unit
                </button>
            </div>
            <div class="table-responsive">
            <table id="unitTable" class="table rp-table table-sm w-100 align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Code</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
            </table>
            </div>
        </div>

        <!-- ============================================================
             UNIT GROUPS PANE
             ============================================================ -->
        <div class="tab-pane fade" id="groupsPane" role="tabpanel" aria-labelledby="groupsTab">
            <div class="rp-grid-toolbar rp-grid-toolbar--end">
                <button type="button" class="rp-btn rp-btn-primary" data-bs-toggle="modal" data-bs-target="#addGroupModal">
                    <i class="fas fa-plus"></i> Add Group
                </button>
            </div>
            <div class="table-responsive">
            <table id="groupTable" class="table rp-table table-sm w-100 align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Group Name</th>
                        <th>Units</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
            </table>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     ADD UNIT MODAL
     ============================================================ -->
<div class="modal fade" id="addUnitModal" tabindex="-1" aria-labelledby="addUnitModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addUnitForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="addUnitModalLabel">Add Unit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="rp-label" for="addUnitCode">Unit Code</label>
                        <input type="text" id="addUnitCode" name="unitCode" class="rp-input" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="rp-label" for="addUnitType">Type</label>
                        <select id="addUnitType" name="unitType" class="rp-input">
                            <option value="Department">Department</option>
                            <option value="Branch">Branch</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="rp-label" for="addUnitDesc">Description</label>
                        <input type="text" id="addUnitDesc" name="unitDesc" class="rp-input" required autocomplete="off" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="rp-btn rp-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="rp-btn rp-btn-primary"><i class="fas fa-check"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     EDIT UNIT MODAL
     ============================================================ -->
<div class="modal fade" id="editUnitModal" tabindex="-1" aria-labelledby="editUnitModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editUnitForm" novalidate>
                <input type="hidden" id="editUnitId" name="unitId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editUnitModalLabel">Edit Unit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="rp-label" for="editUnitCode">Unit Code</label>
                        <input type="text" id="editUnitCode" name="unitCode" class="rp-input" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="rp-label" for="editUnitType">Type</label>
                        <select id="editUnitType" name="unitType" class="rp-input">
                            <option value="Department">Department</option>
                            <option value="Branch">Branch</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="rp-label" for="editUnitDesc">Description</label>
                        <input type="text" id="editUnitDesc" name="unitDesc" class="rp-input" required autocomplete="off" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="rp-btn rp-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="rp-btn rp-btn-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     ADD GROUP MODAL
     ============================================================ -->
<div class="modal fade" id="addGroupModal" tabindex="-1" aria-labelledby="addGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="addGroupForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="addGroupModalLabel">Add Group</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="rp-label" for="addGroupDesc">Group Name</label>
                        <input type="text" id="addGroupDesc" name="groupDesc" class="rp-input" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="rp-label" for="addGroupUnitSearch">Units</label>
                        <div class="rp-unit-picker" id="addGroupUnitPicker">
                            <div class="rp-unit-picker-head">
                                <div class="rp-unit-search">
                                    <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                                    <input type="text" id="addGroupUnitSearch" class="rp-unit-search-input" placeholder="Search units…" autocomplete="off" data-unit-search />
                                </div>
                                <div class="rp-unit-picker-actions">
                                    <button type="button" class="rp-unit-mini-btn" data-unit-selectall>Select all</button>
                                    <button type="button" class="rp-unit-mini-btn" data-unit-clear>Clear</button>
                                </div>
                            </div>
                            <div class="rp-unit-list" data-unit-list aria-label="Available units"></div>
                            <p class="rp-unit-empty" data-unit-empty hidden>No units match your search.</p>
                        </div>
                        <small id="addGroupUnitCount" class="rp-unit-count d-block mt-2">0 units selected — at least 2 required</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="rp-btn rp-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="rp-btn rp-btn-primary"><i class="fas fa-check"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     EDIT GROUP MODAL
     ============================================================ -->
<div class="modal fade" id="editGroupModal" tabindex="-1" aria-labelledby="editGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editGroupForm" novalidate>
                <input type="hidden" id="editGroupId" name="groupId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editGroupModalLabel">Edit Group</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="rp-label" for="editGroupDesc">Group Name</label>
                        <input type="text" id="editGroupDesc" name="groupDesc" class="rp-input" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="rp-label" for="editGroupUnitSearch">Units</label>
                        <div class="rp-unit-picker" id="editGroupUnitPicker">
                            <div class="rp-unit-picker-head">
                                <div class="rp-unit-search">
                                    <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                                    <input type="text" id="editGroupUnitSearch" class="rp-unit-search-input" placeholder="Search units…" autocomplete="off" data-unit-search />
                                </div>
                                <div class="rp-unit-picker-actions">
                                    <button type="button" class="rp-unit-mini-btn" data-unit-selectall>Select all</button>
                                    <button type="button" class="rp-unit-mini-btn" data-unit-clear>Clear</button>
                                </div>
                            </div>
                            <div class="rp-unit-list" data-unit-list aria-label="Available units"></div>
                            <p class="rp-unit-empty" data-unit-empty hidden>No units match your search.</p>
                        </div>
                        <small id="editGroupUnitCount" class="rp-unit-count d-block mt-2">0 units selected — at least 2 required</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="rp-btn rp-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="rp-btn rp-btn-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var units = @Html.Raw(unitsJson);
            var unitGridUrl = '@Url.Action("UnitGrid", "Units")';
            var saveUnitUrl = '@Url.Action("SaveUnit", "Units")';
            var deleteUnitUrl = '@Url.Action("DeleteUnit", "Units")';
            var groupGridUrl = '@Url.Action("GroupGrid", "Units")';
            var saveGroupUrl = '@Url.Action("SaveGroup", "Units")';
            var deleteGroupUrl = '@Url.Action("DeleteGroup", "Units")';

            /* =================================================================
               SECTION 2 — FORM PAYLOAD BUILDERS
               ================================================================= */
            function getUnitPayload($form) {
                return RiskPulse.serializeForm($form, { numbers: ['unitId'] });
            }

            function getGroupPayload($form) {
                var payload = RiskPulse.serializeForm($form, { numbers: ['groupId'] });
                payload.unitIds = $form.find('.rp-unit-picker').data('picker').getIds();
                return payload;
            }

            /* =================================================================
               SECTION 3 — VALIDATION
               ================================================================= */
            function validateUnitPayload(payload, $form) {
                if (!$.trim(payload.unitCode)) { return RiskPulse.validationError($form.find('[name="unitCode"]'), 'Unit code is required.'); }
                if (!$.trim(payload.unitDesc)) { return RiskPulse.validationError($form.find('[name="unitDesc"]'), 'Unit description is required.'); }
                return true;
            }

            function validateGroupPayload(payload, $form) {
                if (!$.trim(payload.groupDesc)) { return RiskPulse.validationError($form.find('[name="groupDesc"]'), 'Group name is required.'); }
                if (!payload.unitIds || payload.unitIds.length < 2) { return RiskPulse.validationError($form.find('.rp-unit-picker'), 'Please select at least 2 units.'); }
                return true;
            }

            /* =================================================================
               SECTION 4 — CONTROLLER CALLS (AJAX)
               ================================================================= */
            function submitUnit(payload, $form) {
                RiskPulse.postJson(saveUnitUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        unitTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'Unit saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save unit.');
                    }
                });
            }

            function submitGroup(payload, $form) {
                RiskPulse.postJson(saveGroupUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        groupTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'Group saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save group.');
                    }
                });
            }

            /* =================================================================
               SECTION 5 — DATA GRIDS (DataTables)
               ================================================================= */
            var unitTable = RiskPulse.initGrid($('#unitTable'), {
                ajax: { url: unitGridUrl },
                columns: [
                    { data: 'unitId' },
                    { data: 'unitCode' },
                    { data: 'unitType', render: function (d) {
                        return RiskPulse.pill(d);
                    } },
                    { data: 'unitDesc' },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function () {
                        return '<button type="button" class="rp-btn rp-btn-edit edit-unit-btn"><i class="fas fa-pen-to-square"></i> Edit</button> ' +
                               '<button type="button" class="rp-btn rp-btn-delete delete-unit-btn"><i class="fas fa-trash-can"></i> Delete</button>';
                    } }
                ],
                order: [[0, 'asc']]
            });

            var groupTable = RiskPulse.initGrid($('#groupTable'), {
                ajax: { url: groupGridUrl },
                columns: [
                    { data: 'groupId' },
                    { data: 'groupDesc' },
                    { data: 'unitDescs', orderable: false, searchable: false, render: function (d) {
                        var badges = (d || []).map(function (desc) { return RiskPulse.pill(desc); });
                        return badges.length ? badges.join(' ') : '<span class="text-muted">None</span>';
                    } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function () {
                        return '<button type="button" class="rp-btn rp-btn-edit edit-group-btn"><i class="fas fa-pen-to-square"></i> Edit</button> ' +
                               '<button type="button" class="rp-btn rp-btn-delete delete-group-btn"><i class="fas fa-trash-can"></i> Delete</button>';
                    } }
                ],
                order: [[0, 'asc']]
            });

            // Tabs — recalc DataTables widths once a pane becomes visible
            $('#unitsTabs button[data-bs-toggle="tab"]').on('shown.bs.tab', function () {
                $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
            });

            /* =================================================================
               SECTION 6 — EVENT WIRING & INIT
               ================================================================= */
            // Reset the Add forms each time their modal opens
            $('#addUnitModal').on('shown.bs.modal', function () {
                $('#addUnitCode').val('').trigger('focus');
                $('#addUnitType').val('Department');
                $('#addUnitDesc').val('');
                RiskPulse.clearFieldErrors($('#addUnitForm'));
            });

            $('#addGroupModal').on('shown.bs.modal', function () {
                $('#addGroupDesc').val('').trigger('focus');
                $('#addGroupUnitPicker').data('picker').reset();
                RiskPulse.clearFieldErrors($('#addGroupForm'));
            });

            // Load a unit's values into the Edit modal
            $('#unitTable tbody').on('click', '.edit-unit-btn', function () {
                var row = unitTable.row($(this).closest('tr')).data();
                $('#editUnitId').val(row.unitId);
                $('#editUnitCode').val(row.unitCode);
                $('#editUnitType').val(row.unitType);
                $('#editUnitDesc').val(row.unitDesc);
                RiskPulse.clearFieldErrors($('#editUnitForm'));
                RiskPulse.showModal('editUnitModal');
            });

            // Load a group's values into the Edit modal
            $('#groupTable tbody').on('click', '.edit-group-btn', function () {
                var row = groupTable.row($(this).closest('tr')).data();
                $('#editGroupId').val(row.groupId);
                $('#editGroupDesc').val(row.groupDesc);
                $('#editGroupUnitPicker').data('picker').setIds(row.unitIds || []);
                RiskPulse.clearFieldErrors($('#editGroupForm'));
                RiskPulse.showModal('editGroupModal');
            });

            // Delete handlers
            $('#unitTable tbody').on('click', '.delete-unit-btn', function () {
                var row = unitTable.row($(this).closest('tr')).data();
                RiskPulse.confirmDelete('Delete Unit?', 'This permanently deletes unit "' + row.unitCode + '".', function () {
                    RiskPulse.postJson(deleteUnitUrl, { id: row.unitId }, {
                        success: function (res) {
                            unitTable.ajax.reload(null, false);
                            RiskPulse.toastSuccess(res.message || 'Unit deleted.');
                        },
                        fail: function (res) {
                            RiskPulse.toastError(res.message || 'Unable to delete unit.');
                        }
                    });
                });
            });

            $('#groupTable tbody').on('click', '.delete-group-btn', function () {
                var row = groupTable.row($(this).closest('tr')).data();
                RiskPulse.confirmDelete('Delete Group?', 'This permanently deletes group "' + row.groupDesc + '" and its unit assignments.', function () {
                    RiskPulse.postJson(deleteGroupUrl, { id: row.groupId }, {
                        success: function (res) {
                            groupTable.ajax.reload(null, false);
                            RiskPulse.toastSuccess(res.message || 'Group deleted.');
                        },
                        fail: function (res) {
                            RiskPulse.toastError(res.message || 'Unable to delete group.');
                        }
                    });
                });
            });

            /* =================================================================
               SECTION 7 — UNIT PICKER (group modals)
               ================================================================= */
            // Searchable checkbox list replacing the multi-select: unit type as
            // a pill, live selected count, select-all/clear, live filter.
            function unitTypeKind(type) {
                return type === 'Branch' ? 'info' : 'violet';
            }

            function createUnitPicker(pickerId, countId) {
                var $picker = $('#' + pickerId);
                var $list = $picker.find('[data-unit-list]');
                var $search = $picker.find('[data-unit-search]');
                var $empty = $picker.find('[data-unit-empty]');

                $list.html(units.map(function (u) {
                    return '<label class="rp-unit-option">' +
                        '<input type="checkbox" class="rp-unit-check" value="' + u.value + '" />' +
                        '<span class="rp-unit-option-name">' + RiskPulse.escapeHtml(u.label) + '</span>' +
                        RiskPulse.pill(u.type || 'Unit', unitTypeKind(u.type)) +
                    '</label>';
                }).join(''));

                function refresh() {
                    var n = $list.find('.rp-unit-check:checked').length;
                    var valid = n >= 2;
                    $(countId)
                        .text(n + ' unit' + (n !== 1 ? 's' : '') + ' selected' + (valid ? '' : ' — at least 2 required'))
                        .toggleClass('rp-unit-count-ok', valid)
                        .toggleClass('rp-unit-count-warn', !valid);
                    $list.find('.rp-unit-option').each(function () {
                        $(this).toggleClass('is-selected', $(this).find('.rp-unit-check').is(':checked'));
                    });
                }

                function applyFilter() {
                    var term = $.trim($search.val()).toLowerCase();
                    var shown = 0;
                    $list.find('.rp-unit-option').each(function () {
                        var match = !term || $(this).text().toLowerCase().indexOf(term) !== -1;
                        $(this).toggle(match);
                        if (match) shown++;
                    });
                    $empty.prop('hidden', shown !== 0);
                }

                $list.on('change', '.rp-unit-check', refresh);
                $search.on('input', applyFilter);
                $picker.on('click', '[data-unit-selectall]', function () {
                    $list.find('.rp-unit-option:visible .rp-unit-check').prop('checked', true);
                    refresh();
                });
                $picker.on('click', '[data-unit-clear]', function () {
                    $list.find('.rp-unit-check').prop('checked', false);
                    refresh();
                });

                var api = {
                    refresh: refresh,
                    getIds: function () {
                        return $list.find('.rp-unit-check:checked').map(function () { return Number(this.value); }).get();
                    },
                    setIds: function (ids) {
                        var set = {};
                        (ids || []).forEach(function (id) { set[Number(id)] = true; });
                        $list.find('.rp-unit-check').each(function () { this.checked = !!set[Number(this.value)]; });
                        refresh();
                    },
                    reset: function () {
                        $search.val('');
                        $list.find('.rp-unit-check').prop('checked', false);
                        applyFilter();
                        refresh();
                    }
                };

                $picker.data('picker', api);
                refresh();
                return api;
            }

            createUnitPicker('addGroupUnitPicker', '#addGroupUnitCount');
            createUnitPicker('editGroupUnitPicker', '#editGroupUnitCount');

            // Bind submits
            $('#addUnitForm, #editUnitForm').on('submit', function (e) {
                e.preventDefault();
                var payload = getUnitPayload($(this));
                if (validateUnitPayload(payload, $(this))) submitUnit(payload, $(this));
            });

            $('#addGroupForm, #editGroupForm').on('submit', function (e) {
                e.preventDefault();
                var payload = getGroupPayload($(this));
                if (validateGroupPayload(payload, $(this))) submitGroup(payload, $(this));
            });
        })(jQuery);
    </script>
}
