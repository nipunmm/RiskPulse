@model RiskPulse.Models.ViewModel.UnitsIndexViewModel
@{
    ViewData["Title"] = "Unit Management";

    var unitsJson = Json.Serialize(Model.Units);
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-2 mb-2">
    <div>
        <h2 class="font-display-lg" style="color: var(--on-background);">Unit Management</h2>
        <p class="font-body-md mt-1 mb-0" style="color: var(--on-surface-variant);">
            Maintain the organizational units and group them for assessments and reporting.
        </p>
    </div>
</div>

<!-- ============================================================
     TABS — UNITS | UNIT GROUPS
     ============================================================ -->
<div class="card-stasis p-2">
    <ul class="nav nav-tabs" id="unitsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="unitsTab" data-bs-toggle="tab" data-bs-target="#unitsPane" type="button" role="tab" aria-controls="unitsPane" aria-selected="true">
                <i class="fas fa-building"></i> Units
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="groupsTab" data-bs-toggle="tab" data-bs-target="#groupsPane" type="button" role="tab" aria-controls="groupsPane" aria-selected="false">
                <i class="fas fa-layer-group"></i> Unit Groups
            </button>
        </li>
    </ul>

    <div class="tab-content pt-3">
        <!-- ============================================================
             UNITS PANE
             ============================================================ -->
        <div class="tab-pane fade show active" id="unitsPane" role="tabpanel" aria-labelledby="unitsTab">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-2 pb-2">
                <p class="mb-0 font-body-sm" style="color: var(--on-surface-variant);">Manage units (departments / branches).</p>
                <button type="button" class="btn-stasis-primary" data-bs-toggle="modal" data-bs-target="#addUnitModal">
                    <i class="fas fa-plus"></i> Add Unit
                </button>
            </div>
            <table id="unitTable" class="table table-stasis table-sm w-100 align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Code</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>

        <!-- ============================================================
             UNIT GROUPS PANE
             ============================================================ -->
        <div class="tab-pane fade" id="groupsPane" role="tabpanel" aria-labelledby="groupsTab">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-2 pb-2">
                <p class="mb-0 font-body-sm" style="color: var(--on-surface-variant);">Group units together for assessments and reporting.</p>
                <button type="button" class="btn-stasis-primary" data-bs-toggle="modal" data-bs-target="#addGroupModal">
                    <i class="fas fa-plus"></i> Add Group
                </button>
            </div>
            <table id="groupTable" class="table table-stasis table-sm w-100 align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Group Name</th>
                        <th>Units</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- ============================================================
     ADD UNIT MODAL
     ============================================================ -->
<div class="modal fade" id="addUnitModal" tabindex="-1" aria-labelledby="addUnitModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addUnitForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="addUnitModalLabel">Add Unit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="addUnitCode">Unit Code</label>
                        <input type="text" id="addUnitCode" name="unitCode" class="input-stasis" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="addUnitType">Type</label>
                        <select id="addUnitType" name="unitType" class="input-stasis">
                            <option value="Department">Department</option>
                            <option value="Branch">Branch</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="addUnitDesc">Description</label>
                        <input type="text" id="addUnitDesc" name="unitDesc" class="input-stasis" required autocomplete="off" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     EDIT UNIT MODAL
     ============================================================ -->
<div class="modal fade" id="editUnitModal" tabindex="-1" aria-labelledby="editUnitModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editUnitForm" novalidate>
                <input type="hidden" id="editUnitId" name="unitId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editUnitModalLabel">Edit Unit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="editUnitCode">Unit Code</label>
                        <input type="text" id="editUnitCode" name="unitCode" class="input-stasis" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="editUnitType">Type</label>
                        <select id="editUnitType" name="unitType" class="input-stasis">
                            <option value="Department">Department</option>
                            <option value="Branch">Branch</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="editUnitDesc">Description</label>
                        <input type="text" id="editUnitDesc" name="unitDesc" class="input-stasis" required autocomplete="off" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     ADD GROUP MODAL
     ============================================================ -->
<div class="modal fade" id="addGroupModal" tabindex="-1" aria-labelledby="addGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addGroupForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="addGroupModalLabel">Add Group</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="addGroupDesc">Group Name</label>
                        <input type="text" id="addGroupDesc" name="groupDesc" class="input-stasis" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="addGroupUnitIds">Units</label>
                        <select id="addGroupUnitIds" name="unitIds" class="input-stasis" multiple></select>
                        <small class="text-muted font-body-xs mt-1 d-block">Select at least 2 units to create a group.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     EDIT GROUP MODAL
     ============================================================ -->
<div class="modal fade" id="editGroupModal" tabindex="-1" aria-labelledby="editGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editGroupForm" novalidate>
                <input type="hidden" id="editGroupId" name="groupId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editGroupModalLabel">Edit Group</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="editGroupDesc">Group Name</label>
                        <input type="text" id="editGroupDesc" name="groupDesc" class="input-stasis" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="editGroupUnitIds">Units</label>
                        <select id="editGroupUnitIds" name="unitIds" class="input-stasis" multiple></select>
                        <small class="text-muted font-body-xs mt-1 d-block">Select at least 2 units.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var units = @Html.Raw(unitsJson);
            var unitGridUrl = '@Url.Action("UnitGrid", "Units")';
            var saveUnitUrl = '@Url.Action("SaveUnit", "Units")';
            var deleteUnitUrl = '@Url.Action("DeleteUnit", "Units")';
            var groupGridUrl = '@Url.Action("GroupGrid", "Units")';
            var saveGroupUrl = '@Url.Action("SaveGroup", "Units")';
            var deleteGroupUrl = '@Url.Action("DeleteGroup", "Units")';

            function unitOptions() {
                return $.map(units, function (u) { return { value: u.value, label: u.label }; });
            }

            /* =================================================================
               SECTION 2 — FORM PAYLOAD BUILDERS
               ================================================================= */
            function getUnitPayload($form) {
                return RiskPulse.serializeForm($form, { numbers: ['unitId'] });
            }

            function getGroupPayload($form) {
                var payload = RiskPulse.serializeForm($form, { numbers: ['groupId'] });
                payload.unitIds = ($form.find('[name="unitIds"]').val() || []).map(Number);
                return payload;
            }

            /* =================================================================
               SECTION 3 — VALIDATION
               ================================================================= */
            function validateUnitPayload(payload) {
                if (!$.trim(payload.unitCode)) { RiskPulse.toastError('Unit code is required.'); return false; }
                if (!$.trim(payload.unitDesc)) { RiskPulse.toastError('Unit description is required.'); return false; }
                return true;
            }

            function validateGroupPayload(payload) {
                if (!$.trim(payload.groupDesc)) { RiskPulse.toastError('Group name is required.'); return false; }
                if (!payload.unitIds || payload.unitIds.length < 2) { RiskPulse.toastError('Please select at least 2 units.'); return false; }
                return true;
            }

            /* =================================================================
               SECTION 4 — CONTROLLER CALLS (AJAX)
               ================================================================= */
            function submitUnit(payload, $form) {
                RiskPulse.postJson(saveUnitUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        unitTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'Unit saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save unit.');
                    }
                });
            }

            function submitGroup(payload, $form) {
                RiskPulse.postJson(saveGroupUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        groupTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'Group saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save group.');
                    }
                });
            }

            /* =================================================================
               SECTION 5 — DATA GRIDS (DataTables)
               ================================================================= */
            var unitTable = RiskPulse.initGrid($('#unitTable'), {
                ajax: { url: unitGridUrl },
                columns: [
                    { data: 'unitId' },
                    { data: 'unitCode' },
                    { data: 'unitType', render: function (d) {
                        return '<span class="status-pill">' + d + '</span>';
                    } },
                    { data: 'unitDesc' },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function () {
                        return '<button type="button" class="btn-stasis-secondary edit-unit-btn"><i class="fas fa-pen-to-square"></i> Edit</button> ' +
                               '<button type="button" class="btn-stasis-secondary delete-unit-btn"><i class="fas fa-trash-can"></i> Delete</button>';
                    } }
                ],
                order: [[0, 'asc']]
            });

            var groupTable = RiskPulse.initGrid($('#groupTable'), {
                ajax: { url: groupGridUrl },
                columns: [
                    { data: 'groupId' },
                    { data: 'groupDesc' },
                    { data: 'unitDescs', orderable: false, searchable: false, render: function (d) {
                        var badges = (d || []).map(function (desc) { return '<span class="status-pill">' + desc + '</span>'; });
                        return badges.length ? badges.join(' ') : '<span class="text-muted">None</span>';
                    } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function () {
                        return '<button type="button" class="btn-stasis-secondary edit-group-btn"><i class="fas fa-pen-to-square"></i> Edit</button> ' +
                               '<button type="button" class="btn-stasis-secondary delete-group-btn"><i class="fas fa-trash-can"></i> Delete</button>';
                    } }
                ],
                order: [[0, 'asc']]
            });

            /* =================================================================
               SECTION 6 — EVENT WIRING & INIT
               ================================================================= */
            // Reset the Add forms each time their modal opens
            $('#addUnitModal').on('shown.bs.modal', function () {
                $('#addUnitCode').val('').trigger('focus');
                $('#addUnitType').val('Department');
                $('#addUnitDesc').val('');
            });

            $('#addGroupModal').on('shown.bs.modal', function () {
                $('#addGroupDesc').val('').trigger('focus');
                $('#addGroupUnitIds').val([]).trigger('change');
            });

            // Load a unit's values into the Edit modal
            $('#unitTable tbody').on('click', '.edit-unit-btn', function () {
                var row = unitTable.row($(this).closest('tr')).data();
                $('#editUnitId').val(row.unitId);
                $('#editUnitCode').val(row.unitCode);
                $('#editUnitType').val(row.unitType);
                $('#editUnitDesc').val(row.unitDesc);
                RiskPulse.showModal('editUnitModal');
            });

            // Load a group's values into the Edit modal
            $('#groupTable tbody').on('click', '.edit-group-btn', function () {
                var row = groupTable.row($(this).closest('tr')).data();
                $('#editGroupId').val(row.groupId);
                $('#editGroupDesc').val(row.groupDesc);
                $('#editGroupUnitIds').val(row.unitIds || []).trigger('change');
                RiskPulse.showModal('editGroupModal');
            });

            // Delete handlers
            $('#unitTable tbody').on('click', '.delete-unit-btn', function () {
                var row = unitTable.row($(this).closest('tr')).data();
                RiskPulse.confirmDelete('Delete Unit?', 'This permanently deletes unit "' + row.unitCode + '".', function () {
                    RiskPulse.postJson(deleteUnitUrl, { id: row.unitId }, {
                        success: function (res) {
                            unitTable.ajax.reload(null, false);
                            RiskPulse.toastSuccess(res.message || 'Unit deleted.');
                        },
                        fail: function (res) {
                            RiskPulse.toastError(res.message || 'Unable to delete unit.');
                        }
                    });
                });
            });

            $('#groupTable tbody').on('click', '.delete-group-btn', function () {
                var row = groupTable.row($(this).closest('tr')).data();
                RiskPulse.confirmDelete('Delete Group?', 'This permanently deletes group "' + row.groupDesc + '" and its unit assignments.', function () {
                    RiskPulse.postJson(deleteGroupUrl, { id: row.groupId }, {
                        success: function (res) {
                            groupTable.ajax.reload(null, false);
                            RiskPulse.toastSuccess(res.message || 'Group deleted.');
                        },
                        fail: function (res) {
                            RiskPulse.toastError(res.message || 'Unable to delete group.');
                        }
                    });
                });
            });

            // Populate and initialize the Unit multi-selects with Select2
            $.each({ addGroupUnitIds: unitOptions, editGroupUnitIds: unitOptions }, function (id, optionsFn) {
                RiskPulse.populateSelect($('#' + id), optionsFn());
                $('#' + id).select2({
                    width: '100%',
                    theme: 'bootstrap-5',
                    placeholder: 'Select units...',
                    allowClear: true,
                    dropdownParent: $('#' + id).closest('.modal')
                });
            });

            // Bind submits
            $('#addUnitForm, #editUnitForm').on('submit', function (e) {
                e.preventDefault();
                var payload = getUnitPayload($(this));
                if (validateUnitPayload(payload)) submitUnit(payload, $(this));
            });

            $('#addGroupForm, #editGroupForm').on('submit', function (e) {
                e.preventDefault();
                var payload = getGroupPayload($(this));
                if (validateGroupPayload(payload)) submitGroup(payload, $(this));
            });
        })(jQuery);
    </script>
}
