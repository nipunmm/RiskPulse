@model RiskPulse.Models.ViewModel.SaqTemplatesIndexViewModel
@{
    ViewData["Title"] = "SAQ Templates";

    var statusesJson = Json.Serialize(Model.SaqStatuses);
    var unitGroupsJson = Json.Serialize(Model.UnitGroups);
    var unitsJson = Json.Serialize(Model.Units);
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<header class="rp-hero rp-hero--blue">
    <h1 class="rp-display-lg">SAQ Templates</h1>
    <p class="rp-hero-sub">
        Manage Self Assessment Questionnaire templates — build questions and their dropdown answers.
    </p>
    <div class="rp-hero-actions">
        <button type="button" class="rp-btn rp-btn-primary" id="addSaqTemplateBtn">
            <i class="fas fa-plus"></i> Add Template
        </button>
    </div>
</header>

<div class="rp-card p-2">
    <div class="table-responsive">
    <table id="saqTable" class="table rp-table table-sm w-100 align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Code</th>
                <th>Description</th>
                <th>Assigned To</th>
                <th>Status</th>
                <th>Questions</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
    </table>
    </div>
</div>

<!-- ============================================================
     TEMPLATE MODAL — Header Fields + Split-Pane Question Builder
     ============================================================ -->
<div class="modal fade" id="saqTemplateModal" tabindex="-1" aria-labelledby="saqTemplateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <form id="saqTemplateForm" novalidate>
                <input type="hidden" id="saqHeaderId" name="saqHeaderId" value="0" />
                <div class="modal-header py-2">
                    <div>
                        <h5 class="modal-title" id="saqTemplateModalLabel">Add SAQ Template</h5>
                        <div id="saqTemplateStatusPill" class="mt-1"></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <!-- HEADER FIELDS -->
                    <div class="p-3 border-bottom" id="saqHeaderFields">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="rp-label" for="saqDesc">Description</label>
                                <input type="text" id="saqDesc" name="saqDesc" class="rp-input" autocomplete="off" />
                            </div>
                            <div class="col-md-4 d-none" id="saqCodeCol">
                                <label class="rp-label" for="saqCode">Code</label>
                                <input type="text" id="saqCode" name="saqCode" class="rp-input" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="rp-label" for="saqLinkType">Link Type</label>
                                <select id="saqLinkType" class="rp-input">
                                    <option value="group">Unit Group</option>
                                    <option value="unit">Unit</option>
                                </select>
                            </div>
                            <div class="col-md-4" id="saqGroupRow">
                                <label class="rp-label" for="saqGroup">Unit Group</label>
                                <select id="saqGroup" name="groupId" class="rp-input"></select>
                            </div>
                            <div class="col-md-4 d-none" id="saqUnitRow">
                                <label class="rp-label" for="saqUnit">Unit</label>
                                <select id="saqUnit" name="unitId" class="rp-input"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="rp-label" for="saqStatus">Status</label>
                                <select id="saqStatus" name="saqStatus" class="rp-input"></select>
                            </div>
                        </div>
                    </div>
                    <!-- SPLIT-PANE DESIGNER -->
                    <div class="rp-design-split">
                        <!-- LEFT PANEL: Question List -->
                        <div class="rp-design-left">
                            <div class="p-2 border-bottom d-flex justify-content-between align-items-center">
                                <span class="rp-label-md rp-text-muted">Questions (<span id="questionCount">0</span>)</span>
                                <button type="button" class="rp-btn rp-btn-primary" id="addQuestionBtn">
                                    <i class="fas fa-plus"></i> Add
                                </button>
                            </div>
                            <div class="rp-design-left-list" id="questionList"></div>
                        </div>
                        <!-- RIGHT PANEL: Editor -->
                        <div class="rp-design-right">
                            <div id="editorEmptyState" class="rp-empty-state">
                                <i class="fas fa-clipboard-question fa-2x mb-3 rp-empty-state-icon"></i>
                                <p class="rp-body-md mb-0">Select a question on the left, or click <strong>Add</strong> to create one.</p>
                            </div>
                            <div id="questionEditor" class="p-3 d-none">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0" id="editorTitle">New Question</h6>
                                    <input type="hidden" id="editorQuestionId" value="0" />
                                </div>
                                <div class="mb-2">
                                    <label class="rp-label" for="editorQuestionText">Question Text</label>
                                    <textarea id="editorQuestionText" class="rp-input w-100" rows="2" autocomplete="off" placeholder="e.g. Are cash drawer limits strictly observed?"></textarea>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="editorAllowComment" checked />
                                    <label class="form-check-label rp-body-md" for="editorAllowComment">Allow comments for this question</label>
                                </div>
                                <div class="mb-2 d-flex justify-content-between align-items-center">
                                    <label class="rp-label mb-0">Answer Options</label>
                                    <div class="d-flex gap-1">
                                        <button type="button" class="rp-btn rp-btn-secondary" id="resetOptionsBtn" title="Clear all options">
                                            <i class="fas fa-rotate-left"></i> Reset
                                        </button>
                                        <button type="button" class="rp-btn rp-btn-secondary" id="addOptionBtn">
                                            <i class="fas fa-plus"></i> Add Option
                                        </button>
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <div class="d-flex gap-1 flex-wrap">
                                        <button type="button" class="rp-btn rp-btn-secondary rp-preset-btn" data-preset="yesno"><i class="fas fa-bolt me-1"></i>Yes / No</button>
                                    </div>
                                </div>
                                <div id="optionRows"></div>
                                <div class="mt-3 d-flex gap-2">
                                    <button type="button" class="rp-btn rp-btn-primary" id="saveQuestionBtn">
                                        <i class="fas fa-check"></i> Save Question
                                    </button>
                                    <button type="button" class="rp-btn rp-btn-secondary" id="cancelQuestionBtn">Cancel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <span class="rp-locked-note text-muted rp-body-sm me-auto" id="lockedNotice">
                        <i class="fas fa-lock me-1"></i> This template is locked and cannot be modified.
                    </span>
                    <button type="button" class="rp-btn rp-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="rp-btn rp-btn-primary" id="saveSaqTemplateBtn">
                        <i class="fas fa-check"></i> Save Template
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var statuses = @Html.Raw(statusesJson);
            var unitGroups = @Html.Raw(unitGroupsJson);
            var units = @Html.Raw(unitsJson);
            var gridUrl = '@Url.Action("Grid", "SaqTemplates")';
            var saveFullUrl = '@Url.Action("SaveFull", "SaqTemplates")';
            var deleteUrl = '@Url.Action("Delete", "SaqTemplates")';
            var questionsGridUrl = '@Url.Action("QuestionsGrid", "SaqTemplates")';

            var currentSaqId = 0;
            var currentSaqLocked = false;
            var loadedQuestions = [];
            var selectedQuestionId = null;
            var nextTempQuestionId = 0;

            var PRESETS = {
                yesno: [
                    { optionText: 'Yes' },
                    { optionText: 'No' }
                ]
            };

            /* =================================================================
               SECTION 2 — UI RENDERERS
               ================================================================= */
            function optionRowHtml(option, index) {
                option = option || {};
                return $('<div class="rp-option-row">').append(
                    $('<span class="rp-item-num">').text((index + 1) + '.'),
                    $('<input type="hidden" class="option-id">').val(option.optionId || 0),
                    $('<input type="text" class="rp-input flex-fill option-text" placeholder="Option text" autocomplete="off">').val(option.optionText || ''),
                    $('<button type="button" class="rp-btn rp-btn-secondary remove-option-btn" title="Remove"><i class="fas fa-xmark"></i></button>')
                );
            }

            function renderQuestionList(questions) {
                loadedQuestions = questions || [];
                var $container = $('#questionList').empty();
                $('#questionCount').text(loadedQuestions.length);

                if (!loadedQuestions.length) {
                    $container.append('<div class="text-center text-muted rp-body-sm py-4">No questions yet.</div>');
                    return;
                }

                $.each(loadedQuestions, function (i, q) {
                    var $item = $('<div class="rp-design-item rp-card p-2 mb-1" tabindex="0">').data('question', q);
                    if (q.questionId === selectedQuestionId) $item.addClass('selected');

                    var $top = $('<div class="d-flex justify-content-between align-items-center gap-1">');
                    var $label = $('<div class="rp-body-md fw-semibold rp-truncate">');
                    $label.append($('<span class="text-muted me-1">').text('Q' + (i + 1) + '.'));
                    $label.append($('<span>').text(q.questionText));
                    $top.append($label);

                    if (!currentSaqLocked) {
                        $top.append(
                            $('<button type="button" class="rp-btn rp-btn-delete rp-design-item-delete" title="Delete">')
                                .append('<i class="fas fa-trash-can"></i>')
                                .data('question', q)
                        );
                    }
                    $item.append($top);

                    var $meta = $('<div class="rp-body-sm text-muted mt-1">');
                    $meta.text('Dropdown \u2022 ' + (q.options ? q.options.length : 0) + ' options');
                    if (q.allowComment) $meta.append(' \u2022 Comments allowed');
                    $item.append($meta);

                    $container.append($item);
                });
            }

            function showEditor(question) {
                selectedQuestionId = question ? question.questionId : null;
                $('#editorQuestionId').val(question ? question.questionId : 0);
                $('#editorQuestionText').val(question ? question.questionText : '');
                $('#editorAllowComment').prop('checked', question ? question.allowComment : true);
                var num = question ? (loadedQuestions.indexOf(question) + 1) : 0;
                $('#editorTitle').text(question ? 'Edit Question #' + num : 'New Question');

                $('#optionRows').empty();
                var options;
                if (question && question.options && question.options.length) {
                    options = question.options;
                } else if (question) {
                    options = [null];
                } else {
                    options = PRESETS.yesno;
                }
                $.each(options, function (i, o) { $('#optionRows').append(optionRowHtml(o, i)); });

                $('#editorEmptyState').addClass('d-none');
                $('#questionEditor').removeClass('d-none');
                highlightSelected();
                $('#editorQuestionText').trigger('focus');
            }

            function hideEditor() {
                selectedQuestionId = null;
                $('#questionEditor').addClass('d-none');
                $('#editorEmptyState').removeClass('d-none');
                highlightSelected();
            }

            function highlightSelected() {
                $('#questionList .rp-design-item').removeClass('selected');
                if (selectedQuestionId !== null) {
                    $('#questionList .rp-design-item').each(function () {
                        if ($(this).data('question').questionId === selectedQuestionId) {
                            $(this).addClass('selected');
                        }
                    });
                }
            }

            function renumberOptions() {
                $('#optionRows .rp-option-row').each(function (i) {
                    $(this).find('.rp-item-num').text((i + 1) + '.');
                });
            }

            function setLockedMode(locked) {
                currentSaqLocked = locked;
                $('#lockedNotice').toggle(locked);
                $('#addQuestionBtn').toggle(!locked);
                $('#saveSaqTemplateBtn').prop('disabled', locked);
                $('#saqHeaderFields :input').prop('disabled', locked);
                $('#questionEditor :input').prop('disabled', locked);
            }

            /* =================================================================
               SECTION 3 — FORM PAYLOAD BUILDERS
               ================================================================= */
            function getHeaderPayload($form) {
                var payload = RiskPulse.serializeForm($form, {
                    numbers: ['saqHeaderId']
                });
                var isGroup = $('#saqLinkType').val() === 'group';
                payload.groupId = isGroup ? (+$('#saqGroup').val() || null) : null;
                payload.unitId = !isGroup ? (+$('#saqUnit').val() || null) : null;
                return payload;
            }

            function getQuestionPayload() {
                var payload = {};
                payload.questionId = +$('#editorQuestionId').val() || 0;
                payload.questionText = $.trim($('#editorQuestionText').val());
                payload.allowComment = $('#editorAllowComment').is(':checked');

                payload.options = [];
                $('#optionRows .rp-option-row').each(function () {
                    var $row = $(this);
                    var text = $.trim($row.find('.option-text').val());
                    if (!text) return;
                    payload.options.push({
                        optionId: +$row.find('.option-id').val() || 0,
                        optionText: text
                    });
                });
                return payload;
            }

            function getFullPayload($form) {
                return {
                    header: getHeaderPayload($form),
                    questions: $.map(loadedQuestions, function (q) {
                        return {
                            questionId: q.questionId < 0 ? 0 : q.questionId,
                            questionText: q.questionText,
                            allowComment: q.allowComment,
                            options: $.map(q.options, function (o) {
                                return { optionId: o.optionId || 0, optionText: o.optionText };
                            })
                        };
                    })
                };
            }

            /* =================================================================
               SECTION 4 — VALIDATION
               ================================================================= */
            function validateHeaderPayload(payload, $form) {
                if (!payload.groupId && !payload.unitId) { return RiskPulse.validationError($form.find('[name="groupId"], [name="unitId"]'), 'Please select a unit group or a unit.'); }
                if (payload.groupId && payload.unitId) { return RiskPulse.validationError($form.find('[name="groupId"], [name="unitId"]'), 'Please select either a unit group or a unit, not both.'); }
                if (!payload.saqStatus) { return RiskPulse.validationError($form.find('[name="saqStatus"]'), 'Please select a status.'); }
                return true;
            }

            function validateQuestionPayload(payload) {
                if (!payload.questionText) { return RiskPulse.validationError($('#editorQuestionText'), 'Question text is required.'); }
                if (!payload.options.length) { return RiskPulse.validationError(null, 'At least one option is required.'); }
                var seen = {};
                var duplicate = false;
                $.each(payload.options, function (_, o) {
                    var key = o.optionText.toLowerCase();
                    if (seen[key]) { duplicate = true; return false; }
                    seen[key] = true;
                });
                if (duplicate) { return RiskPulse.validationError(null, 'Duplicate options are not allowed for the same question.'); }
                return true;
            }

            function validateFullPayload(payload, $form) {
                if (!validateHeaderPayload(payload.header, $form)) return false;
                if (currentSaqId === 0 && !payload.questions.length) { return RiskPulse.validationError(null, 'At least one question is required.'); }
                for (var i = 0; i < payload.questions.length; i++) {
                    var q = payload.questions[i];
                    if (!$.trim(q.questionText)) { return RiskPulse.validationError(null, 'Question text is required.'); }
                    if (!q.options.length) { return RiskPulse.validationError(null, 'At least one option is required.'); }
                    var seen = {};
                    var dup = false;
                    $.each(q.options, function (_, o) {
                        var key = o.optionText.toLowerCase();
                        if (seen[key]) { dup = true; return false; }
                        seen[key] = true;
                    });
                    if (dup) { return RiskPulse.validationError(null, 'Duplicate options are not allowed for the same question.'); }
                }
                return true;
            }

            /* =================================================================
               SECTION 5 — CONTROLLER CALLS (AJAX)
               ================================================================= */
            function submitFull(payload, $form) {
                RiskPulse.postJson(saveFullUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        saqTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'Template saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save template.');
                    }
                }, $('#saveSaqTemplateBtn'));
            }

            function deleteHeader(saqHeaderId, desc, code) {
                var display = desc || code;
                RiskPulse.confirmDelete(
                    'Delete template?',
                    'This will permanently delete "' + display + '" and all of its questions.',
                    function () {
                        RiskPulse.postJson(deleteUrl, { id: saqHeaderId }, {
                            success: function (res) {
                                saqTable.ajax.reload(null, false);
                                RiskPulse.toastSuccess(res.message || 'Template deleted successfully.');
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to delete template.');
                            }
                        });
                    }
                );
            }

            function loadQuestions(saqHeaderId) {
                RiskPulse.getJson(questionsGridUrl, { saqHeaderId: saqHeaderId }, {
                    success: function (res) {
                        renderQuestionList(res.data);
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to load questions.');
                    }
                });
            }

            /* =================================================================
               SECTION 6 — DATA GRID (DataTables)
               ================================================================= */
            var saqTable = RiskPulse.initGrid($('#saqTable'), {
                ajax: { url: gridUrl },
                columns: [
                    { data: 'saqHeaderId' },
                    { data: 'saqCode' },
                    { data: 'saqDesc' },
                    { data: 'groupDesc', render: function (d, type, row) { return RiskPulse.pill(d || row.unitDesc || ''); } },
                    { data: 'saqStatus', render: function (d) { return RiskPulse.statusPill(d); } },
                    { data: 'questionCount', render: function (d) { return RiskPulse.pill(d || 0); } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function (data, type, row) {
                        var locked = row.saqStatus === 'Locked';
                        return [
                            locked
                                ? '<button type="button" class="rp-btn rp-btn-secondary" disabled title="Locked templates cannot be edited"><i class="fas fa-pen-to-square"></i> Edit</button>'
                                : '<button type="button" class="rp-btn rp-btn-edit edit-saq-btn"><i class="fas fa-pen-to-square"></i> Edit</button>',
                            locked
                                ? '<button type="button" class="rp-btn rp-btn-secondary" disabled title="Locked templates cannot be deleted"><i class="fas fa-trash-can"></i> Delete</button>'
                                : '<button type="button" class="rp-btn rp-btn-delete delete-saq-btn"><i class="fas fa-trash-can"></i> Delete</button>'
                        ].join(' ');
                    } }
                ],
                order: [[0, 'desc']]
            });

            /* =================================================================
               SECTION 7 — EVENT WIRING & INIT
               ================================================================= */
            RiskPulse.populateSelect($('#saqStatus'), statuses);
            $('#saqGroup').empty();
            RiskPulse.populateSelect($('#saqGroup'), unitGroups, '0', 'Select a unit group...');
            $('#saqUnit').empty();
            RiskPulse.populateSelect($('#saqUnit'), units, '0', 'Select a unit...');

            function toggleSaqLinkType() {
                var isGroup = $('#saqLinkType').val() === 'group';
                $('#saqGroupRow').toggleClass('d-none', !isGroup);
                $('#saqUnitRow').toggleClass('d-none', isGroup);
                if (isGroup) { $('#saqUnit').val(0).trigger('change'); }
                else { $('#saqGroup').val(0).trigger('change'); }
            }
            $('#saqLinkType').on('change', toggleSaqLinkType);

            function resetHeaderFields() {
                $('#saqHeaderId').val(0);
                $('#saqCode').val('').prop('readonly', true);
                $('#saqCodeCol').addClass('d-none');
                $('#saqDesc').val('');
                $('#saqLinkType').val('group').trigger('change');
                $('#saqGroup').val(0).trigger('change');
                $('#saqUnit').val(0).trigger('change');
                $('#saqStatus').val('Active').trigger('change');
                RiskPulse.clearFieldErrors($('#saqTemplateForm'));
            }

            function openAddTemplateModal() {
                currentSaqId = 0;
                selectedQuestionId = null;
                nextTempQuestionId = 0;
                setLockedMode(false);
                resetHeaderFields();
                $('#saqTemplateModalLabel').text('Add SAQ Template');
                $('#saqTemplateStatusPill').html(RiskPulse.statusPill('Active'));
                hideEditor();
                renderQuestionList([]);
                RiskPulse.showModal('saqTemplateModal');
            }

            function openEditTemplateModal(row) {
                currentSaqId = row.saqHeaderId;
                currentSaqLocked = row.saqStatus === 'Locked';
                selectedQuestionId = null;
                nextTempQuestionId = 0;
                setLockedMode(currentSaqLocked);

                $('#saqHeaderId').val(row.saqHeaderId);
                $('#saqCode').val(row.saqCode).prop('readonly', true);
                $('#saqCodeCol').removeClass('d-none');
                $('#saqDesc').val(row.saqDesc);
                if (row.groupId) {
                    $('#saqLinkType').val('group').trigger('change');
                    $('#saqGroup').val(row.groupId).trigger('change');
                    $('#saqUnit').val(0).trigger('change');
                } else {
                    $('#saqLinkType').val('unit').trigger('change');
                    $('#saqUnit').val(row.unitId).trigger('change');
                    $('#saqGroup').val(0).trigger('change');
                }
                $('#saqStatus').val(row.saqStatus).trigger('change');
                RiskPulse.clearFieldErrors($('#saqTemplateForm'));

                $('#saqTemplateModalLabel').text('Edit SAQ Template');
                $('#saqTemplateStatusPill').html(RiskPulse.statusPill(row.saqStatus));
                hideEditor();
                loadQuestions(currentSaqId);
                RiskPulse.showModal('saqTemplateModal');
            }

            $('#addSaqTemplateBtn').on('click', openAddTemplateModal);

            $('#saqTable tbody').on('click', '.edit-saq-btn', function () {
                var row = saqTable.row($(this).closest('tr')).data();
                openEditTemplateModal(row);
            });

            $('#saqTable tbody').on('click', '.delete-saq-btn', function () {
                var row = saqTable.row($(this).closest('tr')).data();
                deleteHeader(row.saqHeaderId, row.saqDesc, row.saqCode);
            });

            $('#saqTemplateForm').on('submit', function (e) {
                e.preventDefault();
                if (currentSaqLocked) return;
                var $form = $(this);
                var payload = getFullPayload($form);
                if (validateFullPayload(payload, $form)) submitFull(payload, $form);
            });

            // Left panel: click question to edit
            $('#questionList').on('click', '.rp-design-item', function (e) {
                if ($(e.target).closest('.rp-design-item-delete').length) return;
                if (currentSaqLocked) return;
                showEditor($(this).data('question'));
            });

            // Left panel: delete button (local list only — SaveFull reconciles the server)
            $('#questionList').on('click', '.rp-design-item-delete', function (e) {
                e.stopPropagation();
                var question = $(this).data('question');
                var index = $.inArray(question, loadedQuestions);
                if (index >= 0) {
                    loadedQuestions.splice(index, 1);
                    if (selectedQuestionId === question.questionId) hideEditor();
                    renderQuestionList(loadedQuestions);
                }
            });

            // Keyboard navigation for designer items
            $('#questionList').on('keydown', '.rp-design-item', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    if (currentSaqLocked) return;
                    showEditor($(this).data('question'));
                }
            });
            $('#questionList').on('keydown', '.rp-design-item-delete', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    e.stopPropagation();
                    var question = $(this).data('question');
                    var index = $.inArray(question, loadedQuestions);
                    if (index >= 0) {
                        loadedQuestions.splice(index, 1);
                        if (selectedQuestionId === question.questionId) hideEditor();
                        renderQuestionList(loadedQuestions);
                    }
                }
            });

            // Add Question
            $('#addQuestionBtn').on('click', function () {
                if (!currentSaqLocked) showEditor(null);
            });

            // Option rows
            $('#addOptionBtn').on('click', function () {
                var count = $('#optionRows .rp-option-row').length;
                $('#optionRows').append(optionRowHtml(null, count));
            });

            $('#resetOptionsBtn').on('click', function () {
                $('#optionRows').empty();
                $('#editorQuestionText').trigger('focus');
            });

            $('#optionRows').on('click', '.remove-option-btn', function () {
                $(this).closest('.rp-option-row').remove();
                renumberOptions();
            });

            // Quick Presets
            $('.rp-preset-btn').on('click', function () {
                var preset = PRESETS[$(this).data('preset')];
                if (!preset) return;
                $('#optionRows').empty();
                $.each(preset, function (i, o) { $('#optionRows').append(optionRowHtml(o, i)); });
            });

            // Commit the editor into the local list (no per-question POST anymore)
            $('#saveQuestionBtn').on('click', function () {
                var payload = getQuestionPayload();
                if (!validateQuestionPayload(payload)) return;

                var qid = payload.questionId;
                var found = false;
                $.each(loadedQuestions, function (i, q) {
                    if (q.questionId === qid) {
                        q.questionText = payload.questionText;
                        q.allowComment = payload.allowComment;
                        q.options = payload.options;
                        found = true;
                        return false;
                    }
                });
                if (!found) {
                    loadedQuestions.push({
                        questionId: --nextTempQuestionId,
                        questionText: payload.questionText,
                        allowComment: payload.allowComment,
                        options: payload.options
                    });
                }
                renderQuestionList(loadedQuestions);
                hideEditor();
            });

            $('#cancelQuestionBtn').on('click', function () {
                hideEditor();
            });
        })(jQuery);
    </script>
}