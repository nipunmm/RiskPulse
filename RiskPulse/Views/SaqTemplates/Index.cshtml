@model RiskPulse.Models.ViewModel.SaqTemplatesIndexViewModel
@{
    ViewData["Title"] = "SAQ Templates";

    var statusesJson = Json.Serialize(Model.SaqStatuses);
    var unitGroupsJson = Json.Serialize(Model.UnitGroups);
    var unitsJson = Json.Serialize(Model.Units);
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
    <style>
        .design-split { display: flex; min-height: 440px; max-height: 68vh; }
        .design-left { width: 310px; min-width: 260px; border-right: 1px solid var(--outline-variant); display: flex; flex-direction: column; }
        .design-left-list { flex: 1; overflow-y: auto; padding: 0.5rem; }
        .design-right { flex: 1; overflow-y: auto; }
        .q-item { cursor: pointer; border-left: 3px solid transparent; transition: border-color 0.15s, background 0.15s; }
        .q-item:hover { background: rgba(27, 54, 93, 0.03); }
        .q-item.selected { border-left-color: var(--primary-container); background: rgba(27, 54, 93, 0.05); }
        .q-item .q-delete-btn { opacity: 0; transition: opacity 0.15s; }
        .q-item:hover .q-delete-btn { opacity: 1; }
        .preset-btn { font-size: 0.625rem; padding: 0.2rem 0.5rem; }
        .option-row { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; }
        .option-row .option-num { min-width: 1.25rem; font-size: 0.75rem; color: var(--on-surface-variant); font-weight: 600; }
    </style>
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-2 mb-2">
    <div>
        <h2 class="font-display-lg" style="color: var(--on-background);">SAQ Templates</h2>
        <p class="font-body-md mt-1 mb-0" style="color: var(--on-surface-variant);">
            Manage Self Assessment Questionnaire templates — build questions and their dropdown answers.
        </p>
    </div>
    <button type="button" class="btn-stasis-primary" data-bs-toggle="modal" data-bs-target="#addSaqModal">
        <i class="fas fa-plus"></i> Add Template
    </button>
</div>

<div class="card-stasis p-2">
    <table id="saqTable" class="table table-stasis table-sm w-100 align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Description</th>
                <th>Assigned To</th>
                <th>Status</th>
                <th>Questions</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- ============================================================
     ADD TEMPLATE MODAL
     ============================================================ -->
<div class="modal fade" id="addSaqModal" tabindex="-1" aria-labelledby="addSaqModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addSaqForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="addSaqModalLabel">Add Template</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="addSaqDesc">Description</label>
                        <input type="text" id="addSaqDesc" name="saqDesc" class="input-stasis" required autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label class="input-label" for="addSaqLinkType">Link Type</label>
                        <select id="addSaqLinkType" class="input-stasis">
                            <option value="group">Unit Group</option>
                            <option value="unit">Unit</option>
                        </select>
                    </div>
                    <div class="mb-3" id="addSaqGroupRow">
                        <label class="input-label" for="addSaqGroup">Unit Group</label>
                        <select id="addSaqGroup" name="groupId" class="input-stasis"></select>
                    </div>
                    <div class="mb-3 d-none" id="addSaqUnitRow">
                        <label class="input-label" for="addSaqUnit">Unit</label>
                        <select id="addSaqUnit" name="unitId" class="input-stasis"></select>
                    </div>
                    <div class="mb-3">
                        <label class="input-label" for="addSaqStatus">Status</label>
                        <select id="addSaqStatus" name="saqStatus" class="input-stasis"></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     EDIT TEMPLATE MODAL
     ============================================================ -->
<div class="modal fade" id="editSaqModal" tabindex="-1" aria-labelledby="editSaqModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editSaqForm" novalidate>
                <input type="hidden" id="editSaqHeaderId" name="saqHeaderId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editSaqModalLabel">Edit Template</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="editSaqDesc">Description</label>
                        <input type="text" id="editSaqDesc" name="saqDesc" class="input-stasis" required autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label class="input-label" for="editSaqLinkType">Link Type</label>
                        <select id="editSaqLinkType" class="input-stasis">
                            <option value="group">Unit Group</option>
                            <option value="unit">Unit</option>
                        </select>
                    </div>
                    <div class="mb-3" id="editSaqGroupRow">
                        <label class="input-label" for="editSaqGroup">Unit Group</label>
                        <select id="editSaqGroup" name="groupId" class="input-stasis"></select>
                    </div>
                    <div class="mb-3 d-none" id="editSaqUnitRow">
                        <label class="input-label" for="editSaqUnit">Unit</label>
                        <select id="editSaqUnit" name="unitId" class="input-stasis"></select>
                    </div>
                    <div class="mb-3">
                        <label class="input-label" for="editSaqStatus">Status</label>
                        <select id="editSaqStatus" name="saqStatus" class="input-stasis"></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     DESIGN MODAL — Split-Pane Question Builder
     ============================================================ -->
<div class="modal fade" id="designModal" tabindex="-1" aria-labelledby="designModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header py-2">
                <div>
                    <h5 class="modal-title" id="designModalLabel">Design Template</h5>
                    <div id="designStatusPill" class="mt-1"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="design-split">
                    <!-- LEFT PANEL: Question List -->
                    <div class="design-left">
                        <div class="p-2 border-bottom d-flex justify-content-between align-items-center">
                            <span class="font-label-md" style="color: var(--on-surface-variant);">Questions (<span id="questionCount">0</span>)</span>
                            <button type="button" class="btn-stasis-primary" id="addQuestionBtn">
                                <i class="fas fa-plus"></i> Add
                            </button>
                        </div>
                        <div class="design-left-list" id="questionList"></div>
                    </div>
                    <!-- RIGHT PANEL: Editor -->
                    <div class="design-right">
                        <div id="editorEmptyState" class="d-flex flex-column align-items-center justify-content-center h-100 text-muted py-5">
                            <i class="fas fa-clipboard-question fa-2x mb-3" style="opacity:0.4;"></i>
                            <p class="font-body-md mb-0">Select a question on the left, or click <strong>Add</strong> to create one.</p>
                        </div>
                        <div id="questionEditor" class="p-3 d-none">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0" id="editorTitle">New Question</h6>
                                <input type="hidden" id="editorQuestionId" value="0" />
                            </div>
                            <div class="mb-2">
                                <label class="input-label" for="editorQuestionText">Question Text</label>
                                <textarea id="editorQuestionText" class="input-stasis w-100" rows="2" autocomplete="off" placeholder="e.g. Are cash drawer limits strictly observed?"></textarea>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="editorAllowComment" checked />
                                <label class="form-check-label font-body-md" for="editorAllowComment">Allow comments for this question</label>
                            </div>
                            <div class="mb-2 d-flex justify-content-between align-items-center">
                                <label class="input-label mb-0">Answer Options</label>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn-stasis-secondary" id="resetOptionsBtn" title="Clear all options">
                                        <i class="fas fa-rotate-left"></i> Reset
                                    </button>
                                    <button type="button" class="btn-stasis-secondary" id="addOptionBtn">
                                        <i class="fas fa-plus"></i> Add Option
                                    </button>
                                </div>
                            </div>
                            <div class="mb-2">
                                <div class="d-flex gap-1 flex-wrap">
                                    <button type="button" class="btn-stasis-secondary preset-btn" data-preset="yesno"><i class="fas fa-bolt me-1"></i>Yes / No</button>
                                </div>
                            </div>
                            <div id="optionRows"></div>
                            <div class="mt-3 d-flex gap-2">
                                <button type="button" class="btn-stasis-primary" id="saveQuestionBtn">
                                    <i class="fas fa-check"></i> Save Question
                                </button>
                                <button type="button" class="btn-stasis-secondary" id="cancelQuestionBtn">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <span class="text-muted font-body-sm me-auto" id="lockedNotice" style="display:none;">
                    <i class="fas fa-lock me-1"></i> This template is locked and cannot be modified.
                </span>
                <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var statuses = @Html.Raw(statusesJson);
            var unitGroups = @Html.Raw(unitGroupsJson);
            var units = @Html.Raw(unitsJson);
            var gridUrl = '@Url.Action("Grid", "SaqTemplates")';
            var saveUrl = '@Url.Action("Save", "SaqTemplates")';
            var deleteUrl = '@Url.Action("Delete", "SaqTemplates")';
            var questionsGridUrl = '@Url.Action("QuestionsGrid", "SaqTemplates")';
            var saveQuestionUrl = '@Url.Action("SaveQuestion", "SaqTemplates")';
            var deleteQuestionUrl = '@Url.Action("DeleteQuestion", "SaqTemplates")';

            var currentSaqId = 0;
            var currentSaqLocked = false;
            var loadedQuestions = [];
            var selectedQuestionId = null;

            var PRESETS = {
                yesno: [
                    { optionText: 'Yes' },
                    { optionText: 'No' }
                ]
            };

            /* =================================================================
               SECTION 2 — UI RENDERERS
               ================================================================= */
            function statusPill(status) {
                switch (status) {
                    case 'Active': return '<span class="status-pill rag-green">Active</span>';
                    case 'Locked': return '<span class="status-pill rag-amber">Locked</span>';
                    default: return '<span class="status-pill rag-red">Inactive</span>';
                }
            }

            function optionRowHtml(option, index) {
                option = option || {};
                return $('<div class="option-row">').append(
                    $('<span class="option-num">').text((index + 1) + '.'),
                    $('<input type="hidden" class="option-id">').val(option.optionId || 0),
                    $('<input type="text" class="input-stasis flex-fill option-text" placeholder="Option text" autocomplete="off">').val(option.optionText || ''),
                    $('<button type="button" class="btn-stasis-secondary remove-option-btn" title="Remove"><i class="fas fa-xmark"></i></button>')
                );
            }

            function renderQuestionList(questions) {
                loadedQuestions = questions || [];
                var $container = $('#questionList').empty();
                $('#questionCount').text(loadedQuestions.length);

                if (!loadedQuestions.length) {
                    $container.append('<div class="text-center text-muted font-body-sm py-4">No questions yet.</div>');
                    return;
                }

                $.each(loadedQuestions, function (i, q) {
                    var $item = $('<div class="q-item card-stasis p-2 mb-1">').data('question', q);
                    if (q.questionId === selectedQuestionId) $item.addClass('selected');

                    var $top = $('<div class="d-flex justify-content-between align-items-center gap-1">');
                    var $label = $('<div class="font-body-md fw-semibold" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">');
                    $label.append($('<span class="text-muted me-1">').text('Q' + q.displayOrder + '.'));
                    $label.append($('<span>').text(q.questionText));
                    $top.append($label);

                    if (!currentSaqLocked) {
                        $top.append(
                            $('<button type="button" class="btn-stasis-secondary q-delete-btn" title="Delete" style="padding:0.15rem 0.4rem;">')
                                .append('<i class="fas fa-trash-can"></i>')
                                .data('question', q)
                        );
                    }
                    $item.append($top);

                    var $meta = $('<div class="font-body-sm text-muted mt-1">');
                    $meta.text('Dropdown \u2022 ' + (q.options ? q.options.length : 0) + ' options');
                    if (q.allowComment) $meta.append(' \u2022 Comments allowed');
                    $item.append($meta);

                    $container.append($item);
                });
            }

            function showEditor(question) {
                selectedQuestionId = question ? question.questionId : null;
                $('#editorQuestionId').val(question ? question.questionId : 0);
                $('#editorQuestionText').val(question ? question.questionText : '');
                $('#editorAllowComment').prop('checked', question ? question.allowComment : true);
                $('#editorTitle').text(question ? 'Edit Question #' + question.displayOrder : 'New Question');

                $('#optionRows').empty();
                var options;
                if (question && question.options && question.options.length) {
                    options = question.options;
                } else if (question) {
                    options = [null];
                } else {
                    options = PRESETS.yesno;
                }
                $.each(options, function (i, o) { $('#optionRows').append(optionRowHtml(o, i)); });

                $('#editorEmptyState').addClass('d-none');
                $('#questionEditor').removeClass('d-none');
                highlightSelected();
                $('#editorQuestionText').trigger('focus');
            }

            function hideEditor() {
                selectedQuestionId = null;
                $('#questionEditor').addClass('d-none');
                $('#editorEmptyState').removeClass('d-none');
                highlightSelected();
            }

            function highlightSelected() {
                $('#questionList .q-item').removeClass('selected');
                if (selectedQuestionId !== null) {
                    $('#questionList .q-item').each(function () {
                        if ($(this).data('question').questionId === selectedQuestionId) {
                            $(this).addClass('selected');
                        }
                    });
                }
            }

            function renumberOptions() {
                $('#optionRows .option-row').each(function (i) {
                    $(this).find('.option-num').text((i + 1) + '.');
                });
            }

            /* =================================================================
               SECTION 3 — FORM PAYLOAD BUILDERS
               ================================================================= */
            function getHeaderPayload($form) {
                var payload = RiskPulse.serializeForm($form, {
                    numbers: ['saqHeaderId']
                });
                var isGroup = $form.find('[id$="SaqLinkType"]').val() === 'group';
                payload.groupId = isGroup ? (+$form.find('[id$="SaqGroup"]').val() || null) : null;
                payload.unitId = !isGroup ? (+$form.find('[id$="SaqUnit"]').val() || null) : null;
                return payload;
            }

            function getQuestionPayload() {
                var payload = {};
                payload.questionId = +$('#editorQuestionId').val() || 0;
                payload.saqHeaderId = currentSaqId;
                payload.questionText = $.trim($('#editorQuestionText').val());
                payload.allowComment = $('#editorAllowComment').is(':checked');

                payload.options = [];
                $('#optionRows .option-row').each(function () {
                    var $row = $(this);
                    var text = $.trim($row.find('.option-text').val());
                    if (!text) return;
                    payload.options.push({
                        optionId: +$row.find('.option-id').val() || 0,
                        optionText: text
                    });
                });
                return payload;
            }

            /* =================================================================
               SECTION 4 — VALIDATION
               ================================================================= */
            function validateHeaderPayload(payload) {
                if (!$.trim(payload.saqDesc)) { RiskPulse.toastError('Template description is required.'); return false; }
                if (!payload.groupId && !payload.unitId) { RiskPulse.toastError('Please select a unit group or a unit.'); return false; }
                if (payload.groupId && payload.unitId) { RiskPulse.toastError('Please select either a unit group or a unit, not both.'); return false; }
                if (!payload.saqStatus) { RiskPulse.toastError('Please select a status.'); return false; }
                return true;
            }

            function validateQuestionPayload(payload) {
                if (!payload.questionText) { RiskPulse.toastError('Question text is required.'); return false; }
                if (!payload.options.length) { RiskPulse.toastError('At least one option is required.'); return false; }
                return true;
            }

            /* =================================================================
               SECTION 5 — CONTROLLER CALLS (AJAX)
               ================================================================= */
            function submitHeader(payload, $form) {
                RiskPulse.postJson(saveUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        saqTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'Template saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save template.');
                    }
                });
            }

            function deleteHeader(saqHeaderId, desc) {
                RiskPulse.confirmDelete(
                    'Delete template?',
                    'This will permanently delete "' + desc + '" and all of its questions.',
                    function () {
                        RiskPulse.postJson(deleteUrl, { id: saqHeaderId }, {
                            success: function (res) {
                                saqTable.ajax.reload(null, false);
                                RiskPulse.toastSuccess(res.message || 'Template deleted successfully.');
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to delete template.');
                            }
                        });
                    }
                );
            }

            function loadQuestions() {
                RiskPulse.getJson(questionsGridUrl, { saqHeaderId: currentSaqId }, {
                    success: function (res) {
                        renderQuestionList(res.data);
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to load questions.');
                    }
                });
            }

            function submitQuestion(payload) {
                RiskPulse.postJson(saveQuestionUrl, payload, {
                    success: function (res) {
                        hideEditor();
                        loadQuestions();
                        RiskPulse.toastSuccess(res.message || 'Question saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save question.');
                    }
                });
            }

            function deleteQuestion(question) {
                RiskPulse.confirmDelete(
                    'Delete question?',
                    'This will permanently delete "' + question.questionText + '" and its options.',
                    function () {
                        RiskPulse.postJson(deleteQuestionUrl, { id: question.questionId }, {
                            success: function (res) {
                                if (selectedQuestionId === question.questionId) hideEditor();
                                loadQuestions();
                                RiskPulse.toastSuccess(res.message || 'Question deleted successfully.');
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to delete question.');
                            }
                        });
                    }
                );
            }

            /* =================================================================
               SECTION 6 — DATA GRID (DataTables)
               ================================================================= */
            var saqTable = RiskPulse.initGrid($('#saqTable'), {
                ajax: { url: gridUrl },
                columns: [
                    { data: 'saqHeaderId' },
                    { data: 'saqDesc' },
                    { data: 'groupDesc', render: function (d, type, row) { return '<span class="status-pill">' + (d || row.unitDesc || '') + '</span>'; } },
                    { data: 'saqStatus', render: function (d) { return statusPill(d); } },
                    { data: 'questionCount', render: function (d) { return '<span class="status-pill">' + (d || 0) + '</span>'; } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function (data, type, row) {
                        var locked = row.saqStatus === 'Locked';
                        return [
                            '<button type="button" class="btn-stasis-secondary design-saq-btn"><i class="fas fa-pen-ruler"></i> Design</button>',
                            locked
                                ? '<button type="button" class="btn-stasis-secondary" disabled title="Locked templates cannot be edited"><i class="fas fa-pen-to-square"></i> Edit</button>'
                                : '<button type="button" class="btn-stasis-secondary edit-saq-btn"><i class="fas fa-pen-to-square"></i> Edit</button>',
                            locked
                                ? '<button type="button" class="btn-stasis-secondary" disabled title="Locked templates cannot be deleted"><i class="fas fa-trash-can"></i> Delete</button>'
                                : '<button type="button" class="btn-stasis-secondary delete-saq-btn"><i class="fas fa-trash-can"></i> Delete</button>'
                        ].join(' ');
                    } }
                ],
                order: [[0, 'asc']]
            });

            /* =================================================================
               SECTION 7 — EVENT WIRING & INIT
               ================================================================= */
            RiskPulse.populateSelect($('#addSaqStatus'), statuses);
            RiskPulse.populateSelect($('#editSaqStatus'), statuses);

            function toggleSaqLinkType(linkTypeSelect, groupRowId, unitRowId, groupSelect, unitSelect) {
                var isGroup = $(linkTypeSelect).val() === 'group';
                $('#' + groupRowId).toggleClass('d-none', !isGroup);
                $('#' + unitRowId).toggleClass('d-none', isGroup);
                if (isGroup) { $(unitSelect).val(0).trigger('change'); }
                else { $(groupSelect).val(0).trigger('change'); }
            }

            function initSaqSelects() {
                $.each(['#addSaqGroup', '#editSaqGroup'], function (i, selector) {
                    $(selector).empty().append('<option value="0">Select a unit group...</option>');
                    RiskPulse.populateSelect($(selector), unitGroups);
                });
                $.each(['#addSaqUnit', '#editSaqUnit'], function (i, selector) {
                    $(selector).empty().append('<option value="0">Select a unit...</option>');
                    RiskPulse.populateSelect($(selector), units);
                });
            }
            initSaqSelects();

            $('#addSaqLinkType').on('change', function () {
                toggleSaqLinkType(this, 'addSaqGroupRow', 'addSaqUnitRow', '#addSaqGroup', '#addSaqUnit');
            });
            $('#editSaqLinkType').on('change', function () {
                toggleSaqLinkType(this, 'editSaqGroupRow', 'editSaqUnitRow', '#editSaqGroup', '#editSaqUnit');
            });

            $('#addSaqModal').on('shown.bs.modal', function () {
                $('#addSaqDesc').val('').trigger('focus');
                $('#addSaqLinkType').val('group').trigger('change');
                $('#addSaqGroup').val(0).trigger('change');
                $('#addSaqUnit').val(0).trigger('change');
                $('#addSaqStatus').val('Active').trigger('change');
            });

            $('#saqTable tbody').on('click', '.edit-saq-btn', function () {
                var row = saqTable.row($(this).closest('tr')).data();
                $('#editSaqHeaderId').val(row.saqHeaderId);
                $('#editSaqDesc').val(row.saqDesc);
                if (row.groupId) {
                    $('#editSaqLinkType').val('group').trigger('change');
                    $('#editSaqGroup').val(row.groupId).trigger('change');
                    $('#editSaqUnit').val(0).trigger('change');
                } else {
                    $('#editSaqLinkType').val('unit').trigger('change');
                    $('#editSaqUnit').val(row.unitId).trigger('change');
                    $('#editSaqGroup').val(0).trigger('change');
                }
                $('#editSaqStatus').val(row.saqStatus).trigger('change');
                RiskPulse.showModal('editSaqModal');
            });

            $('#saqTable tbody').on('click', '.delete-saq-btn', function () {
                var row = saqTable.row($(this).closest('tr')).data();
                deleteHeader(row.saqHeaderId, row.saqDesc);
            });

            // Open Design modal
            $('#saqTable tbody').on('click', '.design-saq-btn', function () {
                var row = saqTable.row($(this).closest('tr')).data();
                currentSaqId = row.saqHeaderId;
                currentSaqLocked = row.saqStatus === 'Locked';

                $('#designModalLabel').text('Design: ' + row.saqDesc);
                $('#designStatusPill').html(statusPill(row.saqStatus));

                if (currentSaqLocked) {
                    $('#lockedNotice').show();
                    $('#addQuestionBtn').hide();
                } else {
                    $('#lockedNotice').hide();
                    $('#addQuestionBtn').show();
                }

                hideEditor();
                loadQuestions();
                RiskPulse.showModal('designModal');
            });

            // Reload the grid when the designer closes so question counts stay fresh
            $('#designModal').on('hidden.bs.modal', function () {
                saqTable.ajax.reload(null, false);
            });

            // Left panel: click question to edit
            $('#questionList').on('click', '.q-item', function (e) {
                if ($(e.target).closest('.q-delete-btn').length) return;
                if (currentSaqLocked) return;
                showEditor($(this).data('question'));
            });

            // Left panel: delete button
            $('#questionList').on('click', '.q-delete-btn', function (e) {
                e.stopPropagation();
                deleteQuestion($(this).data('question'));
            });

            // Add Question
            $('#addQuestionBtn').on('click', function () {
                if (!currentSaqLocked) showEditor(null);
            });

            // Option rows
            $('#addOptionBtn').on('click', function () {
                var count = $('#optionRows .option-row').length;
                $('#optionRows').append(optionRowHtml(null, count));
            });

            $('#resetOptionsBtn').on('click', function () {
                $('#optionRows').empty();
                $('#editorQuestionText').trigger('focus');
            });

            $('#optionRows').on('click', '.remove-option-btn', function () {
                $(this).closest('.option-row').remove();
                renumberOptions();
            });

            // Quick Presets
            $('.preset-btn').on('click', function () {
                var preset = PRESETS[$(this).data('preset')];
                if (!preset) return;
                $('#optionRows').empty();
                $.each(preset, function (i, o) { $('#optionRows').append(optionRowHtml(o, i)); });
            });

            // Save / Cancel
            $('#saveQuestionBtn').on('click', function () {
                var payload = getQuestionPayload();
                if (validateQuestionPayload(payload)) submitQuestion(payload);
            });

            $('#cancelQuestionBtn').on('click', function () {
                hideEditor();
            });

            // Header forms
            $('#addSaqForm, #editSaqForm').on('submit', function (e) {
                e.preventDefault();
                var payload = getHeaderPayload($(this));
                if (validateHeaderPayload(payload)) submitHeader(payload, $(this));
            });
        })(jQuery);
    </script>
}
