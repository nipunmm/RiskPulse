@model RiskPulse.Models.ViewModel.UsersIndexViewModel
@{
    ViewData["Title"] = "User Management";

    var unitsJson = Json.Serialize(Model.Units.Select(u => new { unitId = u.UnitId, unitCode = u.UnitCode, unitDesc = u.UnitDesc }));
    var rolesJson = Json.Serialize(Model.Roles.Select(r => new { roleId = r.RoleId, roleDesc = r.RoleDesc }));
    var currentUserId = Model.CurrentUserId;
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-2 mb-2">
    <div>
        <h2 class="font-display-lg" style="color: var(--on-background);">User Management</h2>
        <p class="font-body-md mt-1 mb-0" style="color: var(--on-surface-variant);">
            Manage system users and account status.
        </p>
    </div>
    <button type="button" class="btn-stasis-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
        <i class="fas fa-user-plus"></i> Add User
    </button>
</div>

<div class="card-stasis p-2">
    <table id="userTable" class="table table-stasis table-sm w-100 align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- ============================================================
     ADD USER MODAL
     ============================================================ -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addUserForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="addUserModalLabel">Add User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="addUsername">Username</label>
                        <input type="text" id="addUsername" name="username" class="input-stasis" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="addUnitId">Unit</label>
                        <select id="addUnitId" name="unitId" class="input-stasis" required></select>
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="addRoleId">Role</label>
                        <select id="addRoleId" name="roleId" class="input-stasis" required></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     EDIT USER MODAL
     Same fields as Add plus an Active toggle. Username is
     read-only; it cannot be changed after creation.
     ============================================================ -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editUserForm" novalidate>
                <input type="hidden" id="editUserId" name="id" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalLabel">Edit User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="editUsername">Username</label>
                        <input type="text" id="editUsername" name="username" class="input-stasis" readonly autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="editUnitId">Unit</label>
                        <select id="editUnitId" name="unitId" class="input-stasis" required></select>
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="editRoleId">Role</label>
                        <select id="editRoleId" name="roleId" class="input-stasis" required></select>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="editIsActive" name="isActive" checked />
                        <label class="form-check-label" for="editIsActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var units = @Html.Raw(unitsJson);
            var roles = @Html.Raw(rolesJson);
            var currentUserId = @currentUserId;
            var gridUrl = '@Url.Action("Grid", "Users")';
            var saveUrl = '@Url.Action("Save", "Users")';

            /* =================================================================
               SECTION 2 — UI RENDERERS (Unit/Role dropdowns)
               ================================================================= */
            function unitOptions() {
                return $.map(units, function (u) { return { value: u.unitId, label: u.unitDesc }; });
            }

            function roleOptions() {
                return $.map(roles, function (r) { return { value: r.roleId, label: r.roleDesc }; });
            }

            /* =================================================================
               SECTION 3 — FORM PAYLOAD BUILDER
               ================================================================= */
            function getFormPayload($form) {
                var payload = RiskPulse.serializeForm($form, {
                    checkboxes: ['isActive'],
                    numbers: ['id', 'unitId', 'roleId']
                });
                return payload;
            }

            /* =================================================================
               SECTION 4 — VALIDATION
               ================================================================= */
            function validateUserPayload(payload) {
                // Rule 1 — username is required
                var username = $.trim(payload.username);
                if (!username) { RiskPulse.toastError('Username is required.'); return false; }
                // Rule 2 — username must be lowercase a-z only (Add only)
                if (!/^[a-z]+$/.test(username)) { RiskPulse.toastError('Username must be lowercase letters only (a-z), no numbers, spaces, or special characters.'); return false; }
                // Rule 3 — unit must be selected
                if (!payload.unitId || payload.unitId === 0) { RiskPulse.toastError('Please select a unit.'); return false; }
                // Rule 4 — role must be selected
                if (!payload.roleId || payload.roleId === 0) { RiskPulse.toastError('Please select a role.'); return false; }
                return true;
            }

            /* =================================================================
               SECTION 5 — CONTROLLER CALLS (AJAX) — the ONLY server touchpoint
               ================================================================= */
            function submitUser(payload, $form) {
                RiskPulse.postJson(saveUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        userTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'User saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save user.');
                    }
                });
            }

            /* =================================================================
               SECTION 6 — DATA GRID (DataTables)
               ================================================================= */
            var userTable = RiskPulse.initGrid($('#userTable'), {
                ajax: { url: gridUrl },
                columns: [
                    { data: 'id' },
                    { data: 'username' },
                    { data: 'isActive', render: function (d) {
                        return d ? '<span class="status-pill rag-green">Active</span>' : '<span class="status-pill rag-red">Inactive</span>';
                    } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function (data, type, row) {
                        if (row.id === currentUserId) {
                            return '<button type="button" class="btn-stasis-secondary" disabled title="You cannot edit your own record"><i class="fas fa-pen-to-square"></i> Edit</button>';
                        }
                        return '<button type="button" class="btn-stasis-secondary edit-user-btn"><i class="fas fa-pen-to-square"></i> Edit</button>';
                    } }
                ],
                order: [[0, 'asc']]
            });

            /* =================================================================
               SECTION 7 — EVENT WIRING & INIT
               ================================================================= */
            // Reset the Add form each time its modal opens
            $('#addUserModal').on('shown.bs.modal', function () {
                $('#addUsername').val('').trigger('focus');
                $('#addUnitId').val(unitOptions()[0].value).trigger('change');
                $('#addRoleId').val(roleOptions()[0].value).trigger('change');
            });

            // Load a user's values into the Edit modal
            $('#userTable tbody').on('click', '.edit-user-btn', function () {
                var row = $('#userTable').DataTable().row($(this).closest('tr')).data();
                $('#editUserId').val(row.id);
                $('#editUsername').val(row.username);
                $('#editUnitId').val(row.unitId).trigger('change');
                $('#editRoleId').val(row.roleId).trigger('change');
                $('#editIsActive').prop('checked', !!row.isActive);
                RiskPulse.showModal('editUserModal');
            });

            // Populate and initialize the Unit/Role dropdowns with Select2 (kept inside their modal)
            $.each({ addUnitId: unitOptions, editUnitId: unitOptions, addRoleId: roleOptions, editRoleId: roleOptions }, function (id, optionsFn) {
                RiskPulse.populateSelect($('#' + id), optionsFn());
                $('#' + id).select2({ width: '100%', theme: 'bootstrap-5', dropdownParent: $('#' + id).closest('.modal') });
            });

            // Bind submit for both Add and Edit forms
            $('#addUserForm, #editUserForm').on('submit', function (e) {
                e.preventDefault();
                var payload = getFormPayload($(this));
                if (validateUserPayload(payload)) submitUser(payload, $(this));
            });
        })(jQuery);
    </script>
}
