@model RiskPulse.Models.ViewModel.UsersIndexViewModel
@{
    ViewData["Title"] = "User Management";

    var unitsJson = Json.Serialize(Model.Units);
    var rolesJson = Json.Serialize(Model.Roles);
    var currentUserId = Model.CurrentUserId;
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<div class="rp-page-header">
    <div>
        <h2 class="rp-display-lg">User Management</h2>
        <p class="rp-body-md mt-1 mb-0 rp-text-muted">
            Manage system users.
        </p>
    </div>
</div>

<div class="rp-card p-2">
    <div class="rp-grid-toolbar">
        <p class="mb-0 rp-body-sm rp-text-muted">Add, edit, or deactivate users.</p>
        <button type="button" class="rp-btn rp-btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
            <i class="fas fa-user-plus"></i> Add User
        </button>
    </div>
    <table id="userTable" class="table rp-table table-sm w-100 align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Unit</th>
                <th>Role</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- ============================================================
     ADD USER MODAL
     ============================================================ -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addUserForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="addUserModalLabel">Add User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="rp-label" for="addUsername">Username</label>
                        <input type="text" id="addUsername" name="username" class="rp-input" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="rp-label" for="addUnitId">Unit</label>
                        <select id="addUnitId" name="unitId" class="rp-input" required></select>
                    </div>

                    <div class="mb-3">
                        <label class="rp-label" for="addRoleId">Role</label>
                        <select id="addRoleId" name="roleId" class="rp-input" required></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="rp-btn rp-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="rp-btn rp-btn-primary"><i class="fas fa-check"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     EDIT USER MODAL
     Same fields as Add plus an Active toggle. Username is
     editable in edit mode.
     ============================================================ -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editUserForm" novalidate>
                <input type="hidden" id="editUserId" name="id" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalLabel">Edit User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="rp-label" for="editUsername">Username</label>
                        <input type="text" id="editUsername" name="username" class="rp-input" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="rp-label" for="editUnitId">Unit</label>
                        <select id="editUnitId" name="unitId" class="rp-input" required></select>
                    </div>

                    <div class="mb-3">
                        <label class="rp-label" for="editRoleId">Role</label>
                        <select id="editRoleId" name="roleId" class="rp-input" required></select>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="editIsActive" name="isActive" checked />
                        <label class="form-check-label" for="editIsActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="rp-btn rp-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="rp-btn rp-btn-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {

            /* =================================================================
               SECTION 1 — PAGE DATA & ENDPOINTS
               ================================================================= */
            var units = @Html.Raw(unitsJson);
            var roles = @Html.Raw(rolesJson);
            var currentUserId = @currentUserId;
            var gridUrl = '@Url.Action("Grid", "Users")';
            var saveUrl = '@Url.Action("Save", "Users")';
            var deleteUrl = '@Url.Action("Delete", "Users")';

            /* =================================================================
               SECTION 2 — UI RENDERERS (Unit/Role dropdowns)
               ================================================================= */
            function unitOptions() {
                return units;
            }

            function roleOptions() {
                return roles;
            }

            /* =================================================================
               SECTION 3 — FORM PAYLOAD BUILDER
               ================================================================= */
            function getFormPayload($form) {
                var payload = RiskPulse.serializeForm($form, {
                    checkboxes: ['isActive'],
                    numbers: ['id', 'unitId', 'roleId']
                });
                return payload;
            }

            /* =================================================================
               SECTION 4 — VALIDATION
               ================================================================= */
            function validateUserPayload(payload, $form) {
                // Rule 1 — username is required
                var username = $.trim(payload.username);
                if (!username) { return RiskPulse.validationError($form.find('[name="username"]'), 'Username is required.'); }
                // Rule 2 — username must be lowercase a-z only
                if (!/^[a-z]+$/.test(username)) { return RiskPulse.validationError($form.find('[name="username"]'), 'Username must be lowercase letters only (a-z), no numbers, spaces, or special characters.'); }
                // Rule 3 — unit must be selected
                if (!payload.unitId || payload.unitId === 0) { return RiskPulse.validationError($form.find('[name="unitId"]'), 'Please select a unit.'); }
                // Rule 4 — role must be selected
                if (!payload.roleId || payload.roleId === 0) { return RiskPulse.validationError($form.find('[name="roleId"]'), 'Please select a role.'); }
                return true;
            }

            /* =================================================================
               SECTION 5 — CONTROLLER CALLS (AJAX) — the ONLY server touchpoint
               ================================================================= */
            function submitUser(payload, $form) {
                RiskPulse.postJson(saveUrl, payload, {
                    success: function (res) {
                        RiskPulse.hideModal($form);
                        userTable.ajax.reload(null, false);
                        RiskPulse.toastSuccess(res.message || 'User saved successfully.');
                    },
                    fail: function (res) {
                        RiskPulse.toastError(res.message || 'Unable to save user.');
                    }
                });
            }

            /* =================================================================
               SECTION 6 — DATA GRID (DataTables)
               ================================================================= */
            var userTable = RiskPulse.initGrid($('#userTable'), {
                ajax: { url: gridUrl },
                columns: [
                    { data: 'id' },
                    { data: 'username' },
                    { data: 'unitDesc' },
                    { data: 'roleDesc' },
                    { data: 'isActive', render: function (d) {
                        return RiskPulse.statusPill(d ? 'Active' : 'Inactive');
                    } },
                    { data: null, orderable: false, searchable: false, className: 'text-end', render: function (data, type, row) {
                        if (row.id === currentUserId) {
                            return '<button type="button" class="rp-btn rp-btn-edit" disabled title="You cannot edit your own record"><i class="fas fa-pen-to-square"></i> Edit</button> ' +
                                   '<button type="button" class="rp-btn rp-btn-delete" disabled title="You cannot delete your own record"><i class="fas fa-trash-can"></i> Delete</button>';
                        }
                        return '<button type="button" class="rp-btn rp-btn-edit edit-user-btn"><i class="fas fa-pen-to-square"></i> Edit</button> ' +
                               '<button type="button" class="rp-btn rp-btn-delete delete-user-btn"><i class="fas fa-trash-can"></i> Delete</button>';
                    } }
                ],
                order: [[0, 'asc']]
            });

            /* =================================================================
               SECTION 7 — EVENT WIRING & INIT
               ================================================================= */
            // Reset the Add form each time its modal opens
            $('#addUserModal').on('shown.bs.modal', function () {
                $('#addUsername').val('').trigger('focus');
                var units = unitOptions();
                if (units.length) $('#addUnitId').val(units[0].value);
                var roles = roleOptions();
                if (roles.length) $('#addRoleId').val(roles[0].value);
                RiskPulse.clearFieldErrors($('#addUserForm'));
            });

            // Load a user's values into the Edit modal
            $('#userTable tbody').on('click', '.edit-user-btn', function () {
                var row = $('#userTable').DataTable().row($(this).closest('tr')).data();
                $('#editUserId').val(row.id);
                $('#editUsername').val(row.username);
                $('#editUnitId').val(row.unitId);
                $('#editRoleId').val(row.roleId);
                $('#editIsActive').prop('checked', !!row.isActive);
                RiskPulse.clearFieldErrors($('#editUserForm'));
                RiskPulse.showModal('editUserModal');
            });

            // Delete handler
            $('#userTable tbody').on('click', '.delete-user-btn', function () {
                var row = $('#userTable').DataTable().row($(this).closest('tr')).data();
                RiskPulse.confirmDelete(
                    'Delete User?',
                    'This permanently deletes "' + row.username + '".',
                    function () {
                        RiskPulse.postJson(deleteUrl, { id: row.id }, {
                            success: function (res) {
                                userTable.ajax.reload(null, false);
                                RiskPulse.toastSuccess(res.message || 'User deleted successfully.');
                            },
                            fail: function (res) {
                                RiskPulse.toastError(res.message || 'Unable to delete user.');
                            }
                        });
                    }
                );
            });

            // Populate the Unit/Role dropdowns (native selects)
            $.each({ addUnitId: unitOptions, editUnitId: unitOptions, addRoleId: roleOptions, editRoleId: roleOptions }, function (id, optionsFn) {
                RiskPulse.populateSelect($('#' + id), optionsFn());
            });

            // Bind submit for both Add and Edit forms
            $('#addUserForm, #editUserForm').on('submit', function (e) {
                e.preventDefault();
                var payload = getFormPayload($(this));
                if (validateUserPayload(payload, $(this))) submitUser(payload, $(this));
            });
        })(jQuery);
    </script>
}
