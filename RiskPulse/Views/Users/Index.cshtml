@model RiskPulse.Models.ViewModel.UsersIndexViewModel
@{
    ViewData["Title"] = "User Management";

    var usersJson = Json.Serialize(Model.Users.Select(u => new { id = u.Id, username = u.Username, unitId = u.UnitId, roleId = u.RoleId, isActive = u.IsActive }));
    var unitsJson = Json.Serialize(Model.Units.Select(u => new { unitId = u.UnitId, unitCode = u.UnitCode, unitDesc = u.UnitDesc }));
    var rolesJson = Json.Serialize(Model.Roles.Select(r => new { roleId = r.RoleId, roleDesc = r.RoleDesc }));
    var currentUserId = Model.CurrentUserId;
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-2 mb-2">
    <div>
        <h2 class="font-display-lg" style="color: var(--on-background);">User Management</h2>
        <p class="font-body-md mt-1 mb-0" style="color: var(--on-surface-variant);">
            Manage system users and account status.
        </p>
    </div>
    <button type="button" class="btn-stasis-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
        <i class="fas fa-user-plus"></i> Add User
    </button>
</div>

<div class="card-stasis p-2">
    <table id="userTable" class="table table-stasis table-sm w-100 align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- ============================================================
     ADD USER MODAL
     ============================================================ -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addUserForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="addUserModalLabel">Add User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="addUsername">Username</label>
                        <input type="text" id="addUsername" name="username" class="input-stasis" required autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="addUnitId">Unit</label>
                        <select id="addUnitId" name="unitId" class="input-stasis" required></select>
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="addRoleId">Role</label>
                        <select id="addRoleId" name="roleId" class="input-stasis" required></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     EDIT USER MODAL
     Same fields as Add plus an Active toggle. Username is
     read-only; it cannot be changed after creation.
     ============================================================ -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editUserForm" novalidate>
                <input type="hidden" id="editUserId" name="id" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalLabel">Edit User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="input-label" for="editUsername">Username</label>
                        <input type="text" id="editUsername" name="username" class="input-stasis" readonly autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="editUnitId">Unit</label>
                        <select id="editUnitId" name="unitId" class="input-stasis" required></select>
                    </div>

                    <div class="mb-3">
                        <label class="input-label" for="editRoleId">Role</label>
                        <select id="editRoleId" name="roleId" class="input-stasis" required></select>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="editIsActive" name="isActive" checked />
                        <label class="form-check-label" for="editIsActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-stasis-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-stasis-primary"><i class="fas fa-check"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        (function ($) {
            /* ================================================================
               Page data & endpoints
               ================================================================ */
            var users = @Html.Raw(usersJson);
            var units = @Html.Raw(unitsJson);
            var roles = @Html.Raw(rolesJson);
            var currentUserId = @currentUserId;
            var saveUrl = '@Url.Action("Save", "Users")';

            /* ================================================================
               Helpers
               ================================================================ */

            // Populates a select with options from a data array.
            // label for each option is derived by a labelFn(option) callback.
            function populateSelect($select, data, labelFn) {
                $select.empty();
                $.each(data, function (index, item) {
                    $select.append('<option value="' + item.value + '">' + labelFn(item) + '</option>');
                });
            }

            // Builds value/label objects for the Unit dropdown.
            function unitOptions() {
                return $.map(units, function (unit) {
                    return { value: unit.unitId, label: unit.unitDesc };
                });
            }

            // Builds value/label objects for the Role dropdown.
            function roleOptions() {
                return $.map(roles, function (role) {
                    return { value: role.roleId, label: role.roleDesc };
                });
            }

            // Collects the form's named fields into a JSON-ready object.
            // The checkbox is synced first so serializeArray() always includes it.
            function getFormPayload(formId) {
                var $form = $('#' + formId);

                var payload = {};
                $.each($form.serializeArray(), function (index, field) {
                    payload[field.name] = field.value;
                });

                var $active = $form.find('[name="isActive"]');
                if ($active.length) {
                    payload.isActive = $active.is(':checked');
                }

                // Coerce numeric fields so the JSON body sends numbers, not strings.
                payload.id     = +payload.id     || 0;
                payload.unitId = +payload.unitId || 0;
                payload.roleId = +payload.roleId || 0;

                return payload;
            }

            // The single AJAX call used by both Add and Edit forms.
            function submitUser(payload, $form) {
                $.ajax({
                    url: saveUrl,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            $form.closest('.modal').modal('hide');
                            Swal.fire({
                                icon: 'success',
                                title: res.message || 'User saved successfully.'
                            }).then(function () {
                                location.reload();
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: res.message || 'Unable to save user.' });
                        }
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: 'An error occurred. Please try again.' });
                    }
                });
            }

            /* ================================================================
               Validation & Form Binding (Add + Edit share this pattern)
               Checks required fields and reports via the shared toast.
               Username rule (Add only): lowercase letters (a-z), no numbers,
               spaces, special characters, or capitals.
               ================================================================ */
            function validateUserPayload(payload) {
                var username = (payload.username || '').trim();

                if (!username) {
                    Toast.fire({ icon: 'error', title: 'Username is required.' });
                    return false;
                }

                if (!/^[a-z]+$/.test(username)) {
                    Toast.fire({ icon: 'error', title: 'Username must be lowercase letters only (a-z), no numbers, spaces, or special characters.' });
                    return false;
                }

                if (!payload.unitId || payload.unitId === 0) {
                    Toast.fire({ icon: 'error', title: 'Please select a unit.' });
                    return false;
                }

                if (!payload.roleId || payload.roleId === 0) {
                    Toast.fire({ icon: 'error', title: 'Please select a role.' });
                    return false;
                }

                return true;
            }

            // Wires a form to the shared save flow. Add and Edit share this.
            function bindUserForm(formId) {
                $('#' + formId).on('submit', function (e) {
                    e.preventDefault();

                    var payload = getFormPayload(formId);

                    if (!validateUserPayload(payload)) {
                        return;
                    }

                    submitUser(payload, $(this));
                });
            }

            /* ================================================================
               Grid (DataTables) - client-side search, pagination, sorting
               ================================================================ */
            var userTable = $('#userTable').DataTable({
                data: users,
                columns: [
                    { data: 'id' },
                    { data: 'username' },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data
                                ? '<span class="status-pill rag-green">Active</span>'
                                : '<span class="status-pill rag-red">Inactive</span>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: 'text-end',
                        render: function (data, type, row) {
                            if (row.id === currentUserId) {
                                return '<button type="button" class="btn-stasis-secondary" disabled title="You cannot edit your own record">' +
                                       '<i class="fas fa-pen-to-square"></i> Edit</button>';
                            }
                            return '<button type="button" class="btn-stasis-secondary edit-user-btn">' +
                                   '<i class="fas fa-pen-to-square"></i> Edit</button>';
                        }
                    }
                ],
                pageLength: 10,
                lengthMenu: [10, 25, 50],
                order: [[0, 'asc']]
            });

            /* ================================================================
               Modal events
               ================================================================ */

            // Reset the Add form every time the modal opens.
            $('#addUserModal').on('shown.bs.modal', function () {
                $('#addUsername').val('').trigger('focus');
                $('#addUnitId').val(unitOptions()[0].value).trigger('change');
                $('#addRoleId').val(roleOptions()[0].value).trigger('change');
            });

            // Edit button: load the row's values into the Edit modal, then open it.
            $('#userTable tbody').on('click', '.edit-user-btn', function () {
                var row = userTable.row($(this).closest('tr')).data();
                $('#editUserId').val(row.id);
                $('#editUsername').val(row.username);
                $('#editUnitId').val(row.unitId).trigger('change');
                $('#editRoleId').val(row.roleId).trigger('change');
                $('#editIsActive').prop('checked', !!row.isActive);
                $('#editUserModal').modal('show');
            });

            /* ================================================================
               Dropdown population (Add + Edit share the Unit/Role options)
               ================================================================ */
            populateSelect($('#addUnitId'), unitOptions(), function (o) { return o.label; });
            populateSelect($('#addRoleId'), roleOptions(), function (o) { return o.label; });
            populateSelect($('#editUnitId'), unitOptions(), function (o) { return o.label; });
            populateSelect($('#editRoleId'), roleOptions(), function (o) { return o.label; });

            // Searchable Unit/Role dropdowns (Select2), kept inside their modal.
            $('#addUnitId').select2({
                width: '100%',
                theme: 'bootstrap-5',
                dropdownParent: $('#addUnitId').closest('.modal')
            });
            $('#editUnitId').select2({
                width: '100%',
                theme: 'bootstrap-5',
                dropdownParent: $('#editUnitId').closest('.modal')
            });
            $('#addRoleId').select2({
                width: '100%',
                theme: 'bootstrap-5',
                dropdownParent: $('#addRoleId').closest('.modal')
            });
            $('#editRoleId').select2({
                width: '100%',
                theme: 'bootstrap-5',
                dropdownParent: $('#editRoleId').closest('.modal')
            });

            /* ================================================================
               Form submissions (shared pattern for Add and Edit)
               ================================================================ */
            bindUserForm('addUserForm');
            bindUserForm('editUserForm');
        })(jQuery);
    </script>
}
